---
import TrustSignals from "./TrustSignals.astro";
---

<div class="rounded border-t-4 border-gold bg-white p-7">
  <h2 class="mb-1 font-display text-2xl font-black text-indigo">Send us a message</h2>
  <p class="mb-5 text-sm text-mist">
    Questions, a party inquiry, or anything else. Ready to try a class instead? Head to our <a
      href="/booking" class="font-semibold text-indigo hover:text-gold">booking page</a>.
  </p>

  <form id="contact-form" class="flex flex-col gap-4">
    <div class="grid gap-4 sm:grid-cols-2">
      <label class="block">
        <span class="mb-1.5 block text-xs font-semibold tracking-[0.05em] text-mist uppercase">Name</span>
        <input required name="name" type="text" class="w-full rounded border border-paper-warm bg-paper px-3.5 py-3 text-[0.95rem] focus:border-transparent focus:outline focus:outline-2 focus:outline-gold" />
      </label>
      <label class="block">
        <span class="mb-1.5 block text-xs font-semibold tracking-[0.05em] text-mist uppercase">Phone (optional)</span>
        <input name="phone" type="tel" placeholder="(910) 000-0000" class="w-full rounded border border-paper-warm bg-paper px-3.5 py-3 text-[0.95rem] focus:border-transparent focus:outline focus:outline-2 focus:outline-gold" />
      </label>
    </div>
    <label class="block">
      <span class="mb-1.5 block text-xs font-semibold tracking-[0.05em] text-mist uppercase">Email</span>
      <input required name="email" type="email" class="w-full rounded border border-paper-warm bg-paper px-3.5 py-3 text-[0.95rem] focus:border-transparent focus:outline focus:outline-2 focus:outline-gold" />
    </label>
    <label class="block">
      <span class="mb-1.5 block text-xs font-semibold tracking-[0.05em] text-mist uppercase">Message</span>
      <textarea required name="message" rows="4" class="w-full rounded border border-paper-warm bg-paper px-3.5 py-3 text-[0.95rem] focus:border-transparent focus:outline focus:outline-2 focus:outline-gold"></textarea>
    </label>

    <fieldset class="rounded border border-paper-warm bg-paper p-4">
      <legend class="px-1 text-xs font-semibold tracking-[0.05em] text-mist uppercase">Planning a party or event? (optional)</legend>
      <div class="mt-2 grid gap-4 sm:grid-cols-2">
        <label class="block">
          <span class="mb-1.5 block text-xs font-semibold tracking-[0.05em] text-mist uppercase">Interested in</span>
          <select name="interest" class="w-full rounded border border-paper-warm bg-white px-3.5 py-3 text-[0.95rem] focus:border-transparent focus:outline focus:outline-2 focus:outline-gold">
            <option value="">Select one</option>
            <option>Birthday Party</option>
            <option>Parents Night Out</option>
            <option>Not sure yet</option>
          </select>
        </label>
        <label class="block">
          <span class="mb-1.5 block text-xs font-semibold tracking-[0.05em] text-mist uppercase">Preferred date</span>
          <input name="preferredDate" type="date" class="w-full rounded border border-paper-warm bg-white px-3.5 py-3 text-[0.95rem] focus:border-transparent focus:outline focus:outline-2 focus:outline-gold" />
        </label>
        <label class="block">
          <span class="mb-1.5 block text-xs font-semibold tracking-[0.05em] text-mist uppercase">Child's age</span>
          <input name="childAge" type="text" inputmode="numeric" class="w-full rounded border border-paper-warm bg-white px-3.5 py-3 text-[0.95rem] focus:border-transparent focus:outline focus:outline-2 focus:outline-gold" />
        </label>
        <label class="block">
          <span class="mb-1.5 block text-xs font-semibold tracking-[0.05em] text-mist uppercase">Approximate guest count</span>
          <input name="guestCount" type="text" inputmode="numeric" class="w-full rounded border border-paper-warm bg-white px-3.5 py-3 text-[0.95rem] focus:border-transparent focus:outline focus:outline-2 focus:outline-gold" />
        </label>
      </div>
    </fieldset>

    <button
      type="submit"
      id="contact-submit"
      class="rounded bg-indigo px-5 py-4 text-base font-bold text-white transition-colors hover:bg-gold hover:text-indigo-deep disabled:opacity-60"
    >
      Send My Message
    </button>
    <p id="contact-error" class="hidden text-sm font-semibold text-[#8B3A2F]">
      Something went wrong sending your message. Please call us instead.
    </p>
  </form>

  <div id="contact-success" class="hidden text-center">
    <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-gold text-2xl text-indigo-deep" aria-hidden="true">&#10003;</div>
    <h2 class="mb-2 font-display text-2xl font-black text-indigo">Message sent</h2>
    <p class="text-mist">We'll get back to you quickly, usually the same day.</p>
  </div>

  <div class="mt-6 border-t border-paper-warm pt-6">
    <TrustSignals />
  </div>
</div>

<script>
  import { analytics } from "../../data/school";

  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const submitBtn = document.getElementById("contact-submit") as HTMLButtonElement | null;
  const errorEl = document.getElementById("contact-error");
  const successEl = document.getElementById("contact-success");

  // Normalized (not pre-hashed) values for Meta's client-side Advanced
  // Matching — the Pixel SDK hashes em/ph/fn/ln with SHA-256 in-browser
  // before anything goes over the network. Pre-hashing here would double-hash
  // and break matching, so this must stay plain, lowercased/trimmed text.
  function buildAdvancedMatching(payload: Record<string, FormDataEntryValue>) {
    const name = String(payload.name ?? "").trim().split(/\s+/).filter(Boolean);
    const email = String(payload.email ?? "").trim().toLowerCase();
    const phoneDigits = String(payload.phone ?? "").replace(/\D/g, "");

    const data: Record<string, string> = {};
    if (email) data.em = email;
    if (phoneDigits) data.ph = phoneDigits.length === 10 ? `1${phoneDigits}` : phoneDigits;
    if (name[0]) data.fn = name[0].toLowerCase();
    if (name.length > 1) data.ln = name.slice(1).join(" ").toLowerCase();
    return data;
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    errorEl?.classList.add("hidden");
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = "Sending...";
    }

    const data = new FormData(form);
    const payload = Object.fromEntries(data.entries());

    try {
      const res = await fetch("/api/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      if (!res.ok) throw new Error("Request failed");
      form.classList.add("hidden");
      successEl?.classList.remove("hidden");

      window.gtag?.("event", "generate_lead", { form_id: "contact_form" });

      const matchData = buildAdvancedMatching(payload);
      if (Object.keys(matchData).length) window.fbq?.("init", analytics.metaPixelId, matchData);
      window.fbq?.("track", "Lead", { content_name: "contact_form" });
    } catch {
      errorEl?.classList.remove("hidden");
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = "Send My Message";
      }
    }
  });
</script>
