---
import BaseLayout from "../layouts/BaseLayout.astro";
import { offer, nav } from "../data/school";
import { business } from "../data/business";
import { programs, ageLabel } from "../data/schedule";

const programLinks = Object.values(programs);
---

<BaseLayout
  title="Page Not Found"
  description={`That page doesn't exist on the ${business.displayName} website. Find a program, the class schedule, or claim your ${offer.noun}.`}
  path="/404"
  noindex
>
  <header class="relative overflow-hidden bg-indigo py-20 text-bone md:py-20">
    <div
      class="pointer-events-none absolute -right-24 -top-24 h-[460px] w-[460px] rounded-full border border-gold/[0.14]"
      aria-hidden="true"
    >
    </div>
    <div class="relative z-10 mx-auto max-w-3xl px-6 md:px-5">
      <span class="mb-5 inline-flex items-center gap-2.5 text-xs font-semibold tracking-[0.2em] text-gold-soft uppercase">
        <span class="h-px w-[30px] bg-gold" aria-hidden="true"></span>
        Page Not Found
      </span>
      <h1 class="max-w-[16ch] text-[clamp(2.2rem,4.4vw,3.5rem)]">
        That page <span class="text-gold-soft">isn't on the mat.</span>
      </h1>
      <p class="mt-5 max-w-[52ch] text-lg text-bone-soft">
        The link may be old, or the address may have a typo. Here is where most families are
        headed.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a
          href="/booking"
          class="inline-block rounded-sm bg-gold px-7 py-4 text-base font-bold text-indigo-deep hover:bg-gold-soft"
        >
          {offer.cta}
        </a>
        <a href={business.phoneHref} class="font-bold text-gold-soft hover:text-gold">
          Or call {business.phone}
        </a>
      </div>
    </div>
  </header>

  <section class="py-16 md:py-16">
    <div class="mx-auto grid max-w-3xl gap-10 px-6 sm:grid-cols-2 md:px-5">
      <div>
        <h2 class="mb-4 border-b-2 border-gold pb-2 text-xl font-black text-indigo">Programs</h2>
        <ul class="flex flex-col gap-2.5">
          {programLinks.map((p) => (
            <li>
              <a href={p.href} class="font-semibold text-indigo hover:text-gold">
                {p.name} <span class="text-sm font-normal text-mist">({ageLabel(p)})</span>
              </a>
            </li>
          ))}
          <li><a href="/schedule" class="font-semibold text-indigo hover:text-gold">Class Schedule</a></li>
        </ul>
      </div>
      <div>
        <h2 class="mb-4 border-b-2 border-gold pb-2 text-xl font-black text-indigo">Around the School</h2>
        <ul class="flex flex-col gap-2.5">
          {[...nav.parties, ...nav.about, { label: "Contact", href: "/contact" }].map((item) => (
            <li><a href={item.href} class="font-semibold text-indigo hover:text-gold">{item.label}</a></li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
