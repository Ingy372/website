---
// Family Login (formerly "Student Login"): a placeholder for training-video
// access. Removed from the nav and footer and noindexed until accounts roll
// out. TODO(JAY: Family Login destination) — once Nic confirms the platform
// deep link (ideally straight to the training videos after sign-in), point
// familyLoginHref in src/data/school.ts at it, add a short how-to here, and
// put the link back in Nav.astro/Footer.astro.
import BaseLayout from "../layouts/BaseLayout.astro";
import { business } from "../data/business";

---

<BaseLayout
  title="Family Login"
  description={`Training video access is coming soon to ${business.displayName} in ${business.address.city}, ${business.address.state}.`}
  path="/family-login"
  noindex
>
  <section class="py-24 text-center md:py-28">
    <div class="mx-auto max-w-xl px-6 md:px-5">
      <h1 class="mb-4 text-3xl font-black text-indigo md:text-4xl">Coming Soon</h1>
      <p class="mb-8 text-lg leading-loose text-mist md:leading-normal">
        Training video access is arriving shortly. In the meantime, call us and we'll help you
        find what you're looking for.
      </p>
      <a href={business.phoneHref} class="inline-block rounded-sm bg-gold px-7 py-4 text-base font-bold text-indigo-deep hover:bg-gold-soft">
        Call {business.phone}
      </a>
    </div>
  </section>
</BaseLayout>
