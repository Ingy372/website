{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-07-23",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"name": "action-zone-cma",
	// Keep the workers.dev URL and preview URLs on (wrangler turns them off by
	// default once routes are listed).
	"workers_dev": true,
	"preview_urls": true,
	// Production hostnames, served as Worker Custom Domains (Cloudflare manages
	// their DNS records and certificates).
	"routes": [
		{ "pattern": "actionzonecma.com", "custom_domain": true },
		{ "pattern": "www.actionzonecma.com", "custom_domain": true }
	],
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	// Contact form: at most 5 submissions per client IP per minute
	// (src/lib/contact.ts). namespace_id is just a unique number per account.
	"ratelimits": [
		{
			"name": "CONTACT_RATE_LIMIT",
			"namespace_id": "1001",
			"simple": { "limit": 5, "period": 60 }
		}
	],
	// Contact form email (free, via Cloudflare Email Routing on
	// actionzonecma.com). The destination must be a verified Email Routing
	// destination address. TURNSTILE_SECRET_KEY is a Worker secret set in the
	// dashboard (never commit it); see src/lib/contact.ts.
	"send_email": [
		{ "name": "EMAIL", "destination_address": "jay.lindemuth@gmail.com" }
	],
	"vars": {
		"CONTACT_TO_EMAIL": "jay.lindemuth@gmail.com",
		"CONTACT_FROM_EMAIL": "website@actionzonecma.com"
	},
	// Astro's session store. Listed explicitly (it already exists) so branch
	// preview builds, which can't auto-create it, deploy too.
	"kv_namespaces": [
		{ "binding": "SESSION", "id": "a2b7acd333694db2875c7de87a58d632" }
	],
	"previews": {
		"kv_namespaces": [
			{ "binding": "SESSION", "id": "a2b7acd333694db2875c7de87a58d632" }
		]
	}
	// Optional backup copy of every submission (create the namespace first):
	// ,"kv_namespaces": [{ "binding": "CONTACT_LOG", "id": "<namespace id>" }]
}
