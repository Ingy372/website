---
interface Props {
  eyebrow: string;
  narrow?: boolean;
  /** The page's H1 in search words; the "heading" slot then becomes a subheading. */
  h1?: string;
}
const { eyebrow, narrow = true, h1 } = Astro.props;
const containerClass = narrow ? "max-w-3xl" : "max-w-6xl";
---

<header class="relative overflow-hidden bg-indigo py-20 text-white md:py-20">
  <div
    class="pointer-events-none absolute -right-24 -top-24 h-[460px] w-[460px] rounded-full border border-gold/[0.14]"
    aria-hidden="true"
  >
  </div>
  <div class={`relative z-10 mx-auto px-6 md:px-5 ${containerClass}`}>
    <span class="mb-5 inline-flex items-center gap-2.5 text-xs font-semibold tracking-[0.2em] text-gold-soft uppercase">
      <span class="h-px w-[30px] bg-gold" aria-hidden="true"></span>
      {eyebrow}
    </span>
    {h1 ? (
      <>
        <h1 class="max-w-[22ch] text-[clamp(2rem,4vw,3.1rem)]">{h1}</h1>
        <p class="mt-3 max-w-[26ch] font-display text-[clamp(1.3rem,2.3vw,1.8rem)] font-semibold leading-snug text-white/90 [&_em]:font-normal [&_em]:not-italic [&_em]:text-gold-soft">
          <slot name="heading" />
        </p>
      </>
    ) : (
      <h1 class="max-w-[16ch] text-[clamp(2.2rem,4.4vw,3.5rem)] [&_em]:font-normal [&_em]:not-italic [&_em]:text-gold-soft">
        <slot name="heading" />
      </h1>
    )}
    <p class="mt-5 max-w-[52ch] text-lg text-[#C4C3D4]">
      <slot name="subtext" />
    </p>
  </div>
</header>
