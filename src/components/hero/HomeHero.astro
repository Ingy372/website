---
import { offer } from "../../data/school";
import { business, founded } from "../../data/business";
import { minimumAge, trialDaysText } from "../../data/schedule";
import { ratingText, countText } from "../../data/reviews";
import CountUp from "../motion/CountUp.astro";
import figureWhite from "../../images/figure_white.png";
import figureGold from "../../images/figure_gold.png";
// The full logo badge with the kick figure cut out (derived from
// School_logo_black_background.svg: figure and a hidden white box removed,
// cropped to the badge). The figure flies in and lands in its slot.
import badgeUrl from "../../images/logo-badge-no-figure.svg?url";

// The kick figure's color. This is the ONE line to change: "white" | "gold".
// White matches the real logo. To preview live in the browser, set
// --hero-figure: var(--figure-gold) on .hero-badge in devtools.
const figureColor: "white" | "gold" = "white";
const figureVars = `--figure-white:url("${figureWhite.src}");--figure-gold:url("${figureGold.src}");--hero-figure:var(--figure-${figureColor})`;
---

<header class="relative overflow-hidden bg-indigo text-white" data-nav-sentinel>
  <div
    class="pointer-events-none absolute left-[44%] top-[-140px] h-[560px] w-[560px] rounded-full border border-gold/[0.13] will-change-transform"
    data-parallax="0.35"
    aria-hidden="true"
  >
  </div>
  <div class="relative z-10 mx-auto grid max-w-6xl gap-14 px-6 md:px-5 py-20 md:grid-cols-[1.25fr_0.85fr] md:items-start md:gap-12 md:py-20">
    <div>
      <span style="--hero-delay:0ms" class="hero-in mb-5 inline-flex items-center gap-2.5 text-xs font-semibold tracking-[0.2em] text-gold-soft uppercase">
        <span class="h-px w-[30px] bg-gold" aria-hidden="true"></span>
        Christian Martial Arts &middot; Since {founded.year}
      </span>
      <h1 style="--hero-delay:70ms" class="hero-in max-w-[15ch] text-[clamp(2.4rem,4.6vw,4rem)]">
        Discipline that follows them <span class="text-gold-soft">off the mat.</span>
      </h1>
      <p style="--hero-delay:140ms" class="hero-in mt-6 max-w-[44ch] text-lg text-[#C9C8D8]">
        A family dojo serving <b class="font-semibold text-white">Raeford</b>, <b
          class="font-semibold text-white">Fayetteville</b>, and <b
          class="font-semibold text-white">Hope Mills</b>. Where kids, teens, and adults build
        confidence, focus, and real self-defense. One belt at a time.
      </p>
      <div style="--hero-delay:210ms" class="hero-in mt-9 flex flex-wrap gap-8">
        <div class="border-l-2 border-gold pl-3.5">
          <b class="block font-display text-[1.75rem] font-black text-white"><CountUp value={founded.yearsNumeral} /></b>
          <span class="text-[0.78rem] text-[#B0AFC2]">Years, one family</span>
        </div>
        <div class="border-l-2 border-gold pl-3.5">
          <b class="block font-display text-[1.75rem] font-black text-white">
            <CountUp value={ratingText} /> <span class="text-[0.9rem] tracking-[2px] text-gold">&#9733;</span>
          </b>
          <span class="text-[0.78rem] text-[#B0AFC2]"><CountUp value={countText} /> Google reviews</span>
        </div>
        <div class="border-l-2 border-gold pl-3.5">
          <b class="block font-display text-[1.75rem] font-black text-white">Ages {minimumAge}+</b>
          <span class="text-[0.78rem] text-[#B0AFC2]">Preschool to adult</span>
        </div>
      </div>
    </div>

    <div class="flex flex-col items-center gap-8 md:gap-6">
    <!-- The logo assembles itself: the badge shows with the kick figure's slot
         faint, then the figure flies in from the right and lands exactly where
         it sits in the real logo. The figure box is the PNG's full extent in
         the badge's 430x470 viewBox, measured against the logo's own
         silhouette mask (x 224.40, y 239.33, w 172.89, h 203.63), and
         stretched to it the same way the logo stretches it. -->
    <div
      class="hero-badge relative aspect-[430/470] w-[200px] md:w-[124px]"
      style={figureVars}
      role="img"
      aria-label="Yeshua's Ryu Martial Arts emblem: a martial artist kicking over a red cross, ringed by the words Be More Than a Conqueror"
    >
      <div class="badge-stage absolute inset-0">
        <img src={badgeUrl} alt="" width="430" height="470" class="absolute inset-0 h-full w-full" />
        <div class="badge-figure badge-slot" aria-hidden="true"></div>
        <div class="badge-figure badge-kick" aria-hidden="true"></div>
      </div>
    </div>
    <script is:inline>
      // Hold the fly-in until the badge art has loaded and the badge is on
      // screen (on phones it starts below the fold), so the landing is seen.
      // Runs before first paint; without JS the CSS just plays on load.
      (function () {
        var badge = document.currentScript.previousElementSibling;
        var art = badge.querySelector("img");
        var loaded = art.complete;
        var seen = badge.getBoundingClientRect().top < window.innerHeight * 0.8;
        if ((loaded && seen) || !("IntersectionObserver" in window)) return;
        badge.classList.add("badge-wait");
        var go = function () {
          if (loaded && seen) badge.classList.remove("badge-wait");
        };
        art.addEventListener("load", function () { loaded = true; go(); });
        art.addEventListener("error", function () { loaded = true; go(); });
        var io = new IntersectionObserver(function (entries) {
          if (!entries[0].isIntersecting) return;
          io.disconnect();
          seen = true;
          go();
        }, { threshold: 0.6 });
        io.observe(badge);
      })();
    </script>

    <div style="--hero-delay:260ms" class="hero-in w-full rounded border-t-4 border-gold bg-white p-7 shadow-[0_26px_60px_-28px_rgba(0,0,0,0.6)]">
      <h2 class="font-display text-2xl font-black text-indigo">Start with a {offer.noun}.</h2>
      <div class="mb-4 mt-1 text-xs font-bold tracking-[0.14em] text-gold-deep uppercase">No cost</div>
      <p class="text-sm text-mist">
        Pick a class, choose a day {trialDaysText}, and reserve your spot in under two minutes.
        No uniform, no equipment, no pressure.
      </p>
      <a
        href="/booking"
        class="mt-6 block rounded-sm bg-indigo px-4 py-4 text-center font-bold text-white transition-all duration-200 ease-out hover:-translate-y-0.5 hover:shadow-lg hover:shadow-gold/35 motion-reduce:hover:translate-y-0 hover:bg-gold hover:text-indigo-deep"
      >
        {offer.cta}
      </a>
      <a
        href="/contact?interest=trial-question"
        class="mt-3 block rounded-sm border border-indigo/25 px-4 py-3.5 text-center text-sm font-semibold text-indigo transition-colors hover:border-gold"
      >
        Have a question first? Ask us
      </a>
      <div class="mt-3 text-center text-[0.76rem] text-mist">
        Or call <a href={business.phoneHref} class="font-bold text-indigo">{business.phone}</a>
      </div>
    </div>
    </div>
  </div>
</header>

<script>
  // Gentle depth: as the page scrolls, the background ring drifts down at a
  // fraction of scroll speed, so it lags the copy. Transform only (no layout, no CLS), one rAF per frame, and only
  // while the hero is on screen. Reduced motion: never runs.
  const layers = [...document.querySelectorAll<HTMLElement>("[data-parallax]")];
  const hero = layers[0]?.closest("header");
  if (hero && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    let onScreen = true;
    let queued = false;
    const update = () => {
      queued = false;
      const y = Math.min(window.scrollY, hero.offsetTop + hero.offsetHeight);
      for (const el of layers) {
        el.style.transform = `translate3d(0, ${(y * Number(el.dataset.parallax)).toFixed(1)}px, 0)`;
      }
    };
    const onScroll = () => {
      if (!onScreen || queued) return;
      queued = true;
      requestAnimationFrame(update);
    };
    new IntersectionObserver(([entry]) => {
      onScreen = entry.isIntersecting;
      // Leaving fast can skip frames; snap to the final offset on exit too.
      queued = false;
      requestAnimationFrame(update);
    }).observe(hero);
    window.addEventListener("scroll", onScroll, { passive: true });
  }
</script>

<style>
  /* One quick staggered rise on load: eyebrow, headline, subtext, stats,
     then the trial card. CSS only, so the copy never waits on a script. */
  .hero-in {
    animation: hero-in 0.5s cubic-bezier(0.22, 1, 0.36, 1) var(--hero-delay, 0ms) both;
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  /* The badge fades in with the hero; the figure flies in from the right,
     slightly big and tilted, drives in, overshoots a hair, and snaps
     home. The badge gives a small "thump" as it lands. Full-res PNG scaled
     by CSS, so it stays crisp. */
  .hero-badge {
    animation: hero-in 0.5s cubic-bezier(0.22, 1, 0.36, 1) 100ms both;
  }

  /* Timed to the kick's landing (450ms delay + ~78% of 1000ms). */
  .badge-stage {
    animation: badge-thump 0.6s cubic-bezier(0.3, 0, 0.3, 1) 1230ms;
  }

  .badge-figure {
    position: absolute;
    left: 25.907%;
    top: 32.624%;
    width: 40.207%;
    height: 43.325%;
    background: var(--hero-figure) 0 0 / 100% 100% no-repeat;
  }

  .badge-slot {
    opacity: 0.13;
  }

  .badge-kick {
    transform-origin: 30% 95%;
    animation: badge-kick 1s cubic-bezier(0.16, 1, 0.3, 1) 450ms both;
  }

  .badge-wait .badge-stage,
  .badge-wait .badge-kick {
    animation-play-state: paused;
  }

  @keyframes badge-kick {
    0% {
      opacity: 0;
      transform: translate(170%, -14%) rotate(14deg) scale(1.3);
    }
    25% {
      opacity: 1;
    }
    78% {
      transform: translate(-3%, 1%) rotate(-2deg) scale(0.98);
    }
    100% {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes badge-thump {
    40% {
      transform: scale(1.025);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-in,
    .hero-badge,
    .badge-stage,
    .badge-kick {
      animation: none;
    }
  }
</style>
