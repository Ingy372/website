---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import { beginnerTimes, type ProgramId } from "../../data/schedule";

interface Props {
  image: ImageMetadata;
  alt: string;
  ageLabel: string;
  title: string;
  tag: string;
  description: string;
  href: string;
  /** CSS object-position for the image, e.g. "50% 30%". Defaults to center. */
  position?: string;
  /** Shows this program's beginner class times over the photo (from schedule.ts). */
  program?: ProgramId;
}
const { image, alt, ageLabel, title, tag, description, href, position, program } = Astro.props;
const times = program ? beginnerTimes(program) : [];
---

<div class="program-card group flex flex-col overflow-hidden rounded border border-paper-warm bg-white transition-all duration-300 ease-out hover:-translate-y-1 hover:border-gold motion-reduce:hover:translate-y-0 hover:shadow-[0_18px_40px_-20px_rgba(25,26,62,0.45)]">
  <div class="relative aspect-square overflow-hidden">
    <Picture
      src={image}
      alt={alt}
      formats={["avif", "webp"]}
      widths={[280, 420, 640, 800]}
      sizes="(min-width: 768px) 360px, calc(100vw - 48px)"
      pictureAttributes={{ class: "block h-full w-full" }}
      class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.04] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
      style={position ? `object-position:${position}` : undefined}
    />
    {times.length > 0 && (
      <div class="card-detail absolute inset-x-0 bottom-0 bg-linear-to-t from-indigo-deep/90 via-indigo-deep/65 to-transparent px-4 pt-12 pb-3.5 text-white">
        <div class="text-[0.68rem] font-bold tracking-[0.15em] text-gold-soft uppercase">Beginner classes</div>
        <ul class="mt-1">
          {times.map((t) => (
            <li class="text-[0.88rem] font-semibold leading-snug">{t.days} &middot; {t.time}</li>
          ))}
        </ul>
      </div>
    )}
  </div>
  <div class="bg-indigo px-4 py-2 text-[0.7rem] font-bold tracking-[0.15em] text-gold-soft uppercase">
    {ageLabel}
  </div>
  <div class="flex flex-1 flex-col p-6">
    <h3 class="text-xl font-black text-indigo">{title}</h3>
    <div class="mb-3 text-[0.82rem] font-semibold text-gold-deep">{tag}</div>
    <p class="flex-1 text-[0.93rem] text-mist">{description}</p>
    <a href={href} class="mt-4 inline-flex items-center gap-1.5 text-[0.88rem] font-bold text-indigo hover:text-gold">
      Learn more <span aria-hidden="true">&rarr;</span>
    </a>
  </div>
</div>

<style>
  /* Class times over the photo. Touch screens (no hover) always show them;
     mouse users get them sliding up on hover, keyboard users on focus. */
  @media (hover: hover) {
    .card-detail {
      opacity: 0;
      transform: translateY(14px);
      transition:
        opacity 0.3s ease-out,
        transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .program-card:hover .card-detail,
    .program-card:focus-within .card-detail {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card-detail {
      transition: none;
      transform: none;
    }
  }
</style>
