---
// The widget's accent color (button, links) is set per-tenant in DojoForge's
// own dashboard (a "primaryColor" tied to the public key below), not from
// anything in this markup — ask Nic to match it to our indigo/gold palette.
//
// Boundary: this component only embeds the widget and handles it failing to
// load. Everything the widget shows (class names, times, bookable days,
// blackout dates, the offer wording inside it) is Dojo Forge admin config,
// not site code; keep it in sync with src/data/schedule.ts by hand there.
import { dojoForge, offer } from "../../data/school";
import { business } from "../../data/business";
import { PROGRAM_OPTIONS, DAY_OPTIONS, BOOKING_HONEYPOT } from "../../lib/bookingRequest";

const inputClass =
  "mt-1 block w-full rounded-sm border border-[#D9D3C3] bg-white px-3 py-2.5 text-base font-normal text-[#2A2A26] focus:border-indigo focus:outline-none";

// How long to wait for the widget to render before showing the fallback.
const LOAD_TIMEOUT_MS = 10000;
---

<div class="rounded border border-paper-warm bg-white p-5 sm:p-8">
  <div data-dojo-forge-widget class="min-h-[420px]">
    <p data-df-placeholder class="py-16 text-center text-sm text-mist">Loading the booking form…</p>
  </div>

  <div id="df-fallback" class="hidden pb-2 pt-4 text-center" role="alert">
    <h2 class="mb-2 font-display text-xl font-black text-indigo">The booking calendar didn't load.</h2>
    <p class="text-sm text-mist">
      That's on us, not you. Use the short form below and we'll reach out to set up your visit,
      or call <a href={business.phoneHref} class="font-semibold text-indigo hover:text-gold">{business.phone}</a>.
    </p>
  </div>

  <!-- Backup booking form. Plain HTML, so it works in every browser and
       in-app browser, even with JavaScript off. Shown when the widget fails,
       when a visitor asks for it, or when JavaScript is off (noscript style). -->
  <form id="booking-request" method="post" action="/api/booking-request" class="hidden pt-4 text-left">
    <h2 class="mb-1 font-display text-xl font-black text-indigo">Request your {offer.noun}</h2>
    <p class="mb-5 text-sm text-mist">We'll call or text to confirm a class time. Give us a phone number or an email.</p>

    <label class="mb-4 block text-sm font-semibold text-indigo">
      Your name
      <input name="name" type="text" required maxlength="100" autocomplete="name" class={inputClass} />
    </label>
    <div class="grid gap-x-4 sm:grid-cols-2">
      <label class="mb-4 block text-sm font-semibold text-indigo">
        Phone
        <input name="phone" type="tel" maxlength="30" autocomplete="tel" inputmode="tel" class={inputClass} />
      </label>
      <label class="mb-4 block text-sm font-semibold text-indigo">
        Email
        <input name="email" type="email" maxlength="254" autocomplete="email" class={inputClass} />
      </label>
    </div>
    <div class="grid gap-x-4 sm:grid-cols-[1fr_auto]">
      <label class="mb-4 block text-sm font-semibold text-indigo">
        Program
        <select name="program" class={inputClass}>
          <option value="">Not sure yet</option>
          {PROGRAM_OPTIONS.map((o) => <option value={o.value}>{o.label}</option>)}
        </select>
      </label>
      <label class="mb-4 block text-sm font-semibold text-indigo">
        Student's age
        <input name="studentAge" type="number" min="3" max="99" inputmode="numeric" class={`${inputClass} sm:w-28`} />
      </label>
    </div>
    <label class="mb-5 block text-sm font-semibold text-indigo">
      Preferred day
      <select name="day" class={inputClass}>
        {DAY_OPTIONS.map((o) => <option value={o.value}>{o.label}</option>)}
      </select>
    </label>

    <div class="absolute -left-[9999px] h-px w-px overflow-hidden" aria-hidden="true">
      <label>Leave this empty <input name={BOOKING_HONEYPOT} type="text" tabindex="-1" autocomplete="off" /></label>
    </div>
    {["utm_source", "utm_medium", "utm_campaign", "utm_content", "utm_term", "landing_page", "referrer"].map((n) => (
      <input type="hidden" name={n} value="" />
    ))}

    <button type="submit" class="w-full rounded-sm bg-gold px-7 py-4 font-bold text-indigo-deep hover:bg-gold-soft">
      Send My Request
    </button>
    <p class="mt-3 text-center text-xs text-mist">
      Or call <a href={business.phoneHref} class="font-semibold text-indigo hover:text-gold">{business.phone}</a> and we'll book you right away.
    </p>
  </form>

  <noscript>
    <style>
      #booking-request { display: block !important; }
      [data-dojo-forge-widget], #df-switch { display: none !important; }
    </style>
  </noscript>
</div>

<p id="df-switch" class="mt-4 text-center text-sm text-mist">
  Form not working on your phone?
  <a href="#booking-request" data-show-booking-request class="font-semibold text-indigo underline hover:text-gold">Use our simple form</a>
  or call <a href={business.phoneHref} class="font-semibold text-indigo hover:text-gold">{business.phone}</a>.
</p>

<script is:inline define:vars={{ timeoutMs: LOAD_TIMEOUT_MS, widgetSrc: dojoForge.widgetSrc }}>
  (function () {
    var mount = document.querySelector("[data-dojo-forge-widget]");
    var fallback = document.getElementById("df-fallback");
    var backupForm = document.getElementById("booking-request");
    var switchLine = document.getElementById("df-switch");
    if (!mount || !fallback || !backupForm) return;

    // Fill the backup form's hidden attribution fields: first-touch data
    // saved by FirstTouch.astro, then anything on this page's URL.
    try {
      var params = new URLSearchParams(location.search);
      var first = JSON.parse(localStorage.getItem("az_first_touch") || "{}");
      ["utm_source", "utm_medium", "utm_campaign", "utm_content", "utm_term", "landing_page", "referrer"].forEach(function (k) {
        var input = backupForm.querySelector('input[name="' + k + '"]');
        if (input) input.value = params.get(k) || first[k] || "";
      });
    } catch (e) {
      /* storage blocked: attribution is optional */
    }

    var showBackupForm = function () {
      mount.classList.add("hidden");
      backupForm.classList.remove("hidden");
      if (switchLine) switchLine.classList.add("hidden");
    };
    document.querySelectorAll("[data-show-booking-request]").forEach(function (link) {
      link.addEventListener("click", function (e) {
        e.preventDefault();
        showBackupForm();
        backupForm.scrollIntoView({ block: "start" });
        window.gtag && window.gtag("event", "booking_backup_form_opened", { link_url: location.pathname });
      });
    });

    // The widget counts as loaded once it puts anything in place of our placeholder.
    var rendered = function () {
      return !mount.querySelector("[data-df-placeholder]") || mount.children.length > 1;
    };
    var failed = false;
    var showFallback = function () {
      if (failed || rendered()) return;
      failed = true;
      fallback.classList.remove("hidden");
      showBackupForm();
      window.gtag && window.gtag("event", "booking_widget_failed", { link_url: location.pathname });
    };

    var timer = setTimeout(showFallback, timeoutMs);
    new MutationObserver(function () {
      if (rendered()) clearTimeout(timer);
      // The widget swaps its form for a "Thanks! We got your request" message
      // only after its server accepts the booking (res.ok). That swap is the
      // real lead. Checked on every change so the observer stays attached.
      if (!recordLead.done && /Thanks! We got your request/.test(mount.textContent || "")) {
        recordLead({ id: "widget-success" });
      }
    }).observe(mount, { childList: true, subtree: true, characterData: true });

    window.__dfWidgetError = showFallback;

    // A completed trial booking is the real lead. Besides the success message
    // above, a future widget version may announce it as a "dojoforge:lead"
    // CustomEvent or a postMessage from its own origin; each is counted once.
    var widgetOrigin = new URL(widgetSrc).origin;
    var recordLead = function (detail) {
      if (recordLead.done) return;
      recordLead.done = true;
      window.gtag && window.gtag("event", "generate_lead", { form_id: "dojoforge_booking" });
      window.fbq && window.fbq("track", "Lead", { content_name: "trial_booking" });
    };
    recordLead.done = false;
    window.addEventListener("dojoforge:lead", function (e) {
      recordLead(e.detail);
    });
    window.addEventListener("message", function (e) {
      if (e.origin === widgetOrigin && e.data && e.data.type === "dojoforge:lead") recordLead(e.data);
    });
  })();
</script>
<script
  is:inline
  src={dojoForge.widgetSrc}
  data-key={dojoForge.publicKey}
  async
  onerror="window.__dfWidgetError && window.__dfWidgetError()"
></script>
