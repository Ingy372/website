{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-07-23",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"name": "action-zone-cma",
	// Keep the workers.dev URL and preview URLs on (wrangler turns them off by
	// default once routes are listed).
	"workers_dev": true,
	"preview_urls": true,
	// Production hostnames, served as Worker Custom Domains (Cloudflare manages
	// their DNS records and certificates).
	"routes": [
		{ "pattern": "actionzonecma.com", "custom_domain": true },
		{ "pattern": "www.actionzonecma.com", "custom_domain": true }
	],
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	// Contact form: at most 5 submissions per client IP per minute
	// (src/lib/contact.ts). namespace_id is just a unique number per account.
	"ratelimits": [
		{
			"name": "CONTACT_RATE_LIMIT",
			"namespace_id": "1001",
			"simple": { "limit": 5, "period": 60 }
		}
	]
	// TODO(JAY: enable contact-form email delivery). Requires Cloudflare Email
	// Service sending (Workers paid plan) with actionzonecma.com onboarded as a
	// sending domain (adds DNS records). Then uncomment, and set the
	// CONTACT_TO_EMAIL / CONTACT_FROM_EMAIL vars and TURNSTILE_SECRET_KEY secret.
	// Until then /api/contact answers 503 ("call us") and logs a backup copy.
	// ,"send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["website@actionzonecma.com"] }]
	// Optional backup copy of every submission (create the namespace first):
	// ,"kv_namespaces": [{ "binding": "CONTACT_LOG", "id": "<namespace id>" }]
}