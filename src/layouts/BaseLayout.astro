---
import "../styles/global.css";
import { Font, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import Analytics from "../components/Analytics.astro";
import FirstTouch from "../components/FirstTouch.astro";
import BeltBar from "../components/BeltBar.astro";
import AnnouncementBar from "../components/AnnouncementBar.astro";
import Nav from "../components/nav/Nav.astro";
import MobileCallBar from "../components/nav/MobileCallBar.astro";
import Footer from "../components/Footer.astro";
import { business, serviceArea, isTodo } from "../data/business";
import { siteVerification } from "../data/school";
import { openingHoursSpecification } from "../data/schedule";
import { faqJsonLd, type FaqItem } from "../lib/faqSchema";

interface Props {
  /** Short page title; " | Action Zone CMA" is added unless `fullTitle` is set. */
  title: string;
  /** Complete <title> text, used as-is (keep it under about 60 characters). */
  fullTitle?: string;
  description: string;
  path: string;
  /** Keep this page out of search results (404, utility pages). Drops the canonical. */
  noindex?: boolean;
  /** Share image (Facebook, iMessage, etc.), cropped to 1200x630 at build time. Defaults to /og-image.jpg. */
  ogImage?: ImageMetadata;
  ogImageAlt?: string;
  /** Breadcrumb label for this page. Defaults to `title`. */
  crumb?: string;
  /** FAQ entries on this page, emitted as FAQPage structured data. */
  faq?: FaqItem[];
}

const { title, description, path, noindex = false, ogImage: ogSource, faq = [] } = Astro.props;
const canonicalURL = new URL(path, Astro.site);
const pageTitle = Astro.props.fullTitle ?? `${title} | ${business.displayName}`;

// 1200x630 share image: this page's hero photo when given, otherwise the
// site-wide default generated by scripts/build-social-images.mjs.
let ogImage = new URL("/og-image.jpg", Astro.site).href;
let ogImageAlt = Astro.props.ogImageAlt ?? "Students in white uniforms practicing a punch together on the dojo mat";
if (ogSource) {
  const img = await getImage({ src: ogSource, width: 1200, height: 630, fit: "cover", position: "attention", format: "jpg", quality: 80 });
  ogImage = new URL(img.src, Astro.site).href;
}

// No aggregateRating here on purpose: Google ignores self-published ratings
// for a business's own LocalBusiness markup, and an unverified count risks a
// manual action. The rating shows in page copy (from reviews.json) instead.
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  additionalType: "https://schema.org/SportsActivityLocation",
  "@id": "https://actionzonecma.com/#business",
  name: business.displayName,
  legalName: business.legalName,
  url: "https://actionzonecma.com/",
  image: new URL("/og-image.jpg", Astro.site).href,
  telephone: "+1-910-429-2467",
  email: business.email,
  address: {
    "@type": "PostalAddress",
    streetAddress: business.address.street,
    addressLocality: business.address.city,
    addressRegion: business.address.state,
    postalCode: business.address.zip,
    addressCountry: "US",
  },
  geo: { "@type": "GeoCoordinates", latitude: business.geo.latitude, longitude: business.geo.longitude },
  hasMap: business.googleReviewsUrl,
  openingHoursSpecification,
  areaServed: serviceArea.map((name) => ({ "@type": "City", name: `${name}, NC` })),
  sameAs: [business.googleReviewsUrl, business.socials.facebook, business.socials.instagram],
};

// Home > This page, on every indexable inner page.
const breadcrumbSchema =
  path !== "/" && !noindex
    ? {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: [
          { "@type": "ListItem", position: 1, name: "Home", item: "https://actionzonecma.com/" },
          { "@type": "ListItem", position: 2, name: Astro.props.crumb ?? title, item: canonicalURL.href },
        ],
      }
    : null;

const faqSchema = faq.length > 0 ? faqJsonLd(faq) : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Analytics />
    <FirstTouch />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalURL} />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={business.displayName} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {Object.entries(siteVerification).map(([name, content]) => content && <meta name={name} content={content} />)}

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Self-hosted via the Astro Fonts API (astro.config.mjs). Each family is a
         single latin variable-font file covering every weight, and both are used
         above the fold (hero paragraph = LCP, hero headline), so preload both. -->
    <Font cssVariable="--font-archivo" preload />
    <Font cssVariable="--font-fraunces" preload />

    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} is:inline />
    {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />}
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />}
    <slot name="head" />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded focus:bg-white focus:px-4 focus:py-2 focus:text-indigo"
    >
      Skip to content
    </a>
    <AnnouncementBar />
    <BeltBar />
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <MobileCallBar />
  </body>
</html>
