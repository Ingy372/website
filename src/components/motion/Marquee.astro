---
// Infinite horizontal word strip. The track holds two identical halves and
// slides exactly one half's width, so the loop point is invisible. Each half
// repeats the words enough times to stay wider than the screen.
// The HTML holds the word list once (what screen readers and crawlers get);
// the script clones the looping copies and marks every clone aria-hidden.
// Reduced motion: no clones, no movement; the words sit centered and wrap.
interface Props {
  items: string[];
  label: string;
  variant?: "dark" | "light";
  /** Copies of the word list inside each half (keep each half wider than ~2600px). */
  repeat?: number;
  /** Seconds for one half to scroll past. */
  duration?: number;
  reverse?: boolean;
}
const { items, label, variant = "dark", repeat = 3, duration = 45, reverse = false } = Astro.props;
---

<div
  class:list={[
    "marquee relative overflow-hidden py-5",
    variant === "dark"
      ? "border-y border-gold/15 bg-indigo-deep text-white"
      : "border-y border-paper-warm bg-white text-indigo",
  ]}
  style={`--marquee-duration:${duration}s`}
  data-reverse={reverse ? "" : undefined}
  data-marquee-repeat={repeat}
>
  <div class="marquee-track flex w-max">
    <ul class="marquee-half flex shrink-0 items-center" aria-label={label}>
      {items.map((item) => (
        <li class="flex items-center">
          <span
            class:list={[
              "whitespace-nowrap px-7",
              variant === "dark"
                ? "text-sm font-bold tracking-[0.22em] uppercase"
                : "font-display text-[1.35rem] font-semibold italic",
            ]}
          >
            {item}
          </span>
          <span class="h-1.5 w-1.5 rotate-45 bg-gold" aria-hidden="true"></span>
        </li>
      ))}
    </ul>
  </div>
</div>

<script>
  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    for (const root of document.querySelectorAll<HTMLElement>(".marquee")) {
      const track = root.querySelector<HTMLElement>(".marquee-track")!;
      const half = track.querySelector<HTMLElement>(".marquee-half")!;
      const words = [...half.children];
      const repeat = Number(root.dataset.marqueeRepeat) || 3;
      for (let i = 1; i < repeat; i++) {
        for (const li of words) {
          const clone = li.cloneNode(true) as HTMLElement;
          clone.setAttribute("aria-hidden", "true");
          half.append(clone);
        }
      }
      const copy = half.cloneNode(true) as HTMLElement;
      copy.removeAttribute("aria-label");
      copy.setAttribute("aria-hidden", "true");
      track.append(copy);
      root.classList.add("is-looping");
    }
  }
</script>

<style>
  /* Reduced motion: the list once, centered, wrapping. */
  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      width: 100%;
      justify-content: center;
    }

    .marquee-half {
      flex-wrap: wrap;
      justify-content: center;
      row-gap: 0.75rem;
      flex-shrink: 1;
    }
  }

  .is-looping .marquee-track {
    animation: marquee var(--marquee-duration) linear infinite;
  }

  .marquee[data-reverse] .marquee-track {
    animation-direction: reverse;
  }

  @media (hover: hover) {
    .marquee:hover .marquee-track {
      animation-play-state: paused;
    }
  }

  @keyframes marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
</style>
