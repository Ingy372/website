---
// A stat that counts up from zero the first time it scrolls into view.
// The HTML holds the real value once (what screen readers and crawlers get):
// no JS, a script error, or reduced motion all leave the final number
// showing, never "0". While counting, the real number is kept in place but
// transparent (so it still reserves the width) and an aria-hidden overlay
// shows the count; the overlay is removed when it lands.
interface Props {
  /** Final value as displayed, e.g. "32", "5.0", "83". */
  value: string;
}
const { value } = Astro.props;
---

<span class="relative inline-block whitespace-nowrap tabular-nums" data-count-to={value}>{value}</span>

<script>
  const DURATION = 2100;

  function countUp(el: HTMLElement) {
    const final = el.dataset.countTo ?? "";
    const target = Number.parseFloat(final);
    if (!Number.isFinite(target)) return;
    const decimals = (final.split(".")[1] ?? "").length;

    const overlay = document.createElement("span");
    overlay.setAttribute("aria-hidden", "true");
    overlay.style.cssText = `position:absolute;inset:0;color:${getComputedStyle(el).color}`;
    overlay.textContent = (0).toFixed(decimals);
    el.style.color = "transparent";
    el.appendChild(overlay);

    let finished = false;
    const finish = () => {
      finished = true;
      overlay.remove();
      el.style.color = "";
    };
    // Safety net: whatever happens mid-animation, land on the real number.
    const safety = window.setTimeout(finish, DURATION + 500);
    let start: number | undefined;
    const step = (now: number) => {
      if (finished) return;
      try {
        start ??= now;
        const progress = Math.min((now - start) / DURATION, 1);
        if (progress >= 1) {
          window.clearTimeout(safety);
          finish();
          return;
        }
        const eased = 1 - (1 - progress) ** 3;
        overlay.textContent = (target * eased).toFixed(decimals);
        requestAnimationFrame(step);
      } catch {
        finish();
      }
    };
    requestAnimationFrame(step);
  }

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (!reduceMotion && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          observer.unobserve(entry.target);
          countUp(entry.target as HTMLElement);
        }
      },
      { threshold: 0.6 },
    );
    document.querySelectorAll<HTMLElement>("[data-count-to]").forEach((el) => observer.observe(el));
  }
</script>
