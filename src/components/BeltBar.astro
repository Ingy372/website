---
// The belt bar motif: a 7-segment strip at the top of every page,
// white -> yellow -> orange -> green -> blue -> brown -> black.
const segments = [
  "#F5F2EA", // white
  "var(--color-gold-soft)", // yellow
  "var(--color-gold)", // orange (gold)
  "#2E7D5B", // green
  "#2C5C93", // blue
  "#7B5E1E", // brown
  "var(--color-indigo)", // black (charcoal stand-in)
];
---

<div class="flex h-1.5 w-full" aria-hidden="true">
  {segments.map((color) => (
    <span class="flex-1" style={{ backgroundColor: color }}></span>
  ))}
</div>
