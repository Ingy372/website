---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTASection from "../components/sections/CTASection.astro";
import { offer } from "../data/school";
import { business, cityState } from "../data/business";
import { getReview, displayAuthor, reviewDateText, ratingText, countText } from "../data/reviews";

// Real Google reviews, word for word (src/data/reviews.json). Ordered to lead
// with ones that mention kids, karate, or a town.
const quotes = [
  "taylor-s", "sarah-g", "savanna-f", "amber-l", "heidi-c", "rachel-b",
  "john-s", "courtney-m", "benjamin-s", "cara-p", "dee-a", "jacy-d",
].map(getReview);
---

<BaseLayout
  title="Reviews"
  fullTitle={`Reviews: Kids Martial Arts in Raeford NC | ${business.displayName}`}
  description={`${ratingText} stars across ${countText} Google reviews from families in Raeford, Fayetteville, and Hope Mills. Read why kids love it, then try a ${offer.noun}.`}
  path="/reviews"
>
  <header class="relative overflow-hidden bg-indigo py-20 text-center text-white md:py-20">
    <div class="mx-auto max-w-3xl px-6 md:px-5">
      <span class="mb-5 inline-flex items-center gap-2.5 text-xs font-semibold tracking-[0.2em] text-gold-soft uppercase">
        Google Reviews
      </span>
      <h1 class="mx-auto max-w-[18ch] text-[clamp(2.2rem,4.4vw,3.5rem)]">What Families Say</h1>
      <p class="mx-auto mt-3 max-w-[24ch] font-display text-[clamp(1.3rem,2.3vw,1.8rem)] font-semibold leading-snug text-white/90">
        Families in Raeford <span class="text-gold-soft">trust us with their kids.</span>
      </p>
      <p class="mx-auto mt-5 max-w-[52ch] text-lg leading-loose text-[#C4C3D4] md:leading-normal">
        We are grateful for every family that has walked through our doors. Here is what some of
        them have shared.
      </p>

      <div class="mt-8 flex flex-wrap items-center justify-center gap-5">
        <div class="font-display text-4xl font-black text-gold-soft">{ratingText}</div>
        <div>
          <div class="text-xl tracking-[3px] text-gold" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
          <div class="text-sm text-[#C4C3D4]">Based on {countText} Google reviews</div>
        </div>
        <a
          href={business.googleReviewsUrl}
          target="_blank"
          rel="noopener"
          class="rounded-sm border border-white/25 px-5 py-2.5 text-sm font-semibold text-white hover:border-gold-soft hover:text-gold-soft"
        >
          Google Reviews
        </a>
      </div>
    </div>
  </header>

  <section class="py-20 md:py-20">
    <div class="mx-auto max-w-6xl px-6 md:px-5">
      <div class="mb-11 text-center">
        <div class="mb-3 text-xs font-bold tracking-[0.2em] text-gold-deep uppercase">In Their Words</div>
        <h2 class="text-[clamp(1.9rem,3.6vw,2.7rem)] text-indigo">Real reviews from real families.</h2>
      </div>

      <div class="gap-5 md:columns-2 lg:columns-3">
        {quotes.map((q) => (
          <div class="mb-5 break-inside-avoid rounded border border-paper-warm bg-white p-6">
            <div class="mb-3 text-sm tracking-[2px] text-gold" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
            <p class="text-[0.95rem] text-[#40403A]">{q.text}</p>
            <div class="mt-5 flex items-center gap-3">
              <div class="flex h-9 w-9 items-center justify-center rounded-full bg-indigo/10 font-display font-bold text-indigo">
                {q.author.charAt(0)}
              </div>
              <div>
                <div class="text-sm font-bold text-indigo">{displayAuthor(q)}</div>
                <div class="text-xs text-mist">{q.source} Review{reviewDateText(q) && ` · ${reviewDateText(q)}`}</div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <div class="mx-auto mt-10 max-w-3xl rounded border border-paper-warm bg-paper-warm p-8 text-center">
        <div class="mb-2 text-xs font-bold tracking-[0.15em] text-mist uppercase">Straight From Google</div>
        <p class="mb-5 text-[#40403A]">
          Read every review families have left us, newest first, on our Google listing.
        </p>
        <a
          href={business.googleReviewsUrl}
          target="_blank"
          rel="noopener"
          class="inline-block rounded-sm bg-indigo px-6 py-3.5 font-bold text-white hover:bg-gold hover:text-indigo-deep"
        >
          See all {countText} reviews on Google
        </a>
      </div>
    </div>
  </section>

  <CTASection ctaLabel={offer.cta} ctaHref="/booking" secondaryLabel="Leave Us a Review" secondaryHref={business.googleWriteReviewUrl}>
    <Fragment slot="heading">Come see why families <em>keep coming back.</em></Fragment>
    <Fragment slot="subtext">The best way to understand Action Zone is to walk through the door. Your {offer.first} is on us.</Fragment>
  </CTASection>
</BaseLayout>
