---
interface QA {
  question: string;
  answer: string[];
}
interface Props {
  id: string;
  title: string;
  tag: string;
  items: QA[];
}
const { id, title, tag, items } = Astro.props;
---

<section id={id} class="py-10 first:pt-0 md:py-8">
  <div class="mx-auto max-w-3xl px-6 md:px-5">
    <div class="mb-6 flex items-baseline gap-3.5 border-b-2 border-gold pb-3.5">
      <h2 class="text-2xl font-black text-indigo">{title}</h2>
      <span class="ml-auto text-xs font-semibold tracking-[0.18em] text-mist uppercase">{tag}</span>
    </div>

    <div class="flex flex-col gap-3">
      {items.map((qa) => (
        <details class="group rounded border border-paper-line bg-white open:border-gold">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 font-display text-[1.05rem] font-semibold text-indigo">
            {qa.question}
            <span class="shrink-0 text-xl font-normal text-gold group-open:hidden" aria-hidden="true">+</span>
            <span class="hidden shrink-0 text-xl font-normal text-gold group-open:inline" aria-hidden="true">&minus;</span>
          </summary>
          <div class="max-w-[66ch] px-6 pb-6 text-[#43423B] md:px-5 md:pb-5">
            {qa.answer.map((p) => <p class="mb-4 last:mb-0 md:mb-3" set:html={p} />)}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
