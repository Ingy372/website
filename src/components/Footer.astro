---
import { nav } from "../data/school";
import { business, addressCityLine, founded, cityState } from "../data/business";
import { hours } from "../data/schedule";

const currentYear = new Date().getFullYear();
---

<!-- Below lg the fixed MobileCallBar (52px + safe-area inset) sits over the
     bottom of the page, so the footer adds exactly that much under its own
     3.5rem of padding. -->
<footer class="bg-[#0A0B1C] pb-[calc(3.5rem+52px+env(safe-area-inset-bottom))] pt-14 text-[#8E8DA2] lg:pb-14">
  <div class="mx-auto max-w-6xl px-6 md:px-5">
    <div class="mb-9 grid grid-cols-2 gap-9 md:grid-cols-[1.7fr_1fr_1fr_1fr]">
      <div class="col-span-2 md:col-span-1">
        <a href="/" class="font-display text-xl font-black text-white">
          {business.displayName}
          <span class="mt-0.5 block font-body text-[0.6rem] font-medium tracking-[0.26em] text-gold-soft">
            YESHUA'S RYU &middot; {cityState.toUpperCase()}
          </span>
        </a>
        <p class="mt-3.5 text-sm leading-[1.75]">
          {business.address.street}<br />
          {addressCityLine}<br />
          <a href={business.phoneHref} class="inline">{business.phone}</a>
        </p>
        <p class="mt-3.5 text-sm leading-[1.75] text-[#838297]">
          Teaching Yeshua's Ryu since {founded.year}.<br />
          Proudly serving Raeford, Fayetteville,<br />
          and Hope Mills.
        </p>
      </div>

      <div>
        <h2 class="mb-3.5 font-body text-[0.74rem] font-bold leading-normal tracking-[0.16em] text-gold-soft uppercase">Programs</h2>
        {nav.programs.map((item) => (
          <a href={item.href} class="mb-2 block text-sm hover:text-white">{item.label}</a>
        ))}
        <a href="/schedule" class="mb-2 block text-sm hover:text-white">Class Schedule</a>
        <a href="/birthday-parties" class="mb-2 block text-sm hover:text-white">Birthday Parties</a>
      </div>

      <div>
        <h2 class="mb-3.5 font-body text-[0.74rem] font-bold leading-normal tracking-[0.16em] text-gold-soft uppercase">School</h2>
        {nav.about.map((item) => (
          <a href={item.href} class="mb-2 block text-sm hover:text-white">{item.label}</a>
        ))}
        <a href="/facility" class="mb-2 block text-sm hover:text-white">Our Facility</a>
      </div>

      <div>
        <h2 class="mb-3.5 font-body text-[0.74rem] font-bold leading-normal tracking-[0.16em] text-gold-soft uppercase">Visit</h2>
        <p class="mb-3 text-sm leading-[1.75]">
          {hours.summary.map((row) => (
            <>
              {row.days} {row.time}<br />
            </>
          ))}
        </p>
        <a href="/contact" class="mb-2 block text-sm hover:text-white">Contact</a>
      </div>
    </div>

    <div class="border-t border-white/[0.07] pt-5 text-center text-[0.78rem] text-[#838297]">
      &copy; {currentYear} {business.legalName} &middot; {business.address.city}, {business.address.stateName}
      &middot; <a href="/privacy" class="hover:text-white">Privacy</a>
      &middot; <a href="/sms-terms" class="hover:text-white">SMS Terms</a>
    </div>
  </div>
</footer>
