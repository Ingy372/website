---
import BaseLayout from "../layouts/BaseLayout.astro";
import SimpleHero from "../components/hero/SimpleHero.astro";
import DojoForgeWidget from "../components/booking/DojoForgeWidget.astro";
import TrustSignals from "../components/sections/TrustSignals.astro";
import { offer } from "../data/school";
import { programs, programIds, ageLabel, beginnerTimes } from "../data/schedule";
import { business } from "../data/business";
import { trialDaysText } from "../data/schedule";
---

<BaseLayout
  title={offer.bookingTitle}
  description={`Book your ${offer.noun} at ${business.displayName} in ${business.address.city}, ${business.address.state}. Fill out the quick form and reserve your spot in minutes.`}
  path="/booking"
>
  <SimpleHero eyebrow="New Families">
    <Fragment slot="heading">{offer.cta}.</Fragment>
    <Fragment slot="subtext">
      Fill out the quick form below and we'll have your spot ready. Hannah is in the office
      {trialDaysText} to walk you through everything in person.
    </Fragment>
  </SimpleHero>

  <section class="py-20 md:py-16">
    <div class="mx-auto max-w-xl px-6 md:px-5">
      <!-- Beginner class times per program. /booking?program=kids (from the
           program pages) narrows this to that program. TODO(JAY: ask Nic
           whether the Dojo Forge widget accepts a program/class parameter
           to preselect; if so, pass it through here too.) -->
      <div id="program-times" class="mb-8 rounded border border-paper-warm bg-paper-warm p-6">
        <h2 class="mb-3 font-display text-lg font-bold text-indigo">Beginner class times</h2>
        <div class="flex flex-col gap-3">
          {programIds.map((id) => (
            <div data-program={id}>
              <div class="text-sm font-bold text-indigo">{programs[id].name} <span class="font-normal text-mist">({ageLabel(programs[id])})</span></div>
              <div class="text-sm text-[#40403A]">{beginnerTimes(id).map((t) => `${t.days}, ${t.time}`).join(" · ")}</div>
            </div>
          ))}
        </div>
      </div>

      <DojoForgeWidget />

      <div class="mt-10 rounded border border-paper-warm bg-white p-6">
        <TrustSignals />
      </div>

      <p class="mx-auto mt-6 max-w-xl text-center text-sm text-mist">
        Looking for current class times instead? See the <a
          href="/schedule" class="font-semibold text-indigo hover:text-gold">full schedule</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    var wanted = new URLSearchParams(location.search).get("program");
    var rows = document.querySelectorAll("#program-times [data-program]");
    var match = Array.prototype.some.call(rows, function (r) { return r.getAttribute("data-program") === wanted; });
    if (!match) return;
    rows.forEach(function (r) { if (r.getAttribute("data-program") !== wanted) r.hidden = true; });
  })();
</script>
