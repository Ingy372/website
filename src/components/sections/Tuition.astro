---
// "Tuition" block on the program pages. House rule (Jay, Oct 2026): never
// show tuition or prices on the site. This block only points people to the
// free trial week and the phone; do not add numbers here.
import { offer } from "../../data/school";
import { business } from "../../data/business";
import type { ProgramId } from "../../data/schedule";

interface Props {
  program: ProgramId;
}
---

<section class="pb-16 md:pb-20" id="tuition">
  <div class="mx-auto max-w-3xl px-6 md:px-5">
    <div class="rounded border-x border-b border-t-4 border-x-paper-warm border-b-paper-warm border-t-gold bg-white p-7">
      <h2 class="mb-3 font-display text-2xl font-black text-indigo">Tuition</h2>
      <p class="mb-3 text-[#40403A]">
        Your first week is free. We'll go over tuition and every option, in person and with no
        pressure, when you come in for your {offer.noun}.
      </p>
      <p class="text-sm text-mist">
        Questions about cost? Call <a href={business.phoneHref} class="font-semibold text-indigo hover:text-gold">{business.phone}</a>.
      </p>
    </div>
  </div>
</section>
