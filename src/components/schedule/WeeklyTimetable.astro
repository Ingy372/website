---
import { weeklySchedule } from "../../data/schedule";

const levelStyles: Record<string, string> = {
  beginner: "bg-[#2E7D5B]/10 text-[#276B4E]",
  intermediate: "bg-gold/10 text-[#8A6C10]",
  advanced: "bg-indigo/10 text-indigo",
};
---

<div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
  {weeklySchedule.map((day) => (
    <div class="rounded border border-paper-warm bg-white p-4">
      <h2 class="mb-3 border-b-2 border-gold pb-2 font-display text-lg font-black text-indigo">
        {day.day}
      </h2>

      {day.closed && <p class="text-sm font-semibold text-mist">Closed</p>}

      {day.openTraining && (
        <div>
          <div class="mb-1 font-display text-base font-bold text-indigo">
            {day.openTraining.timeRange}
          </div>
          <p class="text-sm text-ink">{day.openTraining.description}</p>
          <p class="mt-1 text-xs font-bold tracking-[0.08em] text-mist uppercase">
            {day.openTraining.note}
          </p>
        </div>
      )}

      {!day.closed && !day.openTraining && (
        <div class="flex flex-col gap-3">
          {day.classes.map((c) => (
            <div class="flex flex-col gap-1 border-b border-paper-warm pb-3 last:border-0 last:pb-0">
              <div class="flex items-baseline justify-between gap-2">
                <span class="font-display text-sm font-bold text-indigo">{c.time}</span>
                {c.inviteOnly && (
                  <span class="text-[0.65rem] font-bold tracking-[0.08em] text-mist uppercase">
                    By Invitation
                  </span>
                )}
              </div>
              <div class="font-semibold text-ink">{c.name}</div>
              <div class="flex items-center gap-2">
                <span class="text-sm text-mist">{c.ageLabel}</span>
                <span class={`rounded px-2 py-0.5 text-[0.65rem] font-bold uppercase ${levelStyles[c.level]}`}>
                  {c.level}
                </span>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  ))}
</div>
