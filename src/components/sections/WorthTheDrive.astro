---
// Short "why make the drive" list on the area pages. Facts only.
import { founded } from "../../data/business";

interface Props {
  heading?: string;
}
const { heading = "What you get when you get here" } = Astro.props;
const items = [
  { title: `${founded.yearsWordsCap} years, one family`, desc: "The same school and the same system since our founder opened the doors. He is still active and involved, and his stepson runs every class." },
  { title: "A real dojo on two acres", desc: "A 2,400 square foot building built by hand for martial arts, not a rented storefront." },
  { title: "A playground for siblings", desc: "The brother or sister who isn't in class plays outside while a parent supervises. Then everybody plays." },
  { title: "The ninja line and throwing wall", desc: "Training that feels like play, and a reason kids ask to come back." },
];
---

<section class="bg-indigo-deep py-16 text-white md:py-18">
  <div class="mx-auto max-w-6xl px-6 md:px-5">
    <h2 class="mb-9 max-w-[22ch] text-[clamp(1.8rem,3.4vw,2.5rem)] text-white">{heading}</h2>
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4 md:gap-6">
      {items.map((i) => (
        <div class="border-t-2 border-gold pt-4">
          <h3 class="mb-1.5 font-display text-lg font-semibold text-white">{i.title}</h3>
          <p class="text-[0.94rem] text-[#A3A2B6]">{i.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
