---
// Mobile-only sticky bar: [Call] [Free Trial Week], one thumb-tap each.
import { business } from "../../data/business";
import { offer } from "../../data/school";

// On /booking itself, jump to the form instead of reloading the page.
const bookingHref = Astro.url.pathname.replace(/(\.html|\/)$/, "") === "/booking" ? "#book" : "/booking";
---

<div
  class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-[2fr_3fr] shadow-[0_-4px_16px_rgba(0,0,0,0.15)] lg:hidden"
  style={{ paddingBottom: "env(safe-area-inset-bottom)" }}
>
  <a
    href={business.phoneHref}
    class="flex h-[52px] flex-col items-center justify-center bg-indigo-deep text-center font-bold leading-tight text-white"
    aria-label={`Call ${business.phone}`}
  >
    <span class="flex items-center gap-2">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
      <path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1L6.6 10.8z" />
    </svg>
    Call
    </span>
    <span data-open-status="short" class="text-[0.68rem] font-medium text-[#C7C6D6]"></span>
  </a>
  <a href={bookingHref} class="flex h-[52px] items-center justify-center bg-gold px-2 text-center text-[0.9rem] font-bold leading-tight text-indigo-deep">
    {offer.cta}
  </a>
</div>
