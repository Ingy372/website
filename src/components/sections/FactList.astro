---
// "At a glance" definition list: party details, PNO details, and the class
// summaries on the program pages.
import type { Fact } from "../../data/parties";
import { isTodo } from "../../data/business";

interface Props {
  heading: string;
  facts: Fact[];
  dark?: boolean;
}
const { heading, dark = false } = Astro.props;
// Unconfirmed facts are left out rather than shown as placeholders.
const facts = Astro.props.facts.filter((f) => !isTodo(f.value));
---

<div class={`rounded border-t-4 border-gold p-7 ${dark ? "bg-white/[0.05] text-white" : "border-x border-b border-x-paper-warm border-b-paper-warm bg-white"}`}>
  <h2 class={`mb-5 font-display text-2xl font-black ${dark ? "text-white" : "text-indigo"}`}>{heading}</h2>
  <dl class="grid gap-x-6 gap-y-3 sm:grid-cols-[auto_1fr]">
    {facts.map((f) => (
      <>
        <dt class={`text-xs font-bold tracking-[0.1em] uppercase sm:pt-1 ${dark ? "text-gold-soft" : "text-gold-deep"}`}>{f.label}</dt>
        <dd class={`mb-2 sm:mb-0 ${dark ? "text-[#CFCEDC]" : "text-[#40403A]"}`}>{f.value}</dd>
      </>
    ))}
  </dl>
</div>
