---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProgramHero from "../components/hero/ProgramHero.astro";
import ProseSection from "../components/sections/ProseSection.astro";
import PhotoStrip from "../components/sections/PhotoStrip.astro";
import FAQGroup from "../components/sections/FAQGroup.astro";
import ReviewQuote from "../components/sections/ReviewQuote.astro";
import CTASection from "../components/sections/CTASection.astro";
import { offer, tuitionFaqItem, militaryDiscount } from "../data/school";
import { founded, isTodo } from "../data/business";
import { openTraining, openTrainingTime, trialDaysText } from "../data/schedule";

import heroImage from "../images/kids/class-photo.jpg";
import playground from "../images/facility/playground.jpg";
import beltTest from "../images/kids/belt-test.jpg";
import warmUpCircle from "../images/little-warriors/warm-up-circle.jpg";

const hasDiscount = !isTodo(militaryDiscount) && militaryDiscount !== "";

const faqItems = [
  {
    question: "What if our schedule changes or we miss classes?",
    answer: [
      "We keep track of the days your student misses and offer them back as make-ups. Come in on one of your off days and pick up an extra session until you are caught up.",
      `Saturday open training (${openTrainingTime}) is open to every student, both as an extra day of training and as a chance to make up anything missed.`,
    ],
  },
  {
    question: "Can the whole family train?",
    answer: [
      "Yes. We teach ages 3 through adult. Parents and children 13 and up can train side by side in the teen and adult class, and on Saturdays the whole dojo trains together regardless of age or rank.",
    ],
  },
  ...(hasDiscount ? [{ question: "Do you offer a military discount?", answer: [`Yes: ${militaryDiscount}.`] }] : []),
  tuitionFaqItem(),
  {
    question: "Can we try it before we commit?",
    answer: [`Yes. Your first week is free. Book a ${offer.noun} online, or come by ${trialDaysText} when Hannah, our office manager, is in to walk you through everything.`],
  },
];
---

<BaseLayout
  title="Martial Arts for Fort Bragg Military Families"
  fullTitle="Martial Arts for Fort Bragg Military Families | Raeford NC"
  crumb="Military Families"
  description={`Kids karate and family martial arts near Fort Bragg, with make-up classes for busy schedules. Raeford, Fayetteville, Hope Mills. Try a ${offer.noun}.`}
  path="/military-families"
  ogImage={heroImage}
  ogImageAlt="Kids martial arts class standing together on the mat in Raeford, NC"
  faq={faqItems}
>
  <ProgramHero
    badge="Military Families Welcome"
    h1="Martial Arts for Fort Bragg Military Families"
    image={heroImage}
    alt="Kids karate class standing together on the mat in Raeford, NC"
    ctaLabel={offer.cta}
    ctaHref="/booking"
  >
    <Fragment slot="heading">A steady place <em>for kids on the move.</em></Fragment>
    <Fragment slot="subtext">
      Karate and martial arts for kids, teens, and adults in Raeford, right next door to Fort
      Bragg. Make-up classes for changing schedules, and a dojo that treats your family like
      family.
    </Fragment>
  </ProgramHero>

  {hasDiscount && (
    <div class="bg-gold/[0.12]">
      <p class="mx-auto max-w-3xl px-6 py-5 text-center font-semibold text-indigo md:px-5">
        Military families: {militaryDiscount}.
      </p>
    </div>
  )}

  <ProseSection kicker="Why Families Near Post Choose Us" heading="One thing that stays the same.">
    <p>
      Military kids get good at change. New houses, new schools, a parent who is home one month
      and deployed the next. What helps is something steady: the same instructors, the same
      routine, and a clear goal they can keep working toward no matter what else moves.
    </p>
    <p>
      That is what a martial arts class gives them. Every class follows a familiar rhythm. Every
      belt is a goal they can see coming. And in a small, family-run school, every student is
      known by name.
    </p>
    <p>
      Action Zone CMA has been teaching in Raeford for {founded.yearsWords} years, in Hoke County
      just outside Fort Bragg. Families also come to us from Fayetteville, Hope Mills, Rockfish,
      and Jack Britt.
    </p>
  </ProseSection>

  <section class="pb-16 md:pb-18">
    <div class="mx-auto max-w-6xl px-6 md:px-5">
      <PhotoStrip
        ratioClass="aspect-[4/3]"
        images={[
          { src: warmUpCircle, alt: "Young martial arts students warming up together in a circle", position: "50% 38%" },
          { src: beltTest, alt: "Young karate student testing for the next belt in front of the class", position: "50% 20%" },
          { src: playground, alt: "The outdoor playground where siblings play during class" },
        ]}
      />
    </div>
  </section>

  <ProseSection warm kicker="Built for Changing Schedules" heading="Missed a class? Make it up.">
    <p>
      Field exercises, duty days, and a household run by one parent for a while: schedules change.
      We keep track of the days your student misses and offer them back as make-ups. Come in on
      one of your off days and pick up an extra session until you are caught up.
    </p>
    <p>
      {openTraining.day} open training, {openTrainingTime}, is open to every student, all ages and
      ranks. It doubles as a make-up day and a chance for the whole family to train together.
    </p>
  </ProseSection>

  <ProseSection kicker="For the Whole Family" heading="Something for everyone in the house.">
    <p>
      <a href="/little-warriors">Little Warriors</a> (ages 3 to 5) builds listening and focus.
      <a href="/kids">Kids karate</a> (6 to 12) builds confidence, respect, and real
      self-defense. And the <a href="/teens-adults">teen and adult class</a> is a full-body
      workout with practical <a href="/self-defense">self-defense</a>, where a parent and an older
      child can train side by side.
    </p>
    <p>
      Bringing a younger sibling along? Our outdoor playground sits on two acres beside the dojo,
      so the brother or sister who is not in class can play while a parent supervises.
    </p>
    <p>
      Our system, Yeshua's Ryu, pairs martial arts with Christian character. Families of every
      background are welcome on our mat, and always have been.
    </p>
  </ProseSection>

  <ReviewQuote id="taylor-s" />

  <div class="py-12">
    <FAQGroup id="military-faq" title="Questions from military families" tag="Fort Bragg Families" items={faqItems} />
  </div>

  <CTASection ctaLabel={offer.cta} ctaHref="/booking">
    <Fragment slot="heading">Your {offer.first} is <em>completely free.</em></Fragment>
    <Fragment slot="subtext">Come try {offer.visit}. No cost, no commitment, no pressure.</Fragment>
  </CTASection>
</BaseLayout>
