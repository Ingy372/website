---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProgramHero from "../components/hero/ProgramHero.astro";
import SectionHead from "../components/sections/SectionHead.astro";
import NumberedCard from "../components/cards/NumberedCard.astro";
import PhotoStrip from "../components/sections/PhotoStrip.astro";
import ReassuranceBox from "../components/sections/ReassuranceBox.astro";
import CTASection from "../components/sections/CTASection.astro";
import ClassAtAGlance from "../components/sections/ClassAtAGlance.astro";
import Tuition from "../components/sections/Tuition.astro";
import FAQGroup from "../components/sections/FAQGroup.astro";
import { offer, tuitionFaqItem } from "../data/school";
import { programs, ageLabel, ageRange } from "../data/schedule";

const program = programs.littleWarriors;

import heroImage from "../images/little-warriors/class-photo.jpg";
import warmUpCircle from "../images/little-warriors/warm-up-circle.jpg";
import instructorTeachingKick from "../images/little-warriors/instructor-teaching-kick.jpg";
import matGame from "../images/little-warriors/mat-game.jpg";
import earningAStripe from "../images/little-warriors/earning-a-stripe.jpg";
import bowingIn from "../images/little-warriors/bowing-in.jpg";
import parentWatchingFromLobby from "../images/little-warriors/parent-watching-from-lobby.jpg";

const classSteps = [
  { image: warmUpCircle, position: "50% 38%", alt: "Preschool karate students in a circle warming up at the start of class", title: "Move and warm up", description: "Every class starts with the whole body: stretches, movement, and energy spent on purpose. It settles them and gets them ready to learn." },
  { image: instructorTeachingKick, position: "50% 35%", alt: "Instructor teaching a preschool karate student how to throw a kick", title: "Learn a skill", description: "Age-appropriate kicks, blocks, and stances, taught one clear step at a time, with an instructor watching and helping every child." },
  { image: matGame, position: "50% 45%", alt: "Little Warriors playing an active martial arts game on the dojo mat", title: "Play with a point", description: "Games and drills that never feel like a lesson, but quietly teach listening, patience, teamwork, and taking turns." },
];

const faqItems = [
  {
    question: "Is 3 too young for karate?",
    answer: [
      "No. Little Warriors is preschool karate built specifically for 3, 4, and 5 year olds. Classes are short, active, and broken into small pieces, so a young child can follow along and feel successful.",
    ],
  },
  {
    question: "What happens in a preschool karate class?",
    answer: [
      "Each class moves from a warm-up, to one clear skill like a kick, block, or stance, to a game that quietly teaches listening, waiting, and teamwork. Students earn stripes on their belt as they go, so they can see their progress.",
    ],
  },
  {
    question: "Can I stay and watch?",
    answer: ["Yes. Parents are always welcome to watch class. Many families also bring siblings, who can play on our outdoor playground with a parent supervising."],
  },
  tuitionFaqItem(),
  {
    question: "What happens when my child turns 6?",
    answer: [
      'They move up to our <a href="/kids" class="text-indigo font-bold border-b border-gold">kids karate classes</a> for ages 6 to 12, already knowing the room, the instructors, and how a class works.',
    ],
  },
];

const results = [
  { title: "They listen better", desc: "Following directions on the mat has a way of carrying over to following them at the dinner table." },
  { title: "They focus longer", desc: "Learning to hold attention for a few minutes at a time is a skill, and it grows with practice." },
  { title: "They believe in themselves", desc: "A child who earns a new stripe learns that hard things are worth doing, and that they can do them." },
  { title: "They start school ready", desc: "Listening, waiting, focus, and confidence are the exact things a kindergarten teacher hopes a child walks in with." },
];
---

<BaseLayout
  title={`Preschool Karate, ${ageLabel(program)}`}
  fullTitle={`Preschool Karate, ${ageLabel(program)} | Little Warriors | Raeford NC`}
  crumb="Little Warriors Preschool Karate"
  description={`Preschool karate for ages ${ageRange(program)}: focus, listening, and confidence through martial arts. Serving Raeford, Fayetteville, and Hope Mills. Try a ${offer.noun}.`}
  path="/little-warriors"
  ogImage={heroImage}
  ogImageAlt="Little Warriors preschool karate class standing at attention on the mat"
  faq={faqItems}
>
  <ProgramHero
    badge={`${program.name} · ${ageLabel(program)}`}
    h1={`Little Warriors: Preschool Karate & Martial Arts (${ageLabel(program)})`}
    image={heroImage}
    alt="Little Warriors preschool karate class of three-to-five-year-olds standing at attention on the mat"
    ctaLabel={offer.cta}
    ctaHref="/booking?program=littleWarriors"
  >
    <Fragment slot="heading">Small students. <em>Big beginnings.</em></Fragment>
    <Fragment slot="subtext">
      Little Warriors is preschool karate and toddler martial arts, built from the ground up for
      our youngest students. Before the kicks and blocks, they learn to listen, to focus, and to
      finish what they start.
    </Fragment>
  </ProgramHero>

  <section class="py-16 md:py-20">
    <div class="mx-auto max-w-3xl px-6 md:px-5">
      <ClassAtAGlance program="littleWarriors" heading="Preschool karate at a glance" />
    </div>
  </section>

  <section class="bg-paper-warm">
    <div class="mx-auto max-w-3xl px-6 md:px-5 py-20 md:py-20">
      <h2 class="mb-5 text-[clamp(1.8rem,3.4vw,2.5rem)] text-indigo">All that energy has to go somewhere.</h2>
      <p class="mb-6 text-lg leading-loose text-[#3E3E38] md:mb-4 md:leading-normal">
        A three, four, or five year old is not short on energy, curiosity, or opinions. What they
        are still learning is how to focus it: how to wait their turn, follow a direction the
        first time, and keep going when something gets hard. That is what karate for 3, 4, and 5
        year olds is really about.
      </p>
      <p class="text-lg leading-loose text-[#3E3E38] md:leading-normal">
        That is what Little Warriors is really for. The martial arts are real, but at this age,
        they are also the <strong class="font-semibold text-indigo">delivery method for something bigger</strong>:
        the focus and self-control that follow your child into kindergarten and every
        classroom after it.
      </p>
    </div>
  </section>

  <section class="py-20 md:py-20">
    <div class="mx-auto max-w-6xl px-6 md:px-5">
      <SectionHead kicker="What a Class Looks Like">
        <Fragment slot="heading">Fun on the surface. <em>Serious underneath.</em></Fragment>
      </SectionHead>
      <div class="grid gap-8 md:grid-cols-3 md:gap-6">
        {classSteps.map((s, i) => (
          <NumberedCard image={s.image} alt={s.alt} position={s.position} number={i + 1} title={s.title} description={s.description} />
        ))}
      </div>
    </div>
  </section>

  <section class="bg-indigo-deep py-20 text-white md:py-20">
    <div class="mx-auto max-w-6xl px-6 md:px-5">
      <div class="mb-11">
        <div class="mb-3 text-xs font-bold tracking-[0.2em] text-gold-soft uppercase">What Parents Notice</div>
        <h2 class="max-w-[22ch] text-[clamp(1.9rem,3.6vw,2.7rem)] text-white">
          The change shows up <span class="text-gold-soft">at home, too.</span>
        </h2>
      </div>
      <div class="grid gap-8 sm:grid-cols-2 md:gap-6">
        {results.map((r) => (
          <div class="border-t-2 border-gold pt-4">
            <h3 class="mb-1.5 font-display text-lg font-semibold text-white">{r.title}</h3>
            <p class="text-[0.94rem] text-[#A3A2B6]">{r.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 md:py-20">
    <div class="mx-auto max-w-6xl px-6 md:px-5">
      <PhotoStrip
        caption="A typical Little Warriors class"
        ratioClass="aspect-square"
        images={[
          { src: earningAStripe, alt: "Young karate student receiving a stripe on their belt from an instructor", position: "50% 40%" },
          { src: bowingIn, alt: "Little Warriors preschool karate students bowing in at the start of class", position: "50% 35%" },
          { src: parentWatchingFromLobby, alt: "Parent watching a Little Warriors class from the lobby", position: "50% 40%" },
        ]}
      />
    </div>
  </section>

  <section class="pb-16 md:pb-20">
    <div class="mx-auto max-w-6xl px-6 md:px-5">
      <ReassuranceBox heading={`"Is my child ready? They're a handful."`}>
        <p>
          We hear this constantly, and here is the honest answer: the wilder ones are often the
          ones who get the most out of it. Little Warriors was built for exactly this age, with
          all its energy and all its wiggles. We are not expecting a still, quiet child to walk
          through the door. We are expecting a three year old to be a three year old.
        </p>
        <p>
          Our instructors have spent years teaching students this age. Nothing your child does on
          the mat will surprise us, and we will meet them right where they are.
        </p>
      </ReassuranceBox>
    </div>
  </section>

  <Tuition program="littleWarriors" />

  <div class="pb-12">
    <FAQGroup id="little-warriors-faq" title="Preschool karate questions" tag="For Parents" items={faqItems} />
  </div>

  <CTASection ctaLabel={offer.cta} ctaHref="/booking?program=littleWarriors">
    <Fragment slot="heading">See it for yourself. <em>The {offer.first} is free.</em></Fragment>
    <Fragment slot="subtext">Bring your little one in for {offer.visit}. No cost, no commitment.</Fragment>
  </CTASection>
</BaseLayout>
