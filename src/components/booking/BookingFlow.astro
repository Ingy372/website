---
// OUT OF DATE, NOT IN USE. This custom booking form has been superseded by the
// DojoForge hosted widget (DojoForgeWidget.astro), which is the live booking
// method on /booking. No page imports this component.
// It still only allows Monday/Tuesday trials; Hannah's availability is now
// Monday through Thursday. If this form is ever brought back, update
// isSelectable(), weekdayKeyByIndex, the helper text below, and
// bookableClasses in src/data/schedule.ts before using it.
import { bookableClasses } from "../../data/schedule";
---

<div class="mx-auto max-w-xl">
  <!-- Step 1: calendar -->
  <div class="rounded border border-paper-warm bg-white p-5 sm:p-6">
    <div class="mb-1 text-xs font-bold tracking-[0.15em] text-gold-deep uppercase">Step 1</div>
    <h2 class="mb-4 font-display text-xl font-black text-indigo">Choose a date</h2>
    <p class="mb-4 text-sm text-mist">
      Hannah, our Office Manager, is in the office Mondays and Tuesdays to walk you through
      enrollment in person. That's when trial visits are scheduled.
    </p>

    <div class="mb-3 flex items-center justify-between">
      <button
        type="button"
        id="cal-prev"
        aria-label="Previous month"
        class="flex h-11 w-11 items-center justify-center rounded border border-paper-warm text-lg text-indigo hover:border-gold"
      >
        &#8249;
      </button>
      <div id="cal-month-label" class="font-display text-lg font-bold text-indigo"></div>
      <button
        type="button"
        id="cal-next"
        aria-label="Next month"
        class="flex h-11 w-11 items-center justify-center rounded border border-paper-warm text-lg text-indigo hover:border-gold"
      >
        &#8250;
      </button>
    </div>

    <div class="mb-1.5 grid grid-cols-7 gap-1 text-center text-[0.7rem] font-bold tracking-[0.05em] text-mist uppercase">
      <span>Su</span><span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span><span>Sa</span>
    </div>
    <div id="cal-grid" class="grid grid-cols-7 gap-1"></div>

    <div class="mt-4 flex flex-wrap gap-4 text-xs text-mist">
      <span class="flex items-center gap-1.5"><span class="h-3 w-3 rounded-sm bg-gold" aria-hidden="true"></span> Available</span>
      <span class="flex items-center gap-1.5"><span class="h-3 w-3 rounded-sm bg-paper-warm" aria-hidden="true"></span> Unavailable</span>
    </div>
  </div>

  <!-- Step 2: class selection -->
  <div id="booking-step-class" class="mt-5 hidden rounded border border-paper-warm bg-white p-5 sm:p-6">
    <div class="mb-1 text-xs font-bold tracking-[0.15em] text-gold-deep uppercase">Step 2</div>
    <h2 class="mb-4 font-display text-xl font-black text-indigo">Choose a class</h2>
    <div id="class-options" class="flex flex-col gap-2.5"></div>
  </div>

  <!-- Step 3: form -->
  <div id="booking-step-form" class="mt-5 hidden rounded border border-paper-warm bg-white p-5 sm:p-6">
    <div class="mb-1 text-xs font-bold tracking-[0.15em] text-gold-deep uppercase">Step 3</div>
    <h2 class="mb-1 font-display text-xl font-black text-indigo">Reserve your spot</h2>
    <div id="selected-summary" class="mb-4 rounded bg-paper-warm px-4 py-3 text-sm font-semibold text-indigo"></div>

    <form id="booking-form" class="flex flex-col gap-4">
      <div class="grid gap-4 sm:grid-cols-2">
        <label class="block">
          <span class="mb-1.5 block text-xs font-semibold tracking-[0.05em] text-mist uppercase">Parent / guardian name</span>
          <input required name="parentName" type="text" class="w-full rounded border border-paper-warm bg-paper px-3.5 py-3 text-[0.95rem] focus:border-transparent focus:outline focus:outline-2 focus:outline-gold" />
        </label>
        <label class="block">
          <span class="mb-1.5 block text-xs font-semibold tracking-[0.05em] text-mist uppercase">Phone</span>
          <input required name="phone" type="tel" placeholder="(910) 000-0000" class="w-full rounded border border-paper-warm bg-paper px-3.5 py-3 text-[0.95rem] focus:border-transparent focus:outline focus:outline-2 focus:outline-gold" />
        </label>
      </div>
      <label class="block">
        <span class="mb-1.5 block text-xs font-semibold tracking-[0.05em] text-mist uppercase">Email</span>
        <input required name="email" type="email" class="w-full rounded border border-paper-warm bg-paper px-3.5 py-3 text-[0.95rem] focus:border-transparent focus:outline focus:outline-2 focus:outline-gold" />
      </label>
      <div class="grid gap-4 sm:grid-cols-2">
        <label class="block">
          <span class="mb-1.5 block text-xs font-semibold tracking-[0.05em] text-mist uppercase">Student name</span>
          <input required name="studentName" type="text" class="w-full rounded border border-paper-warm bg-paper px-3.5 py-3 text-[0.95rem] focus:border-transparent focus:outline focus:outline-2 focus:outline-gold" />
        </label>
        <label class="block">
          <span class="mb-1.5 block text-xs font-semibold tracking-[0.05em] text-mist uppercase">Student age</span>
          <input required name="studentAge" type="text" inputmode="numeric" class="w-full rounded border border-paper-warm bg-paper px-3.5 py-3 text-[0.95rem] focus:border-transparent focus:outline focus:outline-2 focus:outline-gold" />
        </label>
      </div>

      <button
        type="submit"
        id="booking-submit"
        class="mt-1 rounded bg-indigo px-5 py-4 text-base font-bold text-white transition-colors hover:bg-gold hover:text-indigo-deep disabled:opacity-60"
      >
        Confirm My Spot
      </button>
      <p id="booking-error" class="hidden text-sm font-semibold text-[#8B3A2F]">
        Something went wrong sending your request. Please call us instead and we'll get you booked right away.
      </p>
    </form>
  </div>

  <!-- Step 4: confirmation -->
  <div id="booking-step-confirm" class="mt-5 hidden rounded border border-gold bg-white p-6 text-center sm:p-8">
    <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-gold text-2xl text-indigo-deep" aria-hidden="true">&#10003;</div>
    <h2 class="mb-2 font-display text-2xl font-black text-indigo">You're on the list</h2>
    <p id="confirm-summary" class="mb-2 font-semibold text-indigo"></p>
    <p class="text-sm text-mist">
      We will text you a confirmation and what to bring. Wear comfortable clothes, bring water,
      and arrive about ten minutes early so we can get you settled. No equipment or uniform needed
      for your first class.
    </p>
  </div>
</div>

<script define:vars={{ bookableClasses }} is:inline>
  const monthLabel = document.getElementById("cal-month-label");
  const grid = document.getElementById("cal-grid");
  const prevBtn = document.getElementById("cal-prev");
  const nextBtn = document.getElementById("cal-next");
  const stepClass = document.getElementById("booking-step-class");
  const classOptions = document.getElementById("class-options");
  const stepForm = document.getElementById("booking-step-form");
  const selectedSummary = document.getElementById("selected-summary");
  const stepConfirm = document.getElementById("booking-step-confirm");
  const confirmSummary = document.getElementById("confirm-summary");
  const form = document.getElementById("booking-form");
  const submitBtn = document.getElementById("booking-submit");
  const errorEl = document.getElementById("booking-error");

  const today = new Date();
  today.setHours(0, 0, 0, 0);

  let viewYear = today.getFullYear();
  let viewMonth = today.getMonth();
  let selectedDate = null;
  let selectedClass = null;

  const monthNames = ["January","February","March","April","May","June","July","August","September","October","November","December"];
  const weekdayKeyByIndex = { 1: "monday", 2: "tuesday" };

  function isSelectable(date) {
    if (date < today) return false;
    const day = date.getDay();
    return day === 1 || day === 2;
  }

  function renderCalendar() {
    monthLabel.textContent = `${monthNames[viewMonth]} ${viewYear}`;
    grid.innerHTML = "";

    const firstOfMonth = new Date(viewYear, viewMonth, 1);
    const startOffset = firstOfMonth.getDay();
    const daysInMonth = new Date(viewYear, viewMonth + 1, 0).getDate();

    for (let i = 0; i < startOffset; i++) {
      const blank = document.createElement("div");
      grid.appendChild(blank);
    }

    for (let day = 1; day <= daysInMonth; day++) {
      const date = new Date(viewYear, viewMonth, day);
      const btn = document.createElement("button");
      btn.type = "button";
      btn.textContent = String(day);
      btn.className = "flex h-11 w-full items-center justify-center rounded text-sm font-semibold";

      const selectable = isSelectable(date);
      const isSelected = selectedDate && date.getTime() === selectedDate.getTime();

      if (isSelected) {
        btn.className += " bg-indigo text-white";
      } else if (selectable) {
        btn.className += " bg-gold/15 text-indigo hover:bg-gold hover:text-indigo-deep";
      } else {
        btn.className += " bg-paper-warm text-mist/50 cursor-not-allowed";
        btn.disabled = true;
      }

      if (selectable) {
        btn.addEventListener("click", () => {
          selectedDate = date;
          selectedClass = null;
          renderCalendar();
          renderClassOptions();
          stepForm.classList.add("hidden");
          stepConfirm.classList.add("hidden");
        });
      }

      grid.appendChild(btn);
    }
  }

  function formatFullDate(date) {
    return date.toLocaleDateString("en-US", { weekday: "long", month: "long", day: "numeric", year: "numeric" });
  }

  function renderClassOptions() {
    if (!selectedDate) return;
    const weekdayKey = weekdayKeyByIndex[selectedDate.getDay()];
    const classes = bookableClasses[weekdayKey] || [];

    classOptions.innerHTML = "";
    classes.forEach((cls) => {
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = "flex min-h-[44px] items-center justify-between rounded border border-paper-warm px-4 py-3 text-left hover:border-gold";
      btn.innerHTML = `<span><span class="block font-semibold text-indigo">${cls.name}</span><span class="block text-sm text-mist">${cls.ageLabel} &middot; ${cls.time}</span></span>`;
      btn.addEventListener("click", () => {
        selectedClass = cls;
        [...classOptions.children].forEach((c) => c.classList.remove("border-gold", "bg-gold/10"));
        btn.classList.add("border-gold", "bg-gold/10");
        selectedSummary.textContent = `${cls.name} · ${cls.ageLabel} · ${formatFullDate(selectedDate)}, ${cls.time}`;
        stepForm.classList.remove("hidden");
        stepConfirm.classList.add("hidden");
        stepForm.scrollIntoView({ behavior: "smooth", block: "nearest" });
      });
      classOptions.appendChild(btn);
    });

    stepClass.classList.remove("hidden");
    stepClass.scrollIntoView({ behavior: "smooth", block: "nearest" });
  }

  prevBtn.addEventListener("click", () => {
    viewMonth -= 1;
    if (viewMonth < 0) { viewMonth = 11; viewYear -= 1; }
    renderCalendar();
  });
  nextBtn.addEventListener("click", () => {
    viewMonth += 1;
    if (viewMonth > 11) { viewMonth = 0; viewYear += 1; }
    renderCalendar();
  });

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!selectedDate || !selectedClass) return;

    errorEl.classList.add("hidden");
    submitBtn.disabled = true;
    submitBtn.textContent = "Sending...";

    const data = new FormData(form);
    const payload = {
      parentName: data.get("parentName"),
      phone: data.get("phone"),
      email: data.get("email"),
      studentName: data.get("studentName"),
      studentAge: data.get("studentAge"),
      classId: selectedClass.id,
      className: selectedClass.name,
      ageLabel: selectedClass.ageLabel,
      classTime: selectedClass.time,
      date: selectedDate.toISOString().slice(0, 10),
    };

    try {
      const res = await fetch("/api/book", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      if (!res.ok) throw new Error("Request failed");

      stepClass.classList.add("hidden");
      stepForm.classList.add("hidden");
      confirmSummary.textContent = `${selectedClass.name} · ${formatFullDate(selectedDate)} at ${selectedClass.time}`;
      stepConfirm.classList.remove("hidden");
      stepConfirm.scrollIntoView({ behavior: "smooth", block: "nearest" });
    } catch (err) {
      errorEl.classList.remove("hidden");
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = "Confirm My Spot";
    }
  });

  renderCalendar();
</script>
