---
interface Props {
  kicker: string;
  center?: boolean;
  hasSubtext?: boolean;
  dark?: boolean;
  class?: string;
}
const { kicker, center = false, hasSubtext = false, dark = false, class: className = "" } = Astro.props;
---

<div class={`mb-11 ${center ? "mx-auto max-w-2xl text-center" : ""} ${className}`}>
  <div class={`mb-3 text-xs font-bold tracking-[0.2em] uppercase ${dark ? "text-gold-soft" : "text-gold-deep"}`}>{kicker}</div>
  <h2 class={`text-[clamp(1.9rem,3.6vw,2.7rem)] [&_em]:font-normal [&_em]:not-italic ${dark ? "text-white [&_em]:text-gold-soft" : "text-indigo [&_em]:text-gold-deep"} ${center ? "" : "max-w-[22ch]"}`}>
    <slot name="heading" />
  </h2>
  {hasSubtext && (
    <p class={`mt-3.5 ${dark ? "text-[#A5A4B8]" : "text-mist"} ${center ? "mx-auto" : "max-w-[52ch]"}`}>
      <slot name="subtext" />
    </p>
  )}
</div>
