---
import BaseLayout from "../layouts/BaseLayout.astro";
import SimpleHero from "../components/hero/SimpleHero.astro";
import WeeklyTimetable from "../components/schedule/WeeklyTimetable.astro";
import CTASection from "../components/sections/CTASection.astro";
import { offer } from "../data/school";
import { business, cityState } from "../data/business";
import { closedDays, weeklySchedule, upcomingClosures, closureDatesText, blackBeltTrainingTime, openTrainingTime, programs, ageRange, beginnerTimes } from "../data/schedule";

// "Which class is right for my child?" Wording comes from the program pages.
const guide = [
  { id: "littleWarriors" as const, title: "Little Warriors", text: "Preschool karate. Listening, focus, and confidence, taught through games and real technique." },
  { id: "kids" as const, title: "Kids Karate", text: "Karate for kids that builds confidence, focus, respect, and real self-defense." },
  { id: "teensAdults" as const, title: "Teens & Adults", text: "Fitness and practical self-defense, no experience needed. Parents and children 13 and up can train side by side." },
].map((g) => ({ ...g, ages: ageRange(programs[g.id]), href: programs[g.id].href, times: beginnerTimes(g.id) }));

// Closed days the grid doesn't already show as a "Closed" card.
const notInGrid = closedDays.days.filter((d) => !weeklySchedule.some((w) => w.day === d));
---

<BaseLayout
  title="Class Schedule"
  seoTitle="Martial Arts Class Schedule | Raeford, NC | Action Zone CMA"
  description={`The full weekly class schedule at ${business.displayName} in ${cityState}. Monday through Thursday, plus Saturday open training.`}
  path="/schedule"
>
  <SimpleHero eyebrow="Class Schedule">
    <Fragment slot="heading">Find a class that <em>fits your week.</em></Fragment>
    <Fragment slot="subtext">
      Every class we teach, Monday through Saturday, at a glance.
    </Fragment>
  </SimpleHero>

  <section class="py-20 md:py-16">
    <div class="mx-auto max-w-6xl px-6 md:px-5">
      {upcomingClosures.length > 0 && (
        <div class="mb-8 rounded border-l-4 border-[#8B3A2F] bg-[#8B3A2F]/[0.07] p-5" role="note">
          <h2 class="mb-2 font-display text-lg font-bold text-indigo">Upcoming closures</h2>
          <ul class="flex flex-col gap-1 text-sm text-[#40403A]">
            {upcomingClosures.map((c) => (
              <li><strong class="font-semibold">{closureDatesText(c)}</strong>: {c.name}. No classes.</li>
            ))}
          </ul>
        </div>
      )}

      <WeeklyTimetable />

      <p class="mt-6 text-center text-sm text-mist">Closed {notInGrid.join(" and ")}.</p>

      <div class="mx-auto mt-10 max-w-3xl rounded border-t-4 border-gold bg-white p-6 shadow-sm" role="note">
        <h2 class="mb-4 font-display text-xl font-bold text-indigo">Saturdays</h2>
        <dl class="flex flex-col gap-3 text-[#40403A]">
          <div class="flex flex-col gap-0.5 sm:flex-row sm:gap-4">
            <dt class="font-semibold text-indigo sm:w-44 sm:shrink-0">{blackBeltTrainingTime}</dt>
            <dd>Black belt training only.</dd>
          </div>
          <div class="flex flex-col gap-0.5 sm:flex-row sm:gap-4">
            <dt class="font-semibold text-indigo sm:w-44 sm:shrink-0">{openTrainingTime}</dt>
            <dd>Open training and make-up classes for every student, any age or rank.</dd>
          </div>
          <div class="flex flex-col gap-0.5 sm:flex-row sm:gap-4">
            <dt class="font-semibold text-indigo sm:w-44 sm:shrink-0">Belt testing</dt>
            <dd>Held on select Saturdays, four times a year.</dd>
          </div>
        </dl>
      </div>

      <div class="mt-14">
        <h2 class="mb-2 text-center text-[clamp(1.7rem,3.2vw,2.4rem)] text-indigo">Which class is right for my child?</h2>
        <p class="mb-8 text-center text-[#40403A]">Start with the class for your child's age. Beginner times are below.</p>
        <div class="grid gap-6 md:grid-cols-3">
          {guide.map((g) => (
            <div class="flex flex-col rounded border-t-4 border-gold bg-white p-6 shadow-sm">
              <div class="text-xs font-bold tracking-[0.14em] text-gold-deep uppercase">Ages {g.ages}</div>
              <h3 class="mt-1 mb-2 font-display text-xl font-bold text-indigo">{g.title}</h3>
              <p class="mb-3 text-[#40403A]">{g.text}</p>
              <ul class="mb-4 flex flex-col gap-1 text-sm text-ink">
                {g.times.map((t) => <li><span class="font-semibold">{t.days}</span> · {t.time}</li>)}
              </ul>
              <a href={g.href} class="mt-auto text-sm font-bold text-indigo underline hover:text-gold">More about {g.title}</a>
            </div>
          ))}
        </div>
      </div>

      <div class="mx-auto mt-10 max-w-2xl rounded border border-paper-warm bg-paper-warm p-6 text-center">
        <h2 class="mb-2 font-display text-lg font-bold text-indigo">Where do I start?</h2>
        <p class="mb-2 text-sm text-[#3E3E38]">
          Basic Club and Little Warriors are the classes open for booking. Black Belt Club and
          Masters Club are joined by invitation from your instructor.
        </p>
        <p class="text-sm text-[#3E3E38]">
          Whether you are a beginner or have been training for years, everyone has a place here.
          No uniform or equipment required. Wear something comfortable, bring water, and show up a
          few minutes early. We look forward to seeing you on the mat.
        </p>
      </div>

      <div class="mt-8 text-center">
        <a
          href="/booking"
          class="inline-flex items-center gap-2 font-bold text-indigo hover:text-gold"
        >
          New to Action Zone? {offer.cta} <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <CTASection ctaLabel={offer.cta} ctaHref="/booking">
    <Fragment slot="heading">See a class that works? <em>Come try it free.</em></Fragment>
    <Fragment slot="subtext">
      Book any beginner class above and your {offer.first} is on us. No uniform, no equipment, no
      commitment.
    </Fragment>
  </CTASection>
</BaseLayout>
