---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProgramHero from "../components/hero/ProgramHero.astro";
import ProseSection from "../components/sections/ProseSection.astro";
import WorthTheDrive from "../components/sections/WorthTheDrive.astro";
import AreaDirections from "../components/sections/AreaDirections.astro";
import PhotoStrip from "../components/sections/PhotoStrip.astro";
import FAQGroup from "../components/sections/FAQGroup.astro";
import ReviewQuote from "../components/sections/ReviewQuote.astro";
import CTASection from "../components/sections/CTASection.astro";
import { offer, tuitionFaqItem } from "../data/school";
import { programs, ageLabel, beginnerTimes, openTrainingTime } from "../data/schedule";

import heroImage from "../images/teens-adults/teen-class.jpg";
import drillingTechnique from "../images/teens-adults/drilling-technique.jpg";
import throwingWall from "../images/kids/throwing-wall.jpg";

const times = (id: "kids" | "teensAdults") => beginnerTimes(id).map((t) => `${t.days}, ${t.time}`).join(" · ");

const faqItems = [
  {
    question: "Where is the dojo from Rockfish and Jack Britt?",
    answer: [
      "We are at 6105 Philippi Church Rd in Raeford, close to Rockfish. Use the directions button on this page for turn-by-turn directions from your neighborhood.",
    ],
  },
  {
    question: "Is there a class for high schoolers?",
    answer: [
      `Yes. Teens ${programs.teensAdults.minAge} and up train in our teen and adult class. Beginner classes run ${times("teensAdults")}.`,
    ],
  },
  {
    question: "Can my kids and I train at the same time?",
    answer: [
      "Children 13 and up can train beside a parent in the teen and adult class. Younger kids have their own classes, and on Saturdays the whole dojo trains together.",
    ],
  },
  tuitionFaqItem(),
];
---

<BaseLayout
  title="Martial Arts Near Rockfish & Jack Britt"
  fullTitle="Martial Arts Near Rockfish & Jack Britt | Action Zone CMA"
  crumb="Rockfish & Jack Britt"
  description={`Karate, jiu jitsu, and self-defense near Rockfish and Jack Britt for kids, teens, and adults. A family-run Raeford dojo. Start with a ${offer.noun}.`}
  path="/rockfish-jack-britt"
  ogImage={heroImage}
  ogImageAlt="Teens training alongside adults in a martial arts class"
  faq={faqItems}
>
  <ProgramHero
    badge="Serving Rockfish & Jack Britt"
    h1="Martial Arts Near Rockfish & Jack Britt"
    image={heroImage}
    alt="Teenagers training alongside adults in a martial arts class near Rockfish, NC"
    ctaLabel={offer.cta}
    ctaHref="/booking"
  >
    <Fragment slot="heading">Martial arts <em>close to home.</em></Fragment>
    <Fragment slot="subtext">
      Karate, jiu jitsu, and self-defense classes for kids, teens, and adults, at our family-run
      dojo in Raeford, close to Rockfish and Jack Britt.
    </Fragment>
  </ProgramHero>

  <ProseSection kicker="Close to Home" heading="Martial arts without a trip across town.">
    <p>
      If you live around Rockfish or the Jack Britt area, you do not have to fight Fayetteville
      traffic to get your kids to a good martial arts class. Our dojo sits out in Raeford on two
      acres, with a playground right outside.
    </p>
    <p>
      Classes run Monday through Thursday afternoons and evenings, so they fit after school and
      after work. Kids beginner classes are {times("kids")}. Saturday open training,
      {" "}{openTrainingTime}, is open to every student.
    </p>
  </ProseSection>

  <ProseSection warm kicker="Teens & Adults" heading="A better place for a teenager to be.">
    <p>
      Our teens train right alongside the adults. They build real fitness and practical
      self-defense, and they spend their time around grown-ups who model discipline, respect, and
      hard work. For a high schooler, that is a rare and valuable room to stand in.
    </p>
    <p>
      Adults get a workout that never feels like a treadmill, stress gone by the end of class,
      and <a href="/self-defense">self-defense</a> they would actually use. No experience needed.
      See <a href="/teens-adults">teen and adult classes</a>.
    </p>
  </ProseSection>

  <WorthTheDrive heading="What's waiting for you in Raeford" />

  <section class="py-16 md:py-18">
    <div class="mx-auto grid max-w-6xl gap-8 px-6 md:grid-cols-2 md:px-5">
      <AreaDirections from="Rockfish" />
      <PhotoStrip
        ratioClass="aspect-square"
        images={[
          { src: drillingTechnique, alt: "Students drilling kicks into pads held by partners" },
          { src: throwingWall, alt: "Kids practicing at the throwing wall", position: "50% 30%" },
        ]}
      />
    </div>
  </section>

  <ProseSection heading="For the younger ones">
    <p>
      <a href="/little-warriors">Little Warriors</a> is preschool karate for ages 3 to 5, built
      around listening, focus, and confidence. <a href="/kids">Kids karate</a>
      ({ageLabel(programs.kids)}) builds respect, focus, and real self-defense, with a belt path
      kids can see. Parents are always welcome to watch.
    </p>
  </ProseSection>

  <ReviewQuote id="rachel-b" />

  <div class="py-12">
    <FAQGroup id="rockfish-faq" title="Questions from Rockfish and Jack Britt families" tag="Neighbors" items={faqItems} />
  </div>

  <CTASection ctaLabel={offer.cta} ctaHref="/booking">
    <Fragment slot="heading">Come see us. <em>The first week is free.</em></Fragment>
    <Fragment slot="subtext">Try {offer.visit}. No cost, no commitment, no pressure.</Fragment>
  </CTASection>
</BaseLayout>
