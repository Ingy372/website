---
import "../styles/global.css";
import { Font } from "astro:assets";
import Analytics from "../components/Analytics.astro";
import FirstTouch from "../components/FirstTouch.astro";
import BeltBar from "../components/BeltBar.astro";
import Nav from "../components/nav/Nav.astro";
import MobileCallBar from "../components/nav/MobileCallBar.astro";
import Footer from "../components/Footer.astro";
import { business } from "../data/business";
import { siteVerification } from "../data/school";
import { openingHoursSpecification } from "../data/schedule";

interface Props {
  title: string;
  description: string;
  path: string;
  /** Keep this page out of search results (404, utility pages). Drops the canonical. */
  noindex?: boolean;
}

const { title, description, path, noindex = false } = Astro.props;
const canonicalURL = new URL(path, Astro.site);
const fullTitle = `${title} | ${business.displayName}`;
// 1200x630 share image, generated by scripts/build-social-images.mjs.
const ogImage = new URL("/og-image.jpg", Astro.site).href;

// No aggregateRating here on purpose: Google ignores self-published ratings
// for a business's own LocalBusiness markup, and an unverified count risks a
// manual action. The rating shows in page copy (from reviews.json) instead.
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "SportsActivityLocation",
  name: business.displayName,
  image: ogImage,
  telephone: business.phone,
  email: business.email,
  address: {
    "@type": "PostalAddress",
    streetAddress: business.address.street,
    addressLocality: business.address.city,
    addressRegion: business.address.state,
    postalCode: business.address.zip,
    addressCountry: "US",
  },
  openingHoursSpecification,
  sameAs: [business.socials.facebook, business.socials.instagram],
  url: Astro.site,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Analytics />
    <FirstTouch />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalURL} />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={business.displayName} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Students in white uniforms practicing a punch together on the dojo mat" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {Object.entries(siteVerification).map(([name, content]) => content && <meta name={name} content={content} />)}

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Self-hosted via the Astro Fonts API (astro.config.mjs). Each family is a
         single latin variable-font file covering every weight, and both are used
         above the fold (hero paragraph = LCP, hero headline), so preload both. -->
    <Font cssVariable="--font-archivo" preload />
    <Font cssVariable="--font-fraunces" preload />

    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} is:inline />
    <slot name="head" />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded focus:bg-white focus:px-4 focus:py-2 focus:text-indigo"
    >
      Skip to content
    </a>
    <BeltBar />
    <Nav />
    <main id="main" class="pb-16 lg:pb-0">
      <slot />
    </main>
    <Footer />
    <MobileCallBar />
  </body>
</html>
