---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProgramHero from "../components/hero/ProgramHero.astro";
import ProseSection from "../components/sections/ProseSection.astro";
import PhotoStrip from "../components/sections/PhotoStrip.astro";
import ProgramCard from "../components/cards/ProgramCard.astro";
import SectionHead from "../components/sections/SectionHead.astro";
import FAQGroup from "../components/sections/FAQGroup.astro";
import ReviewQuote from "../components/sections/ReviewQuote.astro";
import CTASection from "../components/sections/CTASection.astro";
import { offer, tuitionFaqItem } from "../data/school";
import { founded } from "../data/business";
import { programs, ageLabel, programClassLength } from "../data/schedule";

import heroImage from "../images/kids/belt-test.jpg";
import littleWarriorsClass from "../images/homepage/little-warriors-class.jpg";
import kidsClass from "../images/homepage/kids-class.jpg";
import teensAdultsClass from "../images/homepage/teens-adults-class.jpg";
import drillingTechnique from "../images/teens-adults/drilling-technique.jpg";
import beltsAfterTest from "../images/our-story/belts-after-test.jpg";

const faqItems = [
  {
    question: "What age can you start karate?",
    answer: [
      `Children can start at ${programs.littleWarriors.minAge} in Little Warriors, our preschool karate class. Kids ${programs.kids.minAge} to ${programs.kids.maxAge} train in our kids classes, and teens and adults train together from ${programs.teensAdults.minAge} up. It is never too late to start.`,
    ],
  },
  {
    question: "How long is a karate class?",
    answer: [`Little Warriors classes run ${programClassLength("littleWarriors")}. Kids, teen, and adult classes run ${programClassLength("kids")}.`],
  },
  {
    question: "What style of karate do you teach?",
    answer: [
      "Karate is the foundation of Yeshua's Ryu, the Christian martial arts system our founder built. Students also learn Jiu Jitsu, Kung Fu, Tae Kwon Do, and traditional Japanese weapons, so they get a complete martial arts education instead of a single style.",
    ],
  },
  {
    question: "Do you compete in karate tournaments?",
    answer: ["No. We are a non-competitive school. We keep no trophy case. Students test for every belt in front of the class, and they earn each one."],
  },
  tuitionFaqItem(),
];
---

<BaseLayout
  title="Karate Classes in Raeford, NC"
  fullTitle="Karate Classes in Raeford, NC for Kids & Adults"
  crumb="Karate"
  description={`Karate classes for kids, teens, and adults, ages 3 and up, since ${founded.year}. Serving Raeford, Fayetteville, and Hope Mills. Start with a ${offer.noun}.`}
  path="/karate"
  ogImage={heroImage}
  ogImageAlt="Young karate student performing a belt test in front of the class"
  faq={faqItems}
>
  <ProgramHero
    badge={`Karate · Ages ${programs.littleWarriors.minAge}+`}
    h1="Karate Classes in Raeford, NC for Kids & Adults"
    image={heroImage}
    alt="Young karate student performing a belt test in front of the class in Raeford, NC"
    ctaLabel={offer.cta}
    ctaHref="/booking"
  >
    <Fragment slot="heading">Every belt is <em>earned on this mat.</em></Fragment>
    <Fragment slot="subtext">
      Traditional karate classes for preschoolers, kids, teens, and adults, taught by one family
      in one building for {founded.yearsWords} years.
    </Fragment>
  </ProgramHero>

  <ProseSection kicker="Why Karate" heading="Looking for karate near you?">
    <p>
      Karate is a striking art: punches, kicks, blocks, and stances, practiced until they are
      second nature. Done well, it builds far more than technique. Students learn to focus, to
      control their bodies and their tempers, and to keep going when something is hard.
    </p>
    <p>
      At Action Zone CMA, karate is the backbone of Yeshua's Ryu, the Christian martial arts
      system our founder built. Every class pairs real technique with character: respect,
      discipline, perseverance, and humility. We are a non-competitive school, so nobody is
      training for a trophy. They are training to become someone.
    </p>
    <p>
      Our dojo is in Raeford, and families come to us from Fayetteville, Hope Mills, Rockfish,
      Jack Britt, and Fort Bragg. It is a 2,400 square foot building our founder built by hand on
      two acres, with a playground outside for siblings.
    </p>
  </ProseSection>

  <section class="bg-paper-warm py-16 md:py-18">
    <div class="mx-auto max-w-6xl px-6 md:px-5">
      <SectionHead kicker="Karate Classes by Age">
        <Fragment slot="heading">A karate class for every age.</Fragment>
      </SectionHead>
      <div class="grid gap-8 md:grid-cols-3 md:gap-6">
        <ProgramCard
          image={littleWarriorsClass}
          alt="Little Warriors preschool karate students lined up in uniform"
          ageLabel={ageLabel(programs.littleWarriors)}
          program="littleWarriors"
          title="Little Warriors"
          tag="Preschool Karate"
          description="Karate for 3, 4, and 5 year olds. Listening, focus, and confidence, taught through games and real technique."
          href="/little-warriors"
        />
        <ProgramCard
          image={kidsClass}
          alt="Kids karate class training together on the dojo mat"
          position="50% 30%"
          ageLabel={ageLabel(programs.kids)}
          program="kids"
          title="Kids Karate"
          tag="Ages 6 to 12"
          description="High-energy karate classes for kids that build confidence, focus, respect, and real self-defense."
          href="/kids"
        />
        <ProgramCard
          image={teensAdultsClass}
          alt="Teens and adults training together in a karate and self-defense class"
          position="50% 28%"
          ageLabel={ageLabel(programs.teensAdults)}
          program="teensAdults"
          title="Teen & Adult Karate"
          tag="Fitness & Self-Defense"
          description="Adult karate for fitness, stress relief, and self-defense. No experience needed."
          href="/teens-adults"
        />
      </div>
    </div>
  </section>

  <ProseSection kicker="The Belt Path" heading="A clear goal, honestly earned.">
    <p>
      Students work through a belt system from white to black, testing for each rank in front of
      the room with family watching. Nothing is handed out. That is exactly why a new belt means
      so much, and why kids who earn one walk a little taller at school the next day.
    </p>
    <p>
      Classes follow a steady rhythm: a warm-up that gets the body moving, focused technique
      broken into clear steps, partner drills at the right level for each student, and time to
      put it all together. Beginners never spar. We teach control long before we teach contact.
    </p>
  </ProseSection>

  <section class="pb-16 md:pb-18">
    <div class="mx-auto max-w-6xl px-6 md:px-5">
      <PhotoStrip
        ratioClass="aspect-[4/3]"
        images={[
          { src: drillingTechnique, alt: "Karate students drilling kicks into pads held by partners" },
          { src: beltsAfterTest, alt: "Karate students with newly earned belts tied on after a rank test" },
        ]}
      />
    </div>
  </section>

  <ReviewQuote id="sarah-g" />

  <div class="py-12">
    <FAQGroup id="karate-faq" title="Karate questions" tag="Before You Start" items={faqItems} />
  </div>

  <CTASection ctaLabel={offer.cta} ctaHref="/booking">
    <Fragment slot="heading">Try a week of karate. <em>It's free.</em></Fragment>
    <Fragment slot="subtext">Come in for {offer.visit}. No uniform, no experience, no pressure.</Fragment>
  </CTASection>
</BaseLayout>
