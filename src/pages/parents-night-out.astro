---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProgramHero from "../components/hero/ProgramHero.astro";
import SectionHead from "../components/sections/SectionHead.astro";
import CTASection from "../components/sections/CTASection.astro";
import { business, cityState } from "../data/business";
import FactList from "../components/sections/FactList.astro";
import { nextParentsNightOut, upcoming, eventWhenText, eventJsonLd } from "../data/events";
import { parentsNightOutFacts } from "../data/parties";

import partyPhoto from "../images/parents-night-out/party.jpg";

const eventSchema = eventJsonLd("parents-night-out", new URL("/parents-night-out", Astro.site).href);
const upcomingDates = upcoming("parents-night-out");
---

<BaseLayout
  title="Parents Night Out"
  description={`Drop the kids off for a themed evening of games and martial arts at ${business.displayName} in ${cityState}, and enjoy a few hours to yourselves.`}
  path="/parents-night-out"
>
  {eventSchema.length > 0 && (
    <script type="application/ld+json" slot="head" set:html={JSON.stringify(eventSchema)} is:inline />
  )}
  <ProgramHero badge="Parents Night Out" image={partyPhoto} alt="Kids in pajamas at a themed Parents Night Out around the Christmas tree" ctaLabel="Ask About the Next Date" ctaHref="/contact?interest=parents-night-out">
    <Fragment slot="heading">Drop the kids. <em>Enjoy the night.</em></Fragment>
    <Fragment slot="subtext">
      A themed evening of games, martial arts, and fun your kids won't stop talking about. Nerf
      Night, Superhero Dress-Up, Water Wars, and more. You get a few hours to yourself, they get a
      night to remember.
    </Fragment>
    {nextParentsNightOut && (
      <Fragment slot="note">
        Next date: {eventWhenText(nextParentsNightOut)}{nextParentsNightOut.theme && ` · ${nextParentsNightOut.theme}`}
      </Fragment>
    )}
  </ProgramHero>

  <div class="mx-auto max-w-3xl px-6 md:px-5">
    <div class="py-20 text-lg leading-loose text-[#3E3E38] md:py-16 md:leading-normal">
      <h2 class="mb-5 text-[clamp(1.8rem,3.4vw,2.5rem)] text-indigo">
        When did you two last <span class="text-gold-deep">finish a conversation?</span>
      </h2>
      <p class="mb-6 md:mb-4">
        Between work, school, and everything in between, a quiet evening can feel impossible to
        come by. Parents Night Out gives you a few hours to yourself, and gives your kids a themed
        night they can't wait for.
      </p>
      <p>
        Your kids get a themed night they look forward to, in a place you already trust, with
        instructors who make every kid feel at home. You get a few hours that are actually yours.
      </p>
    </div>
  </div>

  <section class="pb-16 md:pb-20">
    <div class="mx-auto grid max-w-6xl gap-8 px-6 md:grid-cols-[1.2fr_0.8fr] md:gap-6 md:px-5">
      <FactList heading="The night at a glance" facts={parentsNightOutFacts} />
      <div class="rounded border border-paper-warm bg-paper-warm p-7">
        <h2 class="mb-4 font-display text-2xl font-black text-indigo">Upcoming dates</h2>
        {upcomingDates.length > 0 ? (
          <ul class="flex flex-col gap-3">
            {upcomingDates.map((e) => (
              <li class="border-b border-[#DFD9C9] pb-3 last:border-0 last:pb-0">
                <div class="font-semibold text-indigo">{eventWhenText(e)}</div>
                {e.theme && <div class="text-sm text-mist">{e.theme}</div>}
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-[#40403A]">
            Dates go up here as they are set. Ask us for the next one and we will save your
            child a spot.
          </p>
        )}
      </div>
    </div>
  </section>

  <section class="pb-16 md:pb-20">
    <div class="mx-auto max-w-6xl px-6 md:px-5">
      <SectionHead kicker="The Deal" center>
        <Fragment slot="heading">Two happy outcomes, one evening.</Fragment>
      </SectionHead>
      <div class="grid gap-8 md:grid-cols-2 md:gap-6">
        <div class="rounded border border-paper-warm bg-white p-8">
          <div class="mb-2 text-xs font-bold tracking-[0.15em] text-gold-deep uppercase">For You</div>
          <h3 class="mb-4 text-2xl font-black text-indigo">A break.</h3>
          <ul class="flex flex-col gap-2.5">
            {[
              "Go out to dinner without watching the clock",
              "Run errands at twice the speed",
              "Enjoy a quiet house for a few hours",
              "Leave them somewhere you already trust",
            ].map((item) => (
              <li class="relative pl-5 text-[#43423B]">
                <span class="absolute left-0 top-2 h-0.5 w-2.5 bg-gold" aria-hidden="true"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>
        <div class="rounded border border-paper-warm bg-white p-8">
          <div class="mb-2 text-xs font-bold tracking-[0.15em] text-gold-deep uppercase">For Them</div>
          <h3 class="mb-4 text-2xl font-black text-indigo">A blast.</h3>
          <ul class="flex flex-col gap-2.5">
            {[
              "Games, martial arts, and pure FUN",
              "A warm, welcoming crew that makes every kid feel at home",
              "New friends and a whole lot of energy spent",
              "Themed nights and memories that stick",
            ].map((item) => (
              <li class="relative pl-5 text-[#43423B]">
                <span class="absolute left-0 top-2 h-0.5 w-2.5 bg-gold" aria-hidden="true"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <CTASection ctaLabel="Ask About the Next Date" ctaHref="/contact?interest=parents-night-out">
    <Fragment slot="heading">Your next quiet evening <em>is closer than you think.</em></Fragment>
    <Fragment slot="subtext">We hold Parents Night Out regularly. Reach out for the next date and to reserve your child's spot.</Fragment>
  </CTASection>
</BaseLayout>
