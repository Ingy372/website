---
import BaseLayout from "../layouts/BaseLayout.astro";
import SimpleHero from "../components/hero/SimpleHero.astro";
import DojoForgeWidget from "../components/booking/DojoForgeWidget.astro";
import TrustSignals from "../components/sections/TrustSignals.astro";
import { business } from "../data/business";
---

<BaseLayout
  title="Book Your Free Class"
  description={`Book a free trial class at ${business.displayName}. Fill out the quick form and reserve your spot in minutes.`}
  path="/booking"
>
  <SimpleHero eyebrow="New Families">
    <Fragment slot="heading">Book My Free Class.</Fragment>
    <Fragment slot="subtext">
      Fill out the quick form below and we'll have your spot ready. Hannah is in the office
      Monday through Thursday to walk you through everything in person.
    </Fragment>
  </SimpleHero>

  <section class="py-20 md:py-16">
    <div class="mx-auto max-w-xl px-6 md:px-5">
      <DojoForgeWidget />

      <div class="mt-10 rounded border border-paper-warm bg-white p-6">
        <TrustSignals />
      </div>

      <p class="mx-auto mt-6 max-w-xl text-center text-sm text-mist">
        Looking for current class times instead? See the <a
          href="/schedule" class="font-semibold text-indigo hover:text-gold">full schedule</a>.
      </p>
    </div>
  </section>
</BaseLayout>
