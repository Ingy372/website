---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  images: { src: ImageMetadata; alt: string; position?: string }[];
  caption?: string;
  /** Aspect-ratio utility class for every tile, e.g. "aspect-[4/3]", "aspect-square", "aspect-[4/5]". */
  ratioClass?: string;
  /** Set when the strip sits on a dark (indigo) section, so the caption stays readable. */
  dark?: boolean;
}
const { images, caption, ratioClass = "aspect-[4/3]", dark = false } = Astro.props;
const cols = images.length === 2 ? "sm:grid-cols-2" : "sm:grid-cols-3";
---

<div class={`grid gap-6 md:gap-4 ${cols}`}>
  {images.map((img) => (
    <div class={`${ratioClass} overflow-hidden rounded`}>
      <Picture
        src={img.src}
        alt={img.alt}
        formats={["avif", "webp"]}
        widths={[320, 480, 640, 900]}
        sizes="(min-width: 640px) 33vw, 100vw"
        pictureAttributes={{ class: "block h-full w-full" }}
        class="h-full w-full object-cover"
        style={img.position ? `object-position:${img.position}` : undefined}
      />
    </div>
  ))}
</div>
{caption && (
  <div class={`mt-3.5 text-center text-xs font-bold tracking-[0.18em] uppercase ${dark ? "text-bone-muted" : "text-mist"}`}>{caption}</div>
)}
