---
// "Which class is right for my child?" A quick finder that sells the program
// right away: who it's for, what the family wants to fix or build (pick all
// that apply), then a result written around exactly what they picked, with
// beginner times and the trial-week button preset to that program.
//
// When it shows up (once per visitor, on browsing pages only):
//  - Desktop: the full finder opens after 10 seconds, or as soon as the
//    visitor starts scrolling toward the programs, whichever comes first.
//  - Phones: a small "Find your match" bar slides up above the Call / Trial
//    buttons at the same moments. Tapping it opens the full finder. Google's
//    mobile rule is about pop-ups that cover the page; a small, dismissible bar
//    is the kind it allows, and anything the visitor taps to open is fine.
//  - Anywhere: elements with [data-open-class-finder] open it on tap.
// "No thanks, I want to look around" is on every step. No tracking is added.
import { programs, beginnerTimes, ageLabel, type ProgramId } from "../../data/schedule";
import { offer } from "../../data/school";
import { getReview } from "../../data/reviews";

// Pages where it may appear on its own. Program pages, booking, contact,
// parties, legal, and thank-you pages are left alone: those visitors have
// already found what they came for.
const AUTO_PATHS = [
  "/", "/schedule", "/our-system", "/our-story", "/faq", "/families-we-serve", "/reviews",
  "/meet-the-team", "/facility", "/events", "/karate", "/jiu-jitsu", "/self-defense",
  "/fayetteville", "/hope-mills", "/rockfish-jack-britt", "/military-families",
];
const path = Astro.url.pathname.replace(/(\.html|\/)$/, "") || "/";
const autoOpen = AUTO_PATHS.includes(path === "/index" ? "/" : path);

type Who = "little" | "kid" | "teen" | "adult";
const whoOptions: { id: Who; label: string; sub: string; program: ProgramId }[] = [
  { id: "little", label: "My child, age 3 to 5", sub: "Preschool", program: "littleWarriors" },
  { id: "kid", label: "My child, age 6 to 12", sub: "Elementary and middle school", program: "kids" },
  { id: "teen", label: "My teen, 13 or older", sub: "Teens train with adults", program: "teensAdults" },
  { id: "adult", label: "Me", sub: "Adults, any experience level", program: "teensAdults" },
];

// One goal = a checkbox label, the short name used in the result headline,
// and one line per audience on how classes work on it. Wording is drawn from
// the site's own program pages; nothing here promises a result.
interface Goal { id: string; label: string; labelLittle?: string; short: string; shortLittle?: string; lines: Partial<Record<Who, string>> }

// Every option is something nearly every family wants, listed in the order
// most parents care about them, so most visitors check all of them. Merged
// overlapping wishes (energy + screens, friends + role models) so no line
// is wasted.
const childGoals: Goal[] = [
  { id: "listen", label: "Listens the first time", short: "listening", lines: {
    little: "Little Warriors practice listening and following directions through games, built for three to five year olds.",
    kid: "Every class runs on clear instructions and quick responses. Kids practice listening the first time, over and over, every class.",
  } },
  { id: "confidence", label: "Confidence", short: "confidence", lines: {
    little: "Every new skill they learn gives them an “I did it” moment, in front of people cheering them on.",
    kid: "Every belt your child earns is proof they set a goal and reached it. That feeling builds into real self-belief.",
  } },
  { id: "defend", label: "Can protect themselves and handle bullies", labelLittle: "Learns how to stay safe", short: "self-defense", shortLittle: "staying safe", lines: {
    little: "Age-appropriate kicks, blocks, and stances, plus the basics of staying safe, in a controlled environment.",
    kid: "Real self-defense, plus the wisdom to know when those skills belong and when to walk away and get help.",
  } },
  { id: "respect", label: "Respect and self-discipline", short: "respect", lines: {
    little: "Simple routines like lining up, waiting a turn, and listening to the instructor, practiced every class.",
    kid: "Respect is trained in every class, not printed on a poster. Parents tell us it follows their kids home.",
  } },
  { id: "emotions", label: "Learns to deal better with emotions", short: "handling emotions", lines: {
    little: "Little Warriors practice calming down, taking turns, and trying again when something is hard, in short, fun steps.",
    kid: "Martial arts gives big feelings somewhere to go. Kids practice staying calm, breathing through frustration, and trying again when something is hard.",
  } },
  { id: "focus", label: "Better focus at school and home", labelLittle: "Better focus and attention span", short: "focus", lines: {
    little: "Short, active drills build attention span a little at a time, so it never feels like a lesson.",
    kid: "The attention it takes to learn a technique is the same attention that finishes homework and listens in class.",
  } },
  { id: "energy", label: "Active, healthy, and off screens", short: "staying active", lines: {
    little: "All that energy has to go somewhere. In Little Warriors it goes into games and real technique, with routine and structure built in.",
    kid: "High-energy classes they look forward to, a few days a week, that send an active kid home pleasantly worn out.",
  } },
  { id: "friends", label: "Good friends and positive role models", short: "good influences", lines: {
    little: "They train side by side with kids their own age, led by black belt instructors who are patient with little ones.",
    kid: "They train with kids their own age, led by black belt instructors who expect their best and cheer them on.",
  } },
  { id: "faith", label: "Faith and fellowship", labelLittle: "Plants early seeds of faith", short: "faith", lines: {
    little: "Christian character taught in a way little ones understand: kindness, respect, and courage, a little bit every class.",
    kid: "Yeshua's Ryu pairs martial arts with Christian character, so what they learn on the mat shapes who they are off it.",
  } },
];

const teenGoals: Goal[] = [
  { id: "confidence", label: "Confidence", short: "confidence", lines: { teen: "Every rank is earned, never handed out. That kind of progress builds confidence that holds up outside the dojo." } },
  { id: "defend", label: "Can protect themselves", short: "self-defense", lines: { teen: "Practical self-defense that actually works, taught with control, so they carry real confidence in how they move through the world." } },
  { id: "respect", label: "Respect and self-discipline", short: "discipline", lines: { teen: "Firm expectations taught in a kind, encouraging way. Respect and self-discipline are part of every class." } },
  { id: "emotions", label: "Learns to deal better with emotions", short: "handling emotions", lines: { teen: "Training teaches them to stay calm under pressure, control their reactions, and keep going when something is hard." } },
  { id: "stress", label: "Handles stress and pressure", short: "stress relief", lines: { teen: "A hard hour of training is a healthy outlet. Whatever the school day handed them stays at the door." } },
  { id: "focus", label: "Better focus in school", short: "focus", lines: { teen: "The concentration it takes to master a technique carries straight into school and everything else they juggle." } },
  { id: "fit", label: "In shape and off the phone", short: "fitness", lines: { teen: "A full-body workout a few evenings a week, with people, off the phone. They're too busy learning to notice they're exercising." } },
  { id: "group", label: "A positive crowd and role models", short: "a positive crowd", lines: { teen: "A place where people notice when they show up and miss them when they don't, led by black belt instructors. A better place for a teenager to be." } },
  { id: "faith", label: "Faith and fellowship", short: "faith", lines: { teen: "Yeshua's Ryu pairs real martial arts with Christian character. They leave stronger in body, mind, and spirit." } },
];

const adultGoals: Goal[] = [
  { id: "fit", label: "Get in real shape", short: "getting in shape", lines: { adult: "A full-body workout that builds strength, endurance, and coordination while you're too busy learning to notice you're exercising." } },
  { id: "defend", label: "Protect myself and my family", short: "self-defense", lines: { adult: "Practical self-defense that actually works, taught with control, so you carry real confidence in how you move through the world." } },
  { id: "stress", label: "Leave the stress at the door", short: "stress relief", lines: { adult: "There's nothing quite like a hard hour of training to clear your head. Whatever the day handed you stays at the door." } },
  { id: "confidence", label: "Feel more confident", short: "confidence", lines: { adult: "No experience needed. Beginners get a class built for them, and every new rank is something you earned." } },
  { id: "focus", label: "More focus and discipline", short: "focus", lines: { adult: "The concentration it takes to master a technique carries straight into work, home, and everything else you juggle." } },
  { id: "community", label: "A positive community", short: "community", lines: { adult: "You become part of a group that notices when you're there and misses you when you're not. Parents and kids 13 and up can even train together." } },
  { id: "faith", label: "Faith and fellowship", short: "faith", lines: { adult: "Our Yeshua's Ryu system pairs real martial arts with Christian character. You leave stronger in body, mind, and spirit." } },
];

// Verbatim review lines, matched to goals. Checked at build time so a
// review edit can never leave a misquote on the site.
const quoteDefs: { review: string; text: string; who: string; goals: string[]; for: Who[] }[] = [
  { review: "taylor-s", text: "His progression from bouncing around and doing push-ups for correction constantly has progressed dramatically.", who: "parent", goals: ["listen", "energy", "respect"], for: ["kid", "little"] },
  { review: "sarah-g", text: "It has also given her a positive focus for her energy, helped her make new friends and raised her self confidence.", who: "Little Warriors parent", goals: ["friends", "confidence", "energy", "focus"], for: ["little", "kid"] },
  { review: "rachel-b", text: "He is learning how to be strong in mind and body and growing in respect and self-discipline.", who: "parent", goals: ["respect", "focus", "confidence"], for: ["kid"] },
  { review: "rachel-b", text: "My daughter seems to be growing in confidence and I believe it is in part because of Action Zone.", who: "parent", goals: ["confidence"], for: ["kid"] },
  { review: "savanna-f", text: "He gets exercise, discipline, routine and structure. Learns basic defense in a controlled environment.", who: "Little Warriors parent", goals: ["defend", "energy", "respect"], for: ["little"] },
  { review: "john-s", text: "The focus and discipline our son learned with Mr. Lowery and CMA made all the difference in his life, in the best way.", who: "parent", goals: ["focus", "respect", "confidence", "defend", "fit", "group", "emotions", "stress", "faith"], for: ["kid", "teen"] },
  { review: "jacy-d", text: "This is a fantastic place to take children so that they can gain great social skills, develop the ability to defend themselves", who: "parent", goals: ["friends", "defend"], for: ["kid"] },
  { review: "cara-p", text: "I enjoy seeing them grow, mature, and strengthen in areas of behavior, teamwork, confidence, and respect.", who: "parent", goals: ["respect", "confidence", "friends", "listen", "emotions"], for: ["kid", "little"] },
  { review: "heidi-c", text: "The instructors are very patient, but teach the importance of owning the responsibility of your actions.", who: "Little Warriors parent", goals: ["respect", "listen"], for: ["little"] },
  { review: "amber-l", text: "That make Biblical principles an important aspect and speak about Jesus and the Bible in ways the kids understand and soak in.", who: "parent", goals: ["faith"], for: ["little", "kid"] },
  { review: "benjamin-s", text: "I visited 5-6 different gyms, watched classes, asked questions, gathered details, and called more then that before landing here.", who: "adult student", goals: ["fit", "stress", "defend", "confidence", "focus", "community", "faith"], for: ["adult"] },
];
const quotes = quoteDefs.map((q) => {
  const r = getReview(q.review);
  if (!r.text.includes(q.text)) throw new Error(`ClassFinder: quote from ${q.review} is not verbatim`);
  return { text: q.text, who: `${r.author}, ${q.who}`, goals: q.goals, for: q.for };
});

const programData = Object.fromEntries(
  (Object.keys(programs) as ProgramId[]).map((id) => [
    id,
    { name: programs[id].name, href: programs[id].href, age: ageLabel(programs[id]), times: beginnerTimes(id).map((t) => `${t.days} · ${t.time}`) },
  ]),
);

const config = {
  autoOpen,
  who: whoOptions,
  goals: { child: childGoals, teen: teenGoals, adult: adultGoals },
  quotes,
  programs: programData,
};
const goalSets: { key: "child" | "teen" | "adult"; goals: Goal[] }[] = [
  { key: "child", goals: childGoals },
  { key: "teen", goals: teenGoals },
  { key: "adult", goals: adultGoals },
];
---

<div class="cf-teaser" id="class-finder-teaser" hidden role="region" aria-label="Class finder">
  <button type="button" class="cf-teaser-open" data-open-class-finder>
    <span class="cf-teaser-text"><b>Not sure which class fits?</b> Find your match in 30 seconds</span>
    <span class="cf-teaser-go" aria-hidden="true">Start &rarr;</span>
  </button>
  <button type="button" class="cf-teaser-x" data-cf-teaser-close aria-label="No thanks">&times;</button>
</div>

<dialog id="class-finder" class="cf" aria-labelledby="cf-title">
  <div class="cf-panel">
    <button type="button" class="cf-x" data-cf-close aria-label="Close">&times;</button>

    <!-- Step 1: who -->
    <div data-cf-step="1">
      <div class="cf-kicker">Find the right class · 1 of 2</div>
      <h2 id="cf-title" class="cf-title" tabindex="-1">Who is the class for?</h2>
      <p class="cf-sub">Answer two quick questions and we'll show you exactly where to start.</p>
      <div class="cf-options">
        {whoOptions.map((o) => (
          <button type="button" class="cf-opt" data-cf-who={o.id}>
            <span class="cf-opt-label">{o.label}</span>
            <span class="cf-opt-sub">{o.sub}</span>
          </button>
        ))}
      </div>
    </div>

    <!-- Step 2: goals, pick all that apply -->
    <div data-cf-step="2" hidden>
      <div class="cf-kicker">Find the right class · 2 of 2</div>
      <h2 class="cf-title" tabindex="-1" data-cf-goal-title>What would you love to see change?</h2>
      <p class="cf-sub">Pick all that apply.</p>
      {goalSets.map((set) => (
        <div class="cf-chips" data-cf-goals={set.key} role="group" aria-label="Pick all that apply" hidden>
          {set.goals.map((g) => (
            <button type="button" class="cf-chip" data-cf-goal={g.id} aria-pressed="false" data-label={g.label} data-label-little={g.labelLittle ?? g.label}>
              <span class="cf-check" aria-hidden="true"></span><span class="cf-chip-text">{g.label}</span>
            </button>
          ))}
        </div>
      ))}
      <button type="button" class="cf-cta cf-next" data-cf-show disabled>Show my match</button>
      <button type="button" class="cf-back" data-cf-back>&larr; Back</button>
    </div>

    <!-- Step 3: the tailored result -->
    <div data-cf-step="3" hidden>
      <div class="cf-kicker">Your best place to start</div>
      <h2 class="cf-title" tabindex="-1" data-cf-headline></h2>
      <div class="cf-age" data-cf-age></div>
      <p class="cf-pitch" data-cf-intro></p>
      <ul class="cf-points" data-cf-points></ul>
      <p class="cf-more-goals" data-cf-more-goals hidden></p>
      <blockquote class="cf-quote" data-cf-quote hidden></blockquote>
      <div class="cf-times">
        <div class="cf-times-label">Beginner classes</div>
        <ul data-cf-times></ul>
      </div>
      <a class="cf-cta" data-cf-cta href="/booking">{offer.cta}</a>
      <p class="cf-fine">Your first week is free. No uniform or equipment needed. We'll walk you through everything else in person, with no pressure.</p>
      <a class="cf-more" data-cf-more href="/">See the program page &rarr;</a>
      <button type="button" class="cf-back" data-cf-back>&larr; Change my answers</button>
    </div>

    <button type="button" class="cf-nothanks" data-cf-close>No thanks, I want to look around</button>
  </div>
</dialog>

<script is:inline type="application/json" id="class-finder-data" set:html={JSON.stringify(config)} />

<style>
  /* Phone teaser: sits just above the fixed Call / Trial bar (52px). */
  .cf-teaser {
    position: fixed; z-index: 39; left: 0.6rem; right: 0.6rem;
    bottom: calc(52px + 0.6rem + env(safe-area-inset-bottom));
    display: flex; align-items: stretch; overflow: hidden;
    border-radius: 8px; background: var(--color-indigo); color: #fff;
    box-shadow: 0 10px 30px -8px rgba(15, 16, 41, 0.55);
    border-top: 3px solid var(--color-gold);
    animation: cf-teaser-in 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  @media (min-width: 1024px) { .cf-teaser { display: none !important; } }
  @keyframes cf-teaser-in { from { transform: translateY(120%); opacity: 0; } }
  .cf-teaser-open { flex: 1; display: flex; align-items: center; justify-content: space-between; gap: 0.6rem; padding: 0.75rem 0.4rem 0.75rem 0.9rem; text-align: left; font-size: 0.86rem; line-height: 1.3; color: #D9D8E6; }
  .cf-teaser-text b { display: block; color: #fff; font-size: 0.92rem; }
  .cf-teaser-go { flex: none; padding: 0.5rem 0.75rem; border-radius: 4px; background: var(--color-gold); color: var(--color-indigo-deep); font-weight: 700; }
  .cf-teaser-x { flex: none; width: 2.6rem; font-size: 1.4rem; color: #A9A8BE; }

  .cf {
    margin: auto auto 0; width: 100%; max-width: 31rem; max-height: 92dvh; padding: 0; border: 0;
    border-radius: 14px 14px 0 0; background: #fff; color: var(--color-ink);
    box-shadow: 0 -10px 40px rgba(15, 16, 41, 0.35);
  }
  @media (min-width: 640px) { .cf { margin: auto; border-radius: 10px; } }
  .cf::backdrop { background: rgba(15, 16, 41, 0.6); }
  .cf[open] { animation: cf-in 0.32s cubic-bezier(0.22, 1, 0.36, 1); }
  @keyframes cf-in { from { transform: translateY(24px); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .cf[open], .cf-teaser { animation: none; } }

  .cf-panel { position: relative; overflow-y: auto; max-height: 92dvh; padding: 1.6rem 1.4rem calc(1.2rem + env(safe-area-inset-bottom)); border-top: 5px solid var(--color-gold); }
  .cf-x { position: absolute; top: 0.6rem; right: 0.7rem; width: 2.5rem; height: 2.5rem; font-size: 1.7rem; line-height: 1; color: var(--color-mist); }
  .cf-kicker { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-gold-deep); }
  .cf-title { margin-top: 0.35rem; padding-right: 2rem; font-family: var(--font-display); font-size: 1.55rem; font-weight: 900; line-height: 1.15; color: var(--color-indigo); text-wrap: balance; }
  .cf-title:focus { outline: none; }
  .cf-sub { margin-top: 0.4rem; font-size: 0.93rem; color: var(--color-mist); }
  .cf-options { display: grid; gap: 0.6rem; margin-top: 1.1rem; }
  .cf-opt { display: flex; flex-direction: column; align-items: flex-start; gap: 0.1rem; width: 100%; padding: 0.95rem 1rem; text-align: left; border: 1.5px solid #E2DCCB; border-radius: 6px; background: var(--color-paper); transition: border-color 0.15s, background-color 0.15s; }
  .cf-opt:hover, .cf-opt:focus-visible { border-color: var(--color-gold); background: #fff; }
  .cf-opt-label { font-weight: 700; color: var(--color-indigo); }
  .cf-opt-sub { font-size: 0.8rem; color: var(--color-mist); }

  .cf-chips { display: grid; gap: 0.5rem; margin-top: 1rem; }
  .cf-chips[hidden] { display: none; }
  .cf-chip { display: flex; align-items: center; gap: 0.7rem; width: 100%; padding: 0.75rem 0.9rem; text-align: left; border: 1.5px solid #E2DCCB; border-radius: 6px; background: var(--color-paper); font-weight: 600; color: var(--color-indigo); transition: border-color 0.15s, background-color 0.15s; }
  .cf-chip:hover { border-color: var(--color-gold); }
  .cf-check { flex: none; display: grid; place-items: center; width: 1.25rem; height: 1.25rem; border: 2px solid #C9C2AE; border-radius: 4px; background: #fff; }
  .cf-chip[aria-pressed="true"] { border-color: var(--color-indigo); background: #fff; }
  .cf-chip[aria-pressed="true"] .cf-check { border-color: var(--color-indigo); background: var(--color-indigo); }
  .cf-chip[aria-pressed="true"] .cf-check::after { content: ""; width: 0.35rem; height: 0.65rem; margin-top: -0.15rem; border: solid var(--color-gold-soft); border-width: 0 2px 2px 0; transform: rotate(45deg); }

  .cf-back { margin-top: 0.9rem; font-size: 0.85rem; font-weight: 600; color: var(--color-mist); }
  .cf-age { display: inline-block; margin-top: 0.5rem; padding: 0.25rem 0.6rem; border-radius: 3px; background: var(--color-indigo); color: var(--color-gold-soft); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; }
  .cf-pitch { margin-top: 0.9rem; color: #3E3E38; line-height: 1.55; }
  .cf-points { display: grid; gap: 0.7rem; margin-top: 0.8rem; }
  .cf-points :global(li) { position: relative; padding-left: 1.6rem; font-size: 0.93rem; line-height: 1.5; color: #3E3E38; }
  .cf-points :global(li)::before { content: ""; position: absolute; left: 0.15rem; top: 0.35rem; width: 0.45rem; height: 0.8rem; border: solid var(--color-gold-deep); border-width: 0 2.5px 2.5px 0; transform: rotate(45deg); }
  .cf-points :global(b) { color: var(--color-indigo); }
  .cf-more-goals { margin-top: 0.6rem; font-size: 0.85rem; color: var(--color-mist); }
  .cf-quote { margin-top: 1rem; padding-left: 0.8rem; border-left: 3px solid var(--color-gold); font-size: 0.9rem; font-style: italic; color: #3E3E38; }
  .cf-quote :global(span) { display: block; margin-top: 0.25rem; font-size: 0.78rem; font-style: normal; font-weight: 700; color: var(--color-gold-deep); }
  .cf-times { margin-top: 1rem; padding: 0.8rem 1rem; border-radius: 6px; background: var(--color-paper-warm); }
  .cf-times-label { font-size: 0.68rem; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase; color: var(--color-gold-deep); }
  .cf-times :global(li) { font-size: 0.92rem; font-weight: 600; color: var(--color-indigo); }
  .cf-cta { display: block; width: 100%; margin-top: 1.1rem; padding: 1rem; border-radius: 3px; background: var(--color-gold); color: var(--color-indigo-deep); text-align: center; font-weight: 700; }
  .cf-cta:hover { background: var(--color-gold-soft); }
  .cf-next:disabled { background: #E9E4D6; color: #8D8B80; cursor: not-allowed; }
  .cf-fine { margin-top: 0.5rem; text-align: center; font-size: 0.78rem; color: var(--color-mist); }
  .cf-more { display: block; margin-top: 0.7rem; text-align: center; font-size: 0.88rem; font-weight: 700; color: var(--color-indigo); }
  .cf-nothanks { display: block; width: 100%; margin-top: 1.2rem; padding: 0.85rem; border: 1.5px solid #D9D3C3; border-radius: 3px; background: #fff; font-weight: 700; color: var(--color-indigo); }
  .cf-nothanks:hover { border-color: var(--color-indigo); }
  .cf :focus-visible, .cf-teaser :focus-visible { outline: 3px solid var(--color-gold); outline-offset: 2px; }
</style>

<script is:inline>
  (function () {
    var dlg = document.getElementById("class-finder");
    var teaser = document.getElementById("class-finder-teaser");
    var dataEl = document.getElementById("class-finder-data");
    if (!dlg || !dataEl || typeof dlg.showModal !== "function") return;
    var cfg = JSON.parse(dataEl.textContent);
    var KEY = "az_class_finder_seen";
    var who = null, picked = [];

    function seen() { try { return localStorage.getItem(KEY) === "1"; } catch (e) { return false; } }
    function markSeen() { try { localStorage.setItem(KEY, "1"); } catch (e) {} }
    function setFor(w) { return w === "adult" ? "adult" : w === "teen" ? "teen" : "child"; }
    function goalsFor(w) { return cfg.goals[setFor(w)]; }
    function shortOf(g) { return (who === "little" && g.shortLittle) || g.short; }
    function joinList(a) { return a.length < 2 ? a.join("") : a.length === 2 ? a[0] + " and " + a[1] : a.slice(0, -1).join(", ") + ", and " + a[a.length - 1]; }

    function step(n) {
      dlg.querySelectorAll("[data-cf-step]").forEach(function (s) { s.hidden = s.getAttribute("data-cf-step") !== String(n); });
      var h = dlg.querySelector('[data-cf-step="' + n + '"] .cf-title');
      if (h) h.focus({ preventScroll: true });
      dlg.querySelector(".cf-panel").scrollTop = 0;
    }
    function hideTeaser() { if (teaser) teaser.hidden = true; }
    function open() {
      hideTeaser();
      if (dlg.open) return;
      markSeen();
      step(1);
      dlg.showModal();
      var t = dlg.querySelector("#cf-title"); if (t) t.focus({ preventScroll: true });
    }
    function close() { if (dlg.open) dlg.close(); }

    dlg.querySelectorAll("[data-cf-close]").forEach(function (b) { b.addEventListener("click", close); });
    dlg.addEventListener("click", function (e) { if (e.target === dlg) close(); });
    dlg.querySelectorAll("[data-cf-back]").forEach(function (b) {
      b.addEventListener("click", function () { step(b.closest('[data-cf-step="3"]') ? 2 : 1); });
    });

    var showBtn = dlg.querySelector("[data-cf-show]");
    function syncShow() {
      showBtn.disabled = picked.length === 0;
      showBtn.textContent = picked.length ? "Show my match (" + picked.length + " picked)" : "Pick at least one to continue";
    }

    dlg.querySelectorAll("[data-cf-who]").forEach(function (b) {
      b.addEventListener("click", function () {
        var next = b.getAttribute("data-cf-who");
        if (next !== who) {
          picked = [];
          dlg.querySelectorAll("[data-cf-goal]").forEach(function (c) { c.setAttribute("aria-pressed", "false"); });
        }
        who = next;
        var set = setFor(who);
        dlg.querySelectorAll("[data-cf-goals]").forEach(function (g) { g.hidden = g.getAttribute("data-cf-goals") !== set; });
        dlg.querySelectorAll("[data-label-little]").forEach(function (c) {
          c.querySelector(".cf-chip-text").textContent = c.getAttribute(who === "little" ? "data-label-little" : "data-label");
        });
        dlg.querySelector("[data-cf-goal-title]").textContent =
          who === "adult" ? "What do you want to get out of it?" : who === "teen" ? "What would you love to see for your teen?" : "What would you love to see change?";
        syncShow();
        step(2);
      });
    });

    dlg.querySelectorAll("[data-cf-goal]").forEach(function (c) {
      c.addEventListener("click", function () {
        var id = c.getAttribute("data-cf-goal");
        var on = c.getAttribute("aria-pressed") !== "true";
        c.setAttribute("aria-pressed", on ? "true" : "false");
        picked = picked.filter(function (p) { return p !== id; });
        if (on) picked.push(id);
        syncShow();
      });
    });

    showBtn.addEventListener("click", function () {
      if (!picked.length) return;
      var opt = cfg.who.filter(function (o) { return o.id === who; })[0];
      var p = cfg.programs[opt.program];
      var all = goalsFor(who);
      // Keep the order shown on screen so the result reads naturally.
      var chosen = all.filter(function (g) { return picked.indexOf(g.id) !== -1; });
      var shown = chosen.slice(0, 3);
      var rest = chosen.slice(3);

      var display = { littleWarriors: "Little Warriors", kids: "Kids Classes", teensAdults: "Teens & Adults classes" }[opt.program] || p.name;
      var subject = who === "adult" ? "you" : who === "teen" ? "your teen" : "your child";
      dlg.querySelector("[data-cf-headline]").textContent =
        display + (display === "Little Warriors" ? " is" : " are") + " built for " +
        (chosen.length === all.length ? "all of it" : joinList(chosen.slice(0, 2).map(shortOf))) + ".";
      dlg.querySelector("[data-cf-age]").textContent = p.age;
      dlg.querySelector("[data-cf-intro]").textContent =
        "Here is how we work on " + (chosen.length > 1 ? "what you picked" : "that") + " for " + subject + ":";

      var ul = dlg.querySelector("[data-cf-points]"); ul.innerHTML = "";
      shown.forEach(function (g) {
        var li = document.createElement("li");
        var b = document.createElement("b"); b.textContent = ((who === "little" && g.labelLittle) || g.label) + ". ";
        li.appendChild(b);
        li.appendChild(document.createTextNode(g.lines[who] || g.lines.kid || g.lines.teen || g.lines.adult || ""));
        ul.appendChild(li);
      });
      var more = dlg.querySelector("[data-cf-more-goals]");
      more.hidden = rest.length === 0;
      if (rest.length) more.textContent = "We work on " + joinList(rest.map(shortOf)) + " in every class, too.";

      // Best matching verbatim review: most overlap with what they picked.
      var best = null, score = 0;
      cfg.quotes.forEach(function (q) {
        if (q.for.indexOf(who) === -1) return;
        var s = q.goals.filter(function (g) { return picked.indexOf(g) !== -1; }).length + (q.for[0] === who ? 0.5 : 0);
        if (s > score) { score = s; best = q; }
      });
      var quote = dlg.querySelector("[data-cf-quote]");
      quote.hidden = !best;
      if (best) {
        quote.innerHTML = "";
        quote.appendChild(document.createTextNode("“" + best.text + "”"));
        var cite = document.createElement("span"); cite.textContent = best.who + ", Google review"; quote.appendChild(cite);
      }

      var times = dlg.querySelector("[data-cf-times]"); times.innerHTML = "";
      p.times.forEach(function (t) { var li = document.createElement("li"); li.textContent = t; times.appendChild(li); });
      dlg.querySelector("[data-cf-cta]").href = "/booking?program=" + opt.program;
      var link = dlg.querySelector("[data-cf-more]");
      link.href = p.href; link.innerHTML = "See the " + p.name + " page &rarr;";
      step(3);
    });

    document.addEventListener("click", function (e) {
      var t = e.target.closest && e.target.closest("[data-open-class-finder]");
      if (t) { e.preventDefault(); open(); }
    });
    if (teaser) teaser.querySelector("[data-cf-teaser-close]").addEventListener("click", function () { markSeen(); hideTeaser(); });

    // Automatic appearance: 10 seconds in, or the moment the visitor starts
    // scrolling toward the programs, whichever is first. Once per visitor.
    if (cfg.autoOpen && !seen()) {
      var armed = true;
      var desktop = window.matchMedia("(min-width: 1024px)").matches;
      var fire = function () {
        if (!armed) return;
        if (document.querySelector("dialog[open]") || /INPUT|TEXTAREA|SELECT/.test((document.activeElement || {}).tagName || "")) return;
        armed = false;
        window.removeEventListener("scroll", onScroll);
        if (desktop) { open(); }
        else if (teaser) { markSeen(); teaser.hidden = false; }
      };
      var onScroll = function () { if (window.scrollY > 120) fire(); };
      window.addEventListener("scroll", onScroll, { passive: true });
      setTimeout(fire, 10000);
    }
  })();
</script>
