---
import { nav, offer } from "../../data/school";
import { business } from "../../data/business";

const dropdowns = [
  { label: "Programs", items: [...nav.programs, ...nav.styles] },
  { label: "Parties", items: nav.parties },
  { label: "About", items: nav.about },
];
---

<nav class="site-nav sticky top-0 z-50 bg-indigo/97 backdrop-blur-sm" data-site-nav>
  <div class="site-nav-bar mx-auto flex h-[72px] max-w-6xl items-center justify-between px-5">
    <a href="/" class="font-display text-xl font-black leading-none text-white">
      {business.displayName}
      <span class="mt-0.5 hidden font-body text-[0.6rem] font-medium tracking-[0.26em] text-gold-soft sm:block">
        YESHUA'S RYU &middot; JESUS' WAY
      </span>
    </a>

    <div class="hidden items-center gap-6 lg:flex">
      {dropdowns.map((dd) => (
        <div class="group relative">
          <button
            type="button"
            class="flex items-center gap-1 text-sm font-medium text-[#D9D8E6] transition-colors hover:text-gold-soft focus-visible:text-gold-soft"
            aria-haspopup="true"
          >
            {dd.label} <span aria-hidden="true">&#9662;</span>
          </button>
          <div
            class="invisible absolute left-0 top-full min-w-[200px] rounded-sm bg-indigo-deep py-2 opacity-0 shadow-lg transition-all duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100"
          >
            {dd.items.map((item) => (
              <a
                href={item.href}
                class="block px-4 py-2 text-sm text-[#D9D8E6] hover:bg-white/5 hover:text-gold-soft"
              >
                {item.label}
              </a>
            ))}
          </div>
        </div>
      ))}

      {nav.primary.map((item) => (
        <a href={item.href} class="text-sm font-medium text-[#D9D8E6] transition-colors hover:text-gold-soft">
          {item.label}
        </a>
      ))}

      <a
        href="/booking"
        class="rounded-sm bg-gold px-[18px] py-[11px] text-[0.83rem] font-bold text-indigo-deep transition-colors hover:bg-gold-soft"
      >
        {offer.cta}
      </a>
    </div>

    <button
      type="button"
      id="nav-menu-btn"
      class="text-2xl text-white lg:hidden"
      aria-label="Open menu"
      aria-haspopup="dialog"
      aria-controls="nav-drawer"
    >
      &#9776;
    </button>
  </div>
</nav>

<dialog
  id="nav-drawer"
  class="m-0 h-dvh max-h-none w-full max-w-none bg-indigo-deep p-0 backdrop:bg-black/50 lg:hidden"
  aria-label="Site menu"
>
  <div class="flex h-full flex-col overflow-y-auto p-6">
    <div class="mb-6 flex items-center justify-between">
      <span class="font-display text-lg font-black text-white">{business.displayName}</span>
      <button type="button" id="nav-drawer-close" class="text-3xl leading-none text-white" aria-label="Close menu">
        &times;
      </button>
    </div>

    <div class="flex flex-1 flex-col gap-1">
      {dropdowns.map((dd) => (
        <details class="border-b border-white/10 py-2">
          <summary class="cursor-pointer list-none py-2 text-base font-medium text-white">
            {dd.label}
          </summary>
          <div class="flex flex-col gap-1 pb-2 pl-3">
            {dd.items.map((item) => (
              <a href={item.href} class="py-2 text-[0.95rem] text-[#D9D8E6] hover:text-gold-soft">
                {item.label}
              </a>
            ))}
          </div>
        </details>
      ))}

      {nav.primary.map((item) => (
        <a href={item.href} class="border-b border-white/10 py-3 text-base font-medium text-white hover:text-gold-soft">
          {item.label}
        </a>
      ))}
    </div>

    <a
      href="/booking"
      class="mt-4 block rounded-sm bg-gold px-5 py-4 text-center text-base font-bold text-indigo-deep"
    >
      {offer.cta}
    </a>
    <a
      href={business.phoneHref}
      class="mt-3 block text-center text-sm font-semibold text-gold-soft"
    >
      Or call us
    </a>
  </div>
</dialog>

<style>
  /* Pages that mark their hero with data-nav-sentinel (the homepage, for
     now) get a nav that tightens once the hero scrolls away: 72px -> 60px
     and solid deep navy with a soft shadow. A matching bottom margin keeps
     the nav's footprint at 72px, so nothing below it moves. */
  .site-nav {
    transition:
      background-color 0.3s ease,
      box-shadow 0.3s ease,
      margin-bottom 0.3s ease;
  }

  .site-nav-bar {
    transition: height 0.3s ease;
  }

  .site-nav[data-scrolled] {
    background-color: var(--color-indigo-deep);
    box-shadow: 0 10px 28px -14px rgb(0 0 0 / 0.55);
    margin-bottom: 12px;
  }

  .site-nav[data-scrolled] .site-nav-bar {
    height: 60px;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-nav,
    .site-nav-bar {
      transition: none;
    }
  }
</style>

<script>
  const siteNav = document.querySelector<HTMLElement>("[data-site-nav]");
  const navSentinel = document.querySelector("[data-nav-sentinel]");
  if (siteNav && navSentinel && "IntersectionObserver" in window) {
    // Flip once the sentinel's bottom edge passes under the 72px nav.
    new IntersectionObserver(
      ([entry]) => siteNav.toggleAttribute("data-scrolled", !entry.isIntersecting),
      { rootMargin: "-72px 0px 0px 0px" },
    ).observe(navSentinel);
  }

  const openBtn = document.getElementById("nav-menu-btn");
  const closeBtn = document.getElementById("nav-drawer-close");
  const drawer = document.getElementById("nav-drawer") as HTMLDialogElement | null;

  openBtn?.addEventListener("click", () => drawer?.showModal());
  closeBtn?.addEventListener("click", () => drawer?.close());
  drawer?.addEventListener("click", (e) => {
    if (e.target === drawer) drawer.close();
  });
</script>
