---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProgramHero from "../components/hero/ProgramHero.astro";
import ProseSection from "../components/sections/ProseSection.astro";
import WorthTheDrive from "../components/sections/WorthTheDrive.astro";
import AreaDirections from "../components/sections/AreaDirections.astro";
import PhotoStrip from "../components/sections/PhotoStrip.astro";
import FAQGroup from "../components/sections/FAQGroup.astro";
import ReviewQuote from "../components/sections/ReviewQuote.astro";
import CTASection from "../components/sections/CTASection.astro";
import { offer, tuitionFaqItem } from "../data/school";
import { programs, ageLabel, beginnerTimes, trialDaysText } from "../data/schedule";

import heroImage from "../images/little-warriors/class-photo.jpg";
import playground from "../images/facility/playground.jpg";
import ninjaLine from "../images/facility/ninja-line.jpg";

const kidsTimes = beginnerTimes("kids").map((t) => `${t.days}, ${t.time}`).join(" · ");
const lwTimes = beginnerTimes("littleWarriors").map((t) => `${t.days}, ${t.time}`).join(" · ");

const faqItems = [
  {
    question: "Do families really drive from Hope Mills?",
    answer: ["Yes. Families from Hope Mills train with us, along with families from Fayetteville, Rockfish, Jack Britt, and Fort Bragg."],
  },
  {
    question: "What times work after school?",
    answer: [
      `Little Warriors (${ageLabel(programs.littleWarriors)}) beginner classes run ${lwTimes}. Kids karate (${ageLabel(programs.kids)}) beginner classes run ${kidsTimes}. See the <a href="/schedule" class="text-indigo font-bold border-b border-gold">full schedule</a>.`,
    ],
  },
  {
    question: "What if we miss a class?",
    answer: ["We keep track of missed days and offer them back as make-ups, and Saturday open training is open to every student."],
  },
  tuitionFaqItem(),
];
---

<BaseLayout
  title="Kids Karate & Martial Arts for Hope Mills Families"
  fullTitle="Kids Karate & Martial Arts for Hope Mills Families"
  crumb="Hope Mills"
  description={`Kids karate, preschool karate, and adult martial arts for Hope Mills families, at our family-run dojo in Raeford. Start with a ${offer.noun}.`}
  path="/hope-mills"
  ogImage={heroImage}
  ogImageAlt="Little Warriors preschool karate class standing at attention"
  faq={faqItems}
>
  <ProgramHero
    badge="Serving Hope Mills"
    h1="Kids Karate & Martial Arts for Hope Mills Families"
    image={heroImage}
    alt="Little Warriors preschool karate class standing at attention on the mat"
    ctaLabel={offer.cta}
    ctaHref="/booking"
  >
    <Fragment slot="heading">Worth the drive <em>from Hope Mills.</em></Fragment>
    <Fragment slot="subtext">
      Hope Mills families bring their kids to our Raeford dojo for karate, jiu jitsu, and
      self-defense, and for a place that feels like family.
    </Fragment>
  </ProgramHero>

  <ProseSection kicker="Hope Mills Families" heading="Why Hope Mills parents make the trip.">
    <p>
      If you live in Hope Mills, you have choices for martial arts. Families who make the drive to
      Raeford are usually looking for something specific: a school where the instructors know
      their child, where character is taught alongside kicks and punches, and where nobody is
      being pushed toward a trophy.
    </p>
    <p>
      That is what Action Zone CMA is. We are a family-run, non-competitive Christian martial arts
      school. Our system, Yeshua's Ryu, blends karate, jiu jitsu, Kung Fu, Tae Kwon Do, and
      traditional Japanese weapons, and every class teaches discipline, respect, and perseverance
      along with technique.
    </p>
    <p>
      Families from every background train here. Our faith shapes how we teach character, and we
      never ask anything of what our students believe.
    </p>
  </ProseSection>

  <WorthTheDrive heading="What Hope Mills families get when they get here" />

  <ProseSection kicker="Classes" heading="A class for everyone in the car.">
    <p>
      <a href="/little-warriors">Little Warriors</a> is preschool karate for ages 3 to 5.
      <a href="/kids">Kids karate</a> is for ages 6 to 12. Teens and adults train together in our
      <a href="/teens-adults">teen and adult class</a>, so a parent can train too.
    </p>
    <p>
      Hannah, our office manager, is in {trialDaysText} to meet new families and walk them through
      everything. Parents are always welcome to watch class.
    </p>
  </ProseSection>

  <section class="pb-16 md:pb-18">
    <div class="mx-auto grid max-w-6xl gap-8 px-6 md:grid-cols-2 md:px-5">
      <AreaDirections from="Hope Mills" />
      <PhotoStrip
        ratioClass="aspect-square"
        images={[
          { src: playground, alt: "The outdoor playground beside the dojo" },
          { src: ninjaLine, alt: "The ninja line strung across the dojo", position: "50% 42%" },
        ]}
      />
    </div>
  </section>

  <ReviewQuote id="savanna-f" />

  <div class="py-12">
    <FAQGroup id="hope-mills-faq" title="Questions from Hope Mills parents" tag="Hope Mills" items={faqItems} />
  </div>

  <CTASection ctaLabel={offer.cta} ctaHref="/booking">
    <Fragment slot="heading">Make the drive once. <em>The first week is free.</em></Fragment>
    <Fragment slot="subtext">Come try {offer.visit}. No cost, no commitment, no pressure.</Fragment>
  </CTASection>
</BaseLayout>
