---
import TrustSignals from "./TrustSignals.astro";
import { turnstileSiteKey, analytics } from "../../data/school";
import { business } from "../../data/business";
import { LIMITS, HONEYPOT_FIELD, INTERESTS, HEARD_FROM, ATTRIBUTION_FIELDS } from "../../lib/contact";

const inputClass =
  "w-full rounded border border-paper-warm bg-paper px-3.5 py-3 text-[0.95rem] focus:border-transparent focus:outline focus:outline-2 focus:outline-gold";
const labelClass = "mb-1.5 block text-xs font-semibold tracking-[0.05em] text-mist uppercase";
---

<!-- Edge to edge on phones: Turnstile needs at least 300px inside the card. -->
<div class="-mx-6 min-w-0 border-t-4 border-gold bg-white p-5 sm:mx-0 sm:rounded sm:p-7">
  <h2 class="mb-1 font-display text-2xl font-black text-indigo">Send us a message</h2>
  <p class="mb-5 text-sm text-mist">
    Questions, a party inquiry, or anything else. Ready to try a class instead? Head to our <a
      href="/booking" class="font-semibold text-indigo hover:text-gold">booking page</a>.
  </p>

  <!-- method/action keep the form working (and keep personal details out of
       the URL) even if the script below never runs. -->
  <form id="contact-form" method="post" action="/api/contact" data-pixel-id={analytics.metaPixelId} class="flex flex-col gap-4">
    <div>
      <label for="contact-interest" class={labelClass}>What's this about?</label>
      <select name="interest" id="contact-interest" class={inputClass}>
        <option value="">Choose one (optional)</option>
        {INTERESTS.map((i) => <option value={i.value}>{i.label}</option>)}
      </select>
    </div>
    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <label for="contact-name" class={labelClass}>Name</label>
        <input id="contact-name" required name="name" autocomplete="name" type="text" maxlength={LIMITS.name} class={inputClass} />
      </div>
      <div>
        <label for="contact-phone" class={labelClass}>Phone (optional)</label>
        <input id="contact-phone" name="phone" autocomplete="tel" type="tel" maxlength={LIMITS.phone} placeholder="(910) 000-0000" class={inputClass} />
      </div>
    </div>
    <div>
      <label for="contact-email" class={labelClass}>Email</label>
      <input id="contact-email" required name="email" autocomplete="email" type="email" maxlength={LIMITS.email} class={inputClass} />
    </div>
    <div>
      <label for="contact-message" class={labelClass}>Message <span id="contact-message-optional" class="hidden normal-case tracking-normal">(optional)</span></label>
      <textarea required name="message" id="contact-message" rows="4" maxlength={LIMITS.message} class={inputClass}></textarea>
    </div>

    <!-- Shown for party, PNO, and demo topics once the script runs; always shown without it. -->
    <fieldset id="contact-event-details" class="rounded border border-paper-warm bg-paper p-4">
      <legend class="px-1 text-xs font-semibold tracking-[0.05em] text-mist uppercase">Event details (optional)</legend>
      <div class="mt-2 grid gap-4 sm:grid-cols-2">
        <div>
          <label for="contact-preferred-date" class={labelClass}>Preferred date</label>
          <input id="contact-preferred-date" name="preferredDate" type="date" class={inputClass.replace("bg-paper", "bg-white")} />
        </div>
        <div>
          <label for="contact-child-age" class={labelClass}>Child's age</label>
          <input id="contact-child-age" name="childAge" type="text" inputmode="numeric" maxlength={LIMITS.childAge} class={inputClass.replace("bg-paper", "bg-white")} />
        </div>
        <div>
          <label for="contact-guest-count" class={labelClass}>Approximate guest count</label>
          <input id="contact-guest-count" name="guestCount" type="text" inputmode="numeric" maxlength={LIMITS.guestCount} class={inputClass.replace("bg-paper", "bg-white")} />
        </div>
      </div>
    </fieldset>

    <div>
      <label for="contact-heard-from" class={labelClass}>How did you hear about us? (optional)</label>
      <select id="contact-heard-from" name="heardFrom" class={inputClass}>
        <option value="">Choose one</option>
        {HEARD_FROM.map((h) => <option value={h.value}>{h.label}</option>)}
      </select>
    </div>

    <!-- First-touch attribution, filled from localStorage (FirstTouch.astro). -->
    {ATTRIBUTION_FIELDS.map((f) => <input type="hidden" name={f} maxlength={LIMITS[f]} />)}

    <!-- Honeypot: hidden from people and screen readers; bots tend to fill it. -->
    <div class="absolute -left-[9999px] h-px w-px overflow-hidden" aria-hidden="true">
      <label>Leave this field empty <input name={HONEYPOT_FIELD} type="text" tabindex="-1" autocomplete="off" /></label>
    </div>

    <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-size="flexible"></div>

    <button
      type="submit"
      id="contact-submit"
      class="rounded bg-indigo px-5 py-4 text-base font-bold text-bone transition-colors hover:bg-gold hover:text-indigo-deep disabled:opacity-60"
    >
      Send My Message
    </button>
    <p class="text-xs text-mist">
      We use your details only to reply to you. See our <a href="/privacy" class="underline hover:text-indigo">privacy policy</a>.
    </p>
    <p id="contact-error" role="alert" class="hidden text-sm font-semibold text-[#8B3A2F]">
      <span id="contact-error-text">Something went wrong sending your message.</span> Please call us at <a href={business.phoneHref} class="underline">{business.phone}</a> instead.
    </p>
  </form>

  <div id="contact-success" class="hidden text-center" aria-live="polite">
    <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-gold text-2xl text-indigo-deep" aria-hidden="true">&#10003;</div>
    <h2 id="contact-success-heading" tabindex="-1" class="mb-2 font-display text-2xl font-black text-indigo focus:outline-none">Message sent</h2>
    <p class="text-mist">We'll get back to you quickly, usually the same day.</p>
  </div>

  <div class="mt-6 border-t border-paper-warm pt-6">
    <TrustSignals />
  </div>
</div>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const submitBtn = document.getElementById("contact-submit") as HTMLButtonElement | null;
  const errorEl = document.getElementById("contact-error");
  const errorText = document.getElementById("contact-error-text");
  const successEl = document.getElementById("contact-success");

  // Normalized (not pre-hashed) values for Meta's client-side Advanced
  // Matching — the Pixel SDK hashes em/ph/fn/ln with SHA-256 in-browser
  // before anything goes over the network. Pre-hashing here would double-hash
  // and break matching, so this must stay plain, lowercased/trimmed text.
  function buildAdvancedMatching(payload: Record<string, FormDataEntryValue>) {
    const name = String(payload.name ?? "").trim().split(/\s+/).filter(Boolean);
    const email = String(payload.email ?? "").trim().toLowerCase();
    const phoneDigits = String(payload.phone ?? "").replace(/\D/g, "");

    const data: Record<string, string> = {};
    if (email) data.em = email;
    if (phoneDigits) data.ph = phoneDigits.length === 10 ? `1${phoneDigits}` : phoneDigits;
    if (name[0]) data.fn = name[0].toLowerCase();
    if (name.length > 1) data.ln = name.slice(1).join(" ").toLowerCase();
    return data;
  }

  const interest = document.getElementById("contact-interest") as HTMLSelectElement | null;
  const message = document.getElementById("contact-message") as HTMLTextAreaElement | null;
  const messageOptional = document.getElementById("contact-message-optional");
  const eventDetails = document.getElementById("contact-event-details");
  const EVENT_TOPICS = ["birthday-party", "parents-night-out", "demo"];

  // Message is optional once a topic is chosen; event fields only matter for events.
  function syncTopic() {
    const topic = interest?.value ?? "";
    if (message) message.required = !topic;
    messageOptional?.classList.toggle("hidden", !topic);
    eventDetails?.classList.toggle("hidden", !EVENT_TOPICS.includes(topic));
  }

  // ?interest=birthday-party etc. preselects the topic.
  const requested = new URLSearchParams(location.search).get("interest");
  if (interest && requested && [...interest.options].some((o) => o.value === requested)) {
    interest.value = requested;
  }
  interest?.addEventListener("change", syncTopic);
  syncTopic();

  // Copy first-touch attribution into the hidden fields.
  try {
    const firstTouch = JSON.parse(localStorage.getItem("az_first_touch") || "{}") as Record<string, string>;
    for (const [key, value] of Object.entries(firstTouch)) {
      const field = form?.elements.namedItem(key);
      if (field instanceof HTMLInputElement && field.type === "hidden") field.value = value;
    }
  } catch {
    /* storage blocked: attribution is optional */
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    errorEl?.classList.add("hidden");
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = "Sending...";
    }

    const payload = Object.fromEntries(new FormData(form).entries());

    try {
      const res = await fetch(form.action, {
        method: "POST",
        headers: { "Content-Type": "application/json", Accept: "application/json" },
        body: JSON.stringify(payload),
      });
      if (!res.ok) {
        const body = (await res.json().catch(() => ({}))) as { error?: string };
        throw new Error(body.error || "Something went wrong sending your message.");
      }
      form.classList.add("hidden");
      successEl?.classList.remove("hidden");
      // Move focus to the confirmation so keyboard and screen-reader users hear it.
      document.getElementById("contact-success-heading")?.focus();

      window.gtag?.("event", "generate_lead", { form_id: "contact_form" });

      const matchData = buildAdvancedMatching(payload);
      if (Object.keys(matchData).length) window.fbq?.("init", form.dataset.pixelId, matchData);
      window.fbq?.("track", "Lead", { content_name: "contact_form" });
    } catch (err) {
      if (errorText) errorText.textContent = err instanceof Error ? err.message : "Something went wrong sending your message.";
      errorEl?.classList.remove("hidden");
      // A Turnstile token is single-use; get a fresh one for the retry.
      (window as unknown as { turnstile?: { reset(): void } }).turnstile?.reset();
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = "Send My Message";
      }
    }
  });
</script>
