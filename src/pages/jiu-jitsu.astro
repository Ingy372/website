---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProgramHero from "../components/hero/ProgramHero.astro";
import ProseSection from "../components/sections/ProseSection.astro";
import PhotoStrip from "../components/sections/PhotoStrip.astro";
import FAQGroup from "../components/sections/FAQGroup.astro";
import ReviewQuote from "../components/sections/ReviewQuote.astro";
import CTASection from "../components/sections/CTASection.astro";
import { offer, tuitionFaqItem } from "../data/school";
import { founded } from "../data/business";
import { programs, ageLabel, beginnerTimes } from "../data/schedule";

import heroImage from "../images/kids/partner-drill.jpg";
import partnerSelfDefense from "../images/teens-adults/partner-self-defense.jpg";
import studentsOnTheMat from "../images/teens-adults/students-on-the-mat.jpg";
import instructorCorrectingStance from "../images/kids/instructor-correcting-stance.jpg";

const timesText = (id: "kids" | "teensAdults") => beginnerTimes(id).map((t) => `${t.days}, ${t.time}`).join(" · ");

const faqItems = [
  {
    question: "Do you teach jiu jitsu to kids?",
    answer: [
      `Yes. Kids and adults both learn jiu jitsu. It is taught inside our regular classes: the <a href="/kids" class="text-indigo font-bold border-b border-gold">kids martial arts classes</a> and the <a href="/teens-adults" class="text-indigo font-bold border-b border-gold">teen and adult classes</a>. There is no separate jiu jitsu class to sign up for.`,
    ],
  },
  {
    question: "Is this Brazilian Jiu Jitsu?",
    answer: [
      "No. Our jiu jitsu is our own blend, part of our Yeshua's Ryu system. It is not Brazilian or Japanese jiu jitsu specifically. It is taught alongside karate, Kung Fu, Tae Kwon Do, and traditional Japanese weapons.",
    ],
  },
  {
    question: "Do you spar and grapple live?",
    answer: [
      "Yes. Students do live sparring and live grappling, so they learn how their technique holds up against a real, resisting partner.",
    ],
  },
  {
    question: "Do I need experience or a uniform?",
    answer: [`No experience needed. Gi tops are optional. Comfortable clothes you can move in are perfect, and we train barefoot. Come in for a ${offer.noun} first.`],
  },
  tuitionFaqItem(),
];
---

<BaseLayout
  title="Jiu Jitsu Classes in Raeford, NC"
  fullTitle="Jiu Jitsu Classes in Raeford, NC | Action Zone CMA"
  crumb="Jiu Jitsu"
  description={`Jiu jitsu for kids, teens, and adults: takedowns, escapes, holds, and submissions. Serving Raeford, Fayetteville, and Hope Mills. Start with a ${offer.noun}.`}
  path="/jiu-jitsu"
  ogImage={heroImage}
  ogImageAlt="Two students practicing jiu jitsu ground technique on the mat"
  faq={faqItems}
>
  <ProgramHero
    badge="Jiu Jitsu · Kids, Teens & Adults"
    h1="Jiu Jitsu Classes in Raeford, NC"
    image={heroImage}
    alt="Two students practicing jiu jitsu ground technique on the dojo mat"
    ctaLabel={offer.cta}
    ctaHref="/booking"
  >
    <Fragment slot="heading">Control, escapes, <em>and calm under pressure.</em></Fragment>
    <Fragment slot="subtext">
      Takedowns, escapes, holds, and submissions for kids, teens, and adults, taught inside our
      regular classes as part of a complete martial arts system. Family-run and beginner friendly.
    </Fragment>
  </ProgramHero>

  <ProseSection kicker="What You Learn" heading="Jiu jitsu is what happens when a fight is close.">
    <p>
      Karate teaches you to strike and to keep distance. Jiu jitsu teaches you what to do when the
      distance is gone: when someone grabs you, holds you, or takes you to the ground. It is the
      art of grappling, of controlling another person's body with leverage and position instead
      of size and strength.
    </p>
    <p>
      That is why it is such a good fit for real self-defense. A smaller person who understands
      balance, base, and leverage can escape a hold from someone much bigger, without needing to
      throw a single punch.
    </p>
    <p>At Action Zone CMA, students learn:</p>
    <ul>
      <li><span class="absolute left-0 top-3.5 h-0.5 w-2.5 bg-gold" aria-hidden="true"></span>Takedowns</li>
      <li><span class="absolute left-0 top-3.5 h-0.5 w-2.5 bg-gold" aria-hidden="true"></span>Escapes from grabs, holds, and being pinned</li>
      <li><span class="absolute left-0 top-3.5 h-0.5 w-2.5 bg-gold" aria-hidden="true"></span>Holds and control on the ground</li>
      <li><span class="absolute left-0 top-3.5 h-0.5 w-2.5 bg-gold" aria-hidden="true"></span>Submissions</li>
      <li><span class="absolute left-0 top-3.5 h-0.5 w-2.5 bg-gold" aria-hidden="true"></span>Live sparring and grappling with a partner</li>
    </ul>
  </ProseSection>

  <ProseSection warm kicker="How We Teach It" heading="Our own blend, part of Yeshua's Ryu.">
    <p>
      Jiu jitsu is not a separate class here. It is taught inside our regular classes, as part of
      Yeshua's Ryu, the Christian martial arts system our founder created and has refined over
      {founded.decades}. Our jiu jitsu is our own blend. It is not Brazilian or Japanese jiu jitsu
      specifically. It is taught alongside karate, Kung Fu, Tae Kwon Do, and traditional Japanese
      weapons, so students learn to handle a situation standing up and on the ground.
    </p>
    <p>
      Students do live sparring and live grappling, so they know their technique works against a
      partner who is really resisting. Gi tops are optional.
    </p>
  </ProseSection>

  <section class="py-16 md:py-18">
    <div class="mx-auto max-w-6xl px-6 md:px-5">
      <PhotoStrip
        caption="Grappling and partner work on the mat"
        ratioClass="aspect-[4/3]"
        images={[
          { src: partnerSelfDefense, alt: "Adults practicing a partner self-defense escape", position: "50% 30%" },
          { src: studentsOnTheMat, alt: "Martial arts students training together on the dojo mat" },
          { src: instructorCorrectingStance, alt: "Instructor guiding a young student's technique", position: "50% 25%" },
        ]}
      />
    </div>
  </section>

  <ProseSection heading="Jiu jitsu for kids and adults">
    <p>
      Kids and adults both learn jiu jitsu as part of their regular classes. No experience needed.
    </p>
    <p>
      <strong class="font-semibold text-indigo">Kids ({ageLabel(programs.kids)}).</strong> Beginner
      classes: {timesText("kids")}.
    </p>
    <p>
      <strong class="font-semibold text-indigo">Teens and adults ({ageLabel(programs.teensAdults)}).</strong>
      Beginner classes: {timesText("teensAdults")}.
    </p>
    <p>
      Looking for jiu jitsu near you? We are in Raeford, about 25 minutes from Fayetteville, and
      families train with us from Hope Mills, Rockfish, Jack Britt, and Fort Bragg. See the
      <a href="/schedule">full class schedule</a>.
    </p>
  </ProseSection>

  <ReviewQuote id="benjamin-s" />

  <div class="py-12">
    <FAQGroup id="jiu-jitsu-faq" title="Jiu jitsu questions" tag="Before You Start" items={faqItems} />
  </div>

  <CTASection ctaLabel={offer.cta} ctaHref="/booking">
    <Fragment slot="heading">Try jiu jitsu for a week. <em>It's free.</em></Fragment>
    <Fragment slot="subtext">Come in for {offer.visit}. No cost, no commitment, no experience needed.</Fragment>
  </CTASection>
</BaseLayout>
