---
import { contact, reviews, ctaLabelGeneral } from "../../data/school";
---

<header class="relative overflow-hidden bg-indigo text-white">
  <div
    class="pointer-events-none absolute left-[44%] top-[-140px] h-[560px] w-[560px] rounded-full border border-gold/[0.13]"
    aria-hidden="true"
  >
  </div>
  <div class="relative z-10 mx-auto grid max-w-6xl gap-14 px-6 md:px-5 py-20 md:grid-cols-[1.25fr_0.85fr] md:items-start md:gap-12 md:py-20">
    <div>
      <span class="mb-5 inline-flex items-center gap-2.5 text-xs font-semibold tracking-[0.2em] text-gold-soft uppercase">
        <span class="h-px w-[30px] bg-gold" aria-hidden="true"></span>
        Christian Martial Arts &middot; Since {contact.founded}
      </span>
      <h1 class="max-w-[15ch] text-[clamp(2.4rem,4.6vw,4rem)]">
        Discipline that follows them <span class="text-gold-soft">off the mat.</span>
      </h1>
      <p class="mt-6 max-w-[44ch] text-lg text-[#C9C8D8]">
        A family dojo serving <b class="font-semibold text-white">Raeford</b>, <b
          class="font-semibold text-white">Fayetteville</b>, and <b
          class="font-semibold text-white">Hope Mills</b>. Where kids, teens, and adults build
        confidence, focus, and real self-defense. One belt at a time.
      </p>
      <div class="mt-9 flex flex-wrap gap-8">
        <div class="border-l-2 border-gold pl-3.5">
          <b class="block font-display text-[1.75rem] font-black text-white">33</b>
          <span class="text-[0.78rem] text-[#B0AFC2]">Years, one family</span>
        </div>
        <div class="border-l-2 border-gold pl-3.5">
          <b class="block font-display text-[1.75rem] font-black text-white">
            {reviews.rating.toFixed(1)} <span class="text-[0.9rem] tracking-[2px] text-gold">&#9733;</span>
          </b>
          <span class="text-[0.78rem] text-[#B0AFC2]">{reviews.count} Google reviews</span>
        </div>
        <div class="border-l-2 border-gold pl-3.5">
          <b class="block font-display text-[1.75rem] font-black text-white">Ages 3+</b>
          <span class="text-[0.78rem] text-[#B0AFC2]">Preschool to adult</span>
        </div>
      </div>
    </div>

    <div class="rounded border-t-4 border-gold bg-white p-7 shadow-[0_26px_60px_-28px_rgba(0,0,0,0.6)]">
      <h2 class="font-display text-2xl font-black text-indigo">Start with a free week.</h2>
      <div class="mb-4 mt-1 text-xs font-bold tracking-[0.14em] text-gold-deep uppercase">No cost</div>
      <p class="text-sm text-mist">
        Pick a class, choose a day Monday through Thursday, and reserve your spot in under two minutes.
        No uniform, no equipment, no pressure.
      </p>
      <a
        href="/booking"
        class="mt-6 block rounded-sm bg-indigo px-4 py-4 text-center font-bold text-white transition-colors hover:bg-gold hover:text-indigo-deep"
      >
        {ctaLabelGeneral}
      </a>
      <div class="mt-3 text-center text-[0.76rem] text-mist">
        Or call <a href={contact.phoneHref} class="font-bold text-indigo">{contact.phone}</a>
      </div>
    </div>
  </div>
</header>
