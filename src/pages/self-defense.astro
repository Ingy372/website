---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProgramHero from "../components/hero/ProgramHero.astro";
import ProseSection from "../components/sections/ProseSection.astro";
import PhotoStrip from "../components/sections/PhotoStrip.astro";
import FAQGroup from "../components/sections/FAQGroup.astro";
import ReviewQuote from "../components/sections/ReviewQuote.astro";
import CTASection from "../components/sections/CTASection.astro";
import { offer } from "../data/school";
import { founded } from "../data/business";
import { programs, ageLabel, beginnerTimes } from "../data/schedule";

import heroImage from "../images/self-defense/adult-self-defense-partner-drill-raeford-nc.jpg";
import kidsPartnerDrill from "../images/self-defense/kids-self-defense-blocking-drill.jpg";
import instructorCorrectingStance from "../images/self-defense/instructor-guiding-student-strike.jpg";
import trainingFloorWide from "../images/self-defense/self-defense-class-training-floor.jpg";

const classTimes = [
  { label: `Kids (${ageLabel(programs.kids)})`, times: beginnerTimes("kids") },
  { label: `Teens & Adults (${ageLabel(programs.teensAdults)})`, times: beginnerTimes("teensAdults") },
];

const faqItems = [
  {
    question: "Does martial arts help with bullying?",
    answer: [
      "Yes, though often in ways parents do not expect. We never encourage a student to fight, and we never encourage them to become the aggressor. We do teach them to stand up for themselves, including when that is difficult.",
      "As a student grows physically capable and accomplishes things they did not believe they could, their confidence rises with it. A confident child handles confrontation differently and holds a boundary more firmly, often without ever needing to raise a hand.",
    ],
  },
  {
    question: "Will self-defense training make my child aggressive?",
    answer: [
      "In our experience it does the opposite. We spend as much time on what martial arts is not as on what it is, and we talk openly about anger and where these skills belong and where they never do.",
    ],
  },
  {
    question: "Do you offer a one-time self-defense seminar?",
    answer: [
      "Our self-defense is taught in our regular classes, where skills are practiced week after week until they hold up under stress. A one-day seminar is easy to forget. Ask us if you are looking for something for a group.",
    ],
  },
  {
    question: "I have no experience. Can I still join?",
    answer: ["Yes. Most of our adults started with no experience. Every student trains at their own level, and beginners are never thrown in over their heads."],
  },
];
---

<BaseLayout
  title="Self-Defense Classes in Raeford, NC"
  seoTitle="Self-Defense Classes in Raeford, NC | Action Zone CMA"
  description={`Self-defense classes for kids and adults: anti-bullying skills, escapes, confidence. For Raeford, Fayetteville, and Hope Mills. Try a ${offer.noun}.`}
  path="/self-defense"
>
  <ProgramHero
    badge="Self-Defense · Kids, Teens & Adults"
    image={heroImage}
    alt="Students practicing a partner self-defense drill in Raeford, NC"
    ctaLabel={offer.cta}
    ctaHref="/booking"
  >
    <Fragment slot="heading">Confidence first. <em>Skills that hold up.</em></Fragment>
    <Fragment slot="subtext">
      Practical self-defense for kids, teens, and adults, built on karate and jiu jitsu, from a
      family teaching martial arts since {founded.year}. Learn to avoid a fight, and to end one
      safely.
    </Fragment>
  </ProgramHero>

  <ProseSection kicker="Our Approach" heading="Most of self-defense happens before anyone moves.">
    <p>
      Real self-defense starts with how you carry yourself: awareness, a steady voice, and the
      confidence to hold a boundary. People who look like easy targets get targeted. People who
      look like they know what they are doing usually get left alone.
    </p>
    <p>
      So we build both. Students learn physical skills, and they practice them until they are
      automatic. They also learn when those skills belong and when to walk away. We are a
      non-competitive school. We are not raising fighters. We are raising people who can protect
      themselves and the people they love.
    </p>
  </ProseSection>

  <ProseSection warm kicker="For Kids" heading="Anti-bullying skills that build quiet confidence.">
    <p>
      Kids ({ageLabel(programs.kids)}) learn how to stand tall, use their voice, and get out of a
      grab. If someone puts them in a headlock, they learn how to get out of it and take control
      of the situation, or get away to an adult if they can. They learn it in a room where respect
      is trained in every class, so they also learn not to become the bully.
    </p>
    <p>
      Parents tell us the biggest change is not the technique. It is the confidence. A child who
      knows they can handle themselves does not have to prove it. See{" "}
      <a href="/kids">kids karate classes</a> for more.
    </p>
  </ProseSection>

  <section class="py-16 md:py-18">
    <div class="mx-auto max-w-6xl px-6 md:px-5">
      <PhotoStrip
        ratioClass="aspect-[4/3]"
        images={[
          { src: kidsPartnerDrill, alt: "Two kids practicing a blocking drill with a partner" },
          { src: instructorCorrectingStance, alt: "Instructor guiding a young student's strike during self-defense training" },
          { src: trainingFloorWide, alt: "Wide view of a self-defense class on the dojo training floor" },
        ]}
      />
    </div>
  </section>

  <ProseSection kicker="For Teens & Adults" heading="Self-defense you would actually use.">
    <p>
      Teen and adult self-defense draws on the whole Yeshua's Ryu system: karate for striking and
      distance, jiu jitsu for grabs, holds, and the ground, and partner drills that let you
      practice against a real, moving person at a safe level. You also get a full-body workout
      that never feels like a treadmill.
    </p>
    <p>
      No experience is needed. The person beside you might be twenty or fifty, a natural athlete
      or someone who has not exercised in years. See <a href="/teens-adults">teen and adult
      classes</a> and <a href="/jiu-jitsu">jiu jitsu</a>.
    </p>
    <p>
      We are in Raeford, and families come to us from Fayetteville, Hope Mills, Rockfish, Jack
      Britt, and Fort Bragg.
    </p>
  </ProseSection>

  <section class="bg-paper-warm" aria-labelledby="class-times-heading">
    <div class="mx-auto max-w-3xl px-6 py-14 md:px-5">
      <div class="mb-3 text-xs font-bold tracking-[0.2em] text-gold-deep uppercase">Class Times</div>
      <h2 id="class-times-heading" class="mb-6 text-[clamp(1.5rem,2.8vw,2rem)] text-indigo">Beginner self-defense classes</h2>
      <dl class="divide-y divide-paper-warm overflow-hidden rounded-sm border-t-4 border-gold bg-white shadow-sm">
        {classTimes.map((c) => (
          <div class="flex flex-col gap-2 px-5 py-4 sm:flex-row sm:items-start sm:justify-between sm:gap-6">
            <dt class="font-display text-lg font-bold text-indigo">{c.label}</dt>
            <dd>
              <ul class="flex flex-col gap-1 sm:text-right">
                {c.times.map((t) => (
                  <li class="text-ink"><span class="font-semibold">{t.days}</span><span class="text-mist"> · </span>{t.time}</li>
                ))}
              </ul>
            </dd>
          </div>
        ))}
      </dl>
      <p class="mt-4 text-sm text-mist">
        See the <a href="/schedule" class="font-semibold text-indigo underline hover:text-gold">full class schedule</a>.
      </p>
    </div>
  </section>

  <ReviewQuote id="benjamin-s" />

  <div class="py-12">
    <FAQGroup id="self-defense-faq" title="Self-defense questions" tag="Before You Start" items={faqItems} />
  </div>

  <CTASection ctaLabel={offer.cta} ctaHref="/booking">
    <Fragment slot="heading">Build confidence <em>that holds up.</em></Fragment>
    <Fragment slot="subtext">Meet our instructors and see how a class runs. No experience needed, no pressure.</Fragment>
  </CTASection>
</BaseLayout>
