---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProgramHero from "../components/hero/ProgramHero.astro";
import ProseSection from "../components/sections/ProseSection.astro";
import SectionHead from "../components/sections/SectionHead.astro";
import FAQGroup from "../components/sections/FAQGroup.astro";
import CTASection from "../components/sections/CTASection.astro";
import { nextParentsNightOut, eventWhenText } from "../data/events";
import { parentsNightOutFacts, parentsNightOutThemes2027 } from "../data/parties";
import { business } from "../data/business";
import PnoCountdown from "../components/engage/PnoCountdown.astro";

import { Picture } from "astro:assets";
import pnoNerf from "../images/parents-night-out/parents-night-out-nerf-night-raeford-nc.jpg";
import pnoCookies from "../images/parents-night-out/parents-night-out-cookie-decorating.jpg";
import pnoCrafts from "../images/parents-night-out/parents-night-out-painting-crafts.jpg";
import pnoPajamas from "../images/parents-night-out/parents-night-out-pajama-night.jpg";
import pnoFriends from "../images/parents-night-out/parents-night-out-friends-on-bench.jpg";
import pnoNinjaLine from "../images/parents-night-out/parents-night-out-ninja-line-with-instructor.jpg";
import pnoCrew from "../images/parents-night-out/parents-night-out-kids-and-instructors-group.jpg";
import partyPhoto from "../images/parents-night-out/parents-night-out-kids-cheering-with-instructor-raeford-nc.jpg";

// "A look at the night" mosaic. Spans are set per photo so wide shots stay wide
// and tall shots stay tall; captions name what is happening in each frame.
const nightPhotos = [
  { src: pnoCrew, alt: "Kids and instructors smiling together at a Parents Night Out in Raeford, NC", caption: "The whole crew", span: "col-span-2 md:col-start-1 md:row-start-1 md:row-span-2", position: "50% 40%" },
  { src: pnoCookies, alt: "Girl decorating a cookie with sprinkles", caption: "Cookie decorating", span: "row-span-2 md:col-start-3 md:row-start-1", position: "50% 35%" },
  { src: pnoNerf, alt: "Kids with foam blasters and goggles during Nerf Night", caption: "Nerf Night", span: "md:col-start-4 md:row-start-1", position: "50% 40%" },
  { src: pnoPajamas, alt: "Kids in pajamas relaxing on the dojo mat", caption: "Pajama night", span: "md:col-start-4 md:row-start-2", position: "50% 50%" },
  { src: pnoFriends, alt: "Four kids laughing together on a bench", caption: "New friends", span: "col-span-2 md:col-start-1 md:row-start-3 md:row-span-2", position: "50% 45%" },
  { src: pnoNinjaLine, alt: "Instructor spotting a girl climbing the ninja line", caption: "The ninja line", span: "row-span-2 md:col-start-3 md:row-start-3", position: "50% 30%" },
  { src: pnoCrafts, alt: "Boy painting a craft to take home at Parents Night Out", caption: "Crafts to take home", span: "row-span-2 md:col-start-4 md:row-start-3", position: "40% 50%" },
];

// Where parents send a Parents Night Out request.
const reserveHref = "/contact?interest=parents-night-out";
const reserveLabel = "Reserve a Spot";

// "How to reserve" gets real links; every other detail is plain text.
const details = parentsNightOutFacts.filter((f) => f.label !== "How to reserve");

const steps = ["Check-in", "A short martial arts lesson", "The theme activity", "Food", "Movie time and wind-down", "Pickup"];

const faqItems = [
  {
    question: "Does my child need to be a student?",
    answer: ["No. Friends are welcome, and every student gets a free pass to bring one."],
  },
  {
    question: "What should my child wear?",
    answer: ["Something comfortable. A uniform isn't needed."],
  },
  {
    question: "Can my child bring their own snack?",
    answer: ["Of course. We understand some kids are picky eaters."],
  },
  {
    question: "What about food allergies?",
    answer: ["Let us know on the registration form, and send a safe snack along if you'd like."],
  },
  {
    question: "How many kids can come?",
    answer: ["Only 16 spots per night, so reserve early."],
  },
];
---

<BaseLayout
  title="Parents Night Out for Kids in Raeford, NC"
  fullTitle="Parents Night Out for Kids in Raeford, NC | Action Zone CMA"
  crumb="Parents Night Out"
  description="Parents Night Out for kids 5 and up in Raeford, NC. The 4th Friday of every month, 6 to 10pm: a themed night, food, and a movie, run by our instructors."
  path="/parents-night-out"
  ogImage={partyPhoto}
  ogImageAlt="Kids at a themed Parents Night Out at the dojo"
  faq={faqItems}
>
  <ProgramHero
    badge="Parents Night Out · Ages 5+"
    h1="Parents Night Out in Raeford"
    image={partyPhoto}
    alt="Kids cheering and flexing with an instructor on the mat at a Parents Night Out in Raeford, NC"
    ctaLabel={reserveLabel}
    ctaHref={reserveHref}
  >
    <Fragment slot="heading">A night off for you. <em>A night they'll talk about all week.</em></Fragment>
    <Fragment slot="subtext">
      The 4th Friday of every month, 6 to 10pm. A themed night of fun for kids 5 and up,
      supervised by our instructors.
    </Fragment>
    {nextParentsNightOut && (
      <Fragment slot="note">
        Next date: {eventWhenText(nextParentsNightOut)} · {nextParentsNightOut.title}
      </Fragment>
    )}
  </ProgramHero>

  <ProseSection kicker="What It Is" heading="Kids take over the dojo, once a month.">
    <p>
      Once a month, kids take over the dojo for a themed night of fun. It's a chance for kids to
      just be kids and make good memories with their friends, while parents get a well-deserved
      break. Every night is supervised by our instructors.
    </p>
  </ProseSection>

  <section class="bg-paper-warm py-20 md:py-20">
    <div class="mx-auto max-w-6xl px-6 md:px-5">
      <SectionHead kicker="A Look at the Night">
        <Fragment slot="heading">This is what they'll be <em>talking about on the ride home.</em></Fragment>
      </SectionHead>
      <div data-lightbox class="grid grid-flow-dense auto-rows-[170px] grid-cols-2 gap-3 md:auto-rows-[200px] md:grid-cols-4 md:gap-4">
        {nightPhotos.map((p) => (
          <figure class={`group relative overflow-hidden rounded ${p.span}`}>
            <Picture
              src={p.src}
              alt={p.alt}
              formats={["avif", "webp"]}
              widths={[320, 480, 720]}
              sizes="(min-width: 768px) 25vw, 50vw"
              loading="lazy"
              pictureAttributes={{ class: "block h-full w-full" }}
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
              style={`object-position:${p.position}`}
            />
            <figcaption class="absolute bottom-2 left-2 rounded-sm bg-indigo-deep/85 px-2.5 py-1 text-[0.7rem] font-bold tracking-[0.12em] text-gold-soft uppercase">
              {p.caption}
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 md:py-18" aria-labelledby="pno-night">
    <div class="mx-auto max-w-6xl px-6 md:px-5">
      <div class="mb-3 text-center text-xs font-bold tracking-[0.2em] text-gold-deep uppercase">The Night</div>
      <h2 id="pno-night" class="mb-10 text-center text-[clamp(1.7rem,3.2vw,2.4rem)] text-indigo">What a night looks like</h2>
      <ol class="grid gap-4 sm:grid-cols-2 lg:grid-cols-6">
        {steps.map((step, i) => (
          <li class="flex items-center gap-4 rounded border-t-4 border-gold bg-paper-warm p-5 lg:flex-col lg:items-start lg:gap-2">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-indigo font-display text-sm font-bold text-white">{i + 1}</span>
            <span class="font-display text-lg font-bold leading-snug text-indigo">{step}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="py-16 md:py-18" aria-labelledby="pno-details">
    <div class="mx-auto max-w-3xl px-6 md:px-5">
      <PnoCountdown variant="block" class="mb-6" />
      <div class="rounded border-x border-b border-t-4 border-x-paper-warm border-b-paper-warm border-t-gold bg-white p-7 shadow-sm md:p-8">
        <h2 id="pno-details" class="mb-6 font-display text-2xl font-black text-indigo">The details</h2>
        <dl class="grid gap-x-6 gap-y-3 sm:grid-cols-[auto_1fr]">
          {details.map((f) => (
            <>
              <dt class="text-xs font-bold tracking-[0.1em] text-gold-deep uppercase sm:pt-1">{f.label}</dt>
              <dd class="mb-2 text-[#40403A] sm:mb-0">{f.value}</dd>
            </>
          ))}
          <dt class="text-xs font-bold tracking-[0.1em] text-gold-deep uppercase sm:pt-1">How to reserve</dt>
          <dd class="text-[#40403A]">
            Send a request through <a href={reserveHref} class="font-semibold text-indigo underline hover:text-gold">our website</a>
            {" "}or call <a href={business.phoneHref} class="font-semibold text-indigo underline hover:text-gold">{business.phone}</a>.
          </dd>
        </dl>
      </div>
    </div>
  </section>

  <section class="bg-paper-warm py-16 md:py-18">
    <div class="mx-auto max-w-6xl px-6 md:px-5">
      <SectionHead kicker="One Theme a Month" center>
        <Fragment slot="heading">2027 themes</Fragment>
      </SectionHead>
      <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
        {parentsNightOutThemes2027.map((t) => (
          <li class="rounded bg-white p-4">
            <div class="text-xs font-bold tracking-[0.14em] text-gold-deep uppercase">{t.month}</div>
            <div class="mt-1 font-display text-lg font-bold leading-snug text-indigo">{t.theme}</div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="py-16 md:py-18" aria-labelledby="pno-friend">
    <div class="mx-auto max-w-3xl px-6 md:px-5">
      <div class="rounded bg-indigo p-8 text-white md:p-10">
        <div class="mb-3 text-xs font-bold tracking-[0.2em] text-gold-soft uppercase">Bring a Friend</div>
        <h2 id="pno-friend" class="mb-4 text-[clamp(1.6rem,3vw,2.2rem)]">Their first night is <span class="text-gold-soft">on us.</span></h2>
        <p class="text-lg leading-relaxed text-[#D6D5E2]">
          Every student who signs up for Parents Night Out gets a pass to bring a friend who doesn't
          train with us. Their first Parents Night Out is free.
        </p>
        <p class="mt-3 text-sm text-[#B7B6C8]">
          One free visit per friend. Brothers and sisters of current students don't count as friends.
        </p>
      </div>
    </div>
  </section>

  <div class="py-12">
    <FAQGroup id="pno-faq" title="Parents Night Out questions" tag="Before You Book" items={faqItems} />
  </div>

  <CTASection ctaLabel={reserveLabel} ctaHref={reserveHref}>
    <Fragment slot="heading">Only 16 spots a night. <em>Reserve early.</em></Fragment>
    <Fragment slot="subtext">The 4th Friday of every month, 6 pm – 10 pm, for kids 5 and up.</Fragment>
  </CTASection>
</BaseLayout>
